# Ghost CMS Configuration
GHOST_API_URL=https://blog.thetaharpia.com
GHOST_CONTENT_API_KEY=your-ghost-content-api-key-here

# How to get your Ghost Content API Key:
# 1. Go to your Ghost Admin panel (https://blog.thetaharpia.com/ghost/)
# 2. Navigate to Settings > Integrations
# 3. Click "Add custom integration"
# 4. Give it a name (e.g., "Cuidaty Landing")
# 5. Copy the "Content API Key"
# 6. Paste it as the value for GHOST_CONTENT_API_KEY above

# Search engine verification (optional)
# Google Search Console -> Settings -> Ownership verification -> HTML tag -> copy only the content="" value
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> verification meta -> copy only the content="" value
PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 (optional). When set, analytics loads only AFTER the user
# accepts the cookie banner (Google Consent Mode v2, denied by default).
PUBLIC_GA_ID=
