---
import { formatDate, DEFAULT_COVER } from '../lib/blog.server';
import type { BlogPost } from '../lib/blog.server';

interface Props {
  post: BlogPost;
  headingLevel?: 'h2' | 'h3';
  /** Primeiro post da primeira página: card largo, com a capa ao lado do texto. */
  featured?: boolean;
}

const { post, headingLevel = 'h2', featured = false } = Astro.props;
const Heading = headingLevel;
const coverImage = post.cover_image_url || DEFAULT_COVER;
const href = `/blog/${post.slug}/`;
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl transition-[transform,box-shadow] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:shadow-soft',
    featured
      ? 'bg-cuidaty-accent-light md:grid md:grid-cols-[1.05fr_1fr] md:items-center md:gap-0'
      : 'border border-cuidaty-dark/[0.07] bg-white',
  ]}
>
  <div
    class:list={[
      'overflow-hidden bg-beige',
      // A capa é desenhada em 16:9 e tem texto dentro: qualquer recorte come palavra.
      'aspect-[16/9]',
      featured && 'md:m-7 md:mr-0 md:rounded-xl',
    ]}
  >
    <img
      src={coverImage}
      alt=""
      loading="lazy"
      referrerpolicy="no-referrer"
      class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
    />
  </div>

  <div class:list={['flex flex-1 flex-col', featured ? 'p-7 md:p-10' : 'p-6']}>
    {
      post.tags && post.tags.length > 0 && (
        <p class="mb-4 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-dark/45">
          {post.tags
            .slice(0, 2)
            .map((tag) => tag.name)
            .join(' · ')}
        </p>
      )
    }

    <Heading
      class:list={[
        'font-serif font-semibold leading-[1.2] text-cuidaty-dark',
        featured ? 'text-2xl md:text-[2rem]' : 'line-clamp-3 text-xl',
      ]}
    >
      <!-- O link cobre o card inteiro: uma única área clicável, sem CTA repetido. -->
      <a
        href={href}
        class="focus-ring rounded-sm before:absolute before:inset-0 before:content-['']"
        >{post.title}</a
      >
    </Heading>

    {
      post.excerpt && (
        <p
          class:list={[
            'mt-3 leading-relaxed text-cuidaty-dark/65',
            featured ? 'line-clamp-3 text-[0.95rem] md:text-base' : 'line-clamp-2 text-sm',
          ]}
        >
          {post.excerpt}
        </p>
      )
    }

    <div
      class="mt-6 flex items-center gap-3 pt-5 text-xs text-cuidaty-dark/50 md:mt-auto"
      style="border-top: 1px solid rgb(12 32 47 / 0.08)"
    >
      <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
      {post.author?.name && <span aria-hidden="true">·</span>}
      {post.author?.name && <span>{post.author.name}</span>}
      <span
        class="ml-auto inline-flex items-center gap-1.5 font-semibold text-cuidaty-dark transition-transform duration-300 ease-out group-hover:translate-x-0.5"
      >
        Ler
        <svg
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10h11.5M11 5.5 15.5 10 11 14.5"></path>
        </svg>
      </span>
    </div>
  </div>
</article>
