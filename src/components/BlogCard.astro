---
import { DEFAULT_COVER, formatDate } from '../lib/blog.server';
import type { BlogPost } from '../lib/blog.server';

interface Props {
  post: BlogPost;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const coverImage = post.cover_image_url || DEFAULT_COVER;
---

<article class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-gray-100 transition-all hover:-translate-y-1 hover:shadow-xl">
  <a href={`/blog/${post.slug}`} class="block overflow-hidden" aria-label={post.title}>
    <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
      <img
        src={coverImage}
        alt={post.title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
  </a>

  <div class="flex flex-1 flex-col p-6">
    {post.tags && post.tags.length > 0 && (
      <div class="mb-3 flex flex-wrap gap-2">
        {post.tags.slice(0, 2).map((tag) => (
          <span class="rounded-full bg-cuidaty-primary/10 px-3 py-0.5 text-xs font-medium text-cuidaty-primary">
            {tag.name}
          </span>
        ))}
      </div>
    )}

    <Heading class="mb-3 font-serif text-xl font-semibold leading-snug text-cuidaty-dark line-clamp-2">
      <a href={`/blog/${post.slug}`} class="transition-colors hover:text-cuidaty-primary">
        {post.title}
      </a>
    </Heading>

    {post.excerpt && (
      <p class="mb-4 text-sm text-gray-600 leading-relaxed line-clamp-3">{post.excerpt}</p>
    )}

    <div class="mt-auto flex items-center justify-between text-sm text-gray-500">
      <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
      {post.author?.name && (
        <span class="text-xs text-gray-400">{post.author.name}</span>
      )}
    </div>

    <a
      href={`/blog/${post.slug}`}
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-cuidaty-primary transition-colors hover:text-cuidaty-primary-hover"
    >
      Ler artigo
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </a>
  </div>
</article>
