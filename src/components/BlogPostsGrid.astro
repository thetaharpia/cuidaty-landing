---
import BlogCard from './BlogCard.astro';
import BlogPagination from './BlogPagination.astro';
import type { BlogPost, BlogMeta } from '../lib/blog.server';

interface Props {
  posts: BlogPost[];
  meta: BlogMeta | null;
}

const { posts, meta } = Astro.props;

// Só a primeira página ganha destaque: nas seguintes todos os cards têm o
// mesmo peso, senão o artigo de número sete parece mais importante que o de
// número um.
const isFirstPage = !meta || meta.current_page === 1;
const [featured, ...rest] = posts;
const gridPosts = isFirstPage ? rest : posts;
---

<section class="container mx-auto px-4 pb-20 pt-14 md:px-6">
  <div class="mx-auto max-w-6xl">
    {
      posts.length > 0 ? (
        <>
          {isFirstPage && featured && (
            <div class="mb-14">
              <p class="mb-5 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-dark/45">
                Último artigo
              </p>
              <BlogCard post={featured} headingLevel="h2" featured />
            </div>
          )}

          <div class="mb-8 flex items-baseline justify-between gap-4">
            <h2 class="font-serif text-xl font-semibold text-cuidaty-dark">
              {isFirstPage ? 'Todos os artigos' : `Página ${meta?.current_page}`}
            </h2>
            {meta && (
              <p class="text-sm text-cuidaty-dark/45">
                {meta.total} {meta.total === 1 ? 'artigo' : 'artigos'}
              </p>
            )}
          </div>

          <div class="stagger-cards grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {gridPosts.map((post) => (
              <BlogCard post={post} headingLevel="h3" />
            ))}
          </div>
        </>
      ) : (
        <div class="rounded-2xl bg-cuidaty-accent-light px-6 py-20 text-center">
          <p class="font-serif text-xl text-cuidaty-dark">Nenhum artigo publicado ainda.</p>
          <p class="mt-2 text-sm text-cuidaty-dark/60">Volte em breve, tem conteúdo a caminho.</p>
        </div>
      )
    }

    {meta && <BlogPagination currentPage={meta.current_page} lastPage={meta.last_page} />}
  </div>
</section>
