<style>
  .fl-layer {
    --dx: -7rem;
    --size: 1.5rem;
    --alpha: 0.55;
    position: fixed;
    inset: 0;
    z-index: 30;
    overflow: hidden;
    pointer-events: none;
  }
  .fl {
    position: absolute;
    top: -3rem;
    left: var(--x);
    width: calc(var(--size) * var(--s));
    fill: #c9f5a8;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fl {
      animation:
        fl-fall var(--w) linear var(--d) infinite,
        fl-flutter 2.8s ease-in-out var(--d) infinite alternate;
    }
  }
  /* Celular: folhas maiores e mais visíveis, desvio curto para não sair da tela. */
  @media (max-width: 640px) {
    .fl-layer {
      --dx: -2.5rem;
      --size: 2rem;
      --alpha: 0.7;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fl-layer {
      display: none;
    }
  }
  @keyframes fl-fall {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(0deg);
    }
    8%,
    88% {
      opacity: var(--alpha);
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), calc(100vh + 6rem)) rotate(560deg);
    }
  }
  @keyframes fl-flutter {
    from {
      translate: -1.4rem 0;
    }
    to {
      translate: 1.4rem 0;
    }
  }
</style>
