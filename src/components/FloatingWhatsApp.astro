---
const phone = '5596984058103';
const displayPhone = '(96) 98405-8103';
const defaultMessage = 'Olá! Vim pelo site do Cuidaty e gostaria de conhecer a plataforma.';
const waLink = `https://wa.me/${phone}?text=${encodeURIComponent(defaultMessage)}`;
---

<div id="wa-float" class="fixed bottom-6 right-6 z-[60] hidden flex-col items-end gap-3 lg:flex">
  <!-- Popup / Chat preview -->
  <div
    id="wa-popup"
    class="hidden w-[92vw] max-w-xs origin-bottom-right scale-95 opacity-0 rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 transition-all duration-200 sm:max-w-sm"
  >
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 rounded-t-2xl bg-[#075E54] px-4 py-3 text-white">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/20">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>
        </div>
        <div class="leading-tight">
          <div class="text-sm font-semibold">Pedro — Cuidaty</div>
          <div class="text-xs text-white/70">
            Resposta média em 4h
          </div>
        </div>
      </div>
      <button
        id="wa-close"
        type="button"
        aria-label="Fechar"
        class="rounded-full p-1 text-white/80 transition hover:bg-white/10 hover:text-white"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="px-4 py-4 bg-[#E5DDD5]/40 rounded-b-2xl">
      <div class="mb-3 max-w-[85%] rounded-2xl rounded-tl-sm bg-white px-3 py-2 shadow-sm">
        <p class="text-xs text-gray-500">Pedro</p>
        <p class="text-sm text-gray-800 leading-snug">
          Olá! 👋 Posso te ajudar a conhecer o Cuidaty ou tirar qualquer dúvida. Me chame aqui.
        </p>
      </div>

      <div class="mb-3 text-center text-xs text-gray-500">
        {displayPhone}
      </div>

      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 rounded-xl bg-[#25D366] px-4 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-[#1fb855]"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        Iniciar conversa
      </a>

      <a
        href="https://calendly.com/pedro-thetaharpia/30min"
        target="_blank"
        rel="noopener"
        class="mt-2 flex items-center justify-center gap-2 rounded-xl border border-cuidaty-primary/30 px-4 py-2.5 text-sm font-semibold text-cuidaty-primary transition hover:bg-cuidaty-primary/5"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Agendar demonstração
      </a>
    </div>
  </div>

  <!-- Toggle Button -->
  <button
    id="wa-toggle"
    type="button"
    aria-label="Abrir WhatsApp"
    aria-expanded="false"
    class="group relative flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lifted transition-all hover:bg-[#1fb855] md:h-14 md:w-14"
  >

    <svg id="wa-icon-chat" class="h-7 w-7 md:h-8 md:w-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>

    <svg id="wa-icon-close" class="hidden h-7 w-7 md:h-8 md:w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
</div>

<script>
  const toggleBtn = document.getElementById('wa-toggle');
  const closeBtn = document.getElementById('wa-close');
  const popup = document.getElementById('wa-popup');
  const iconChat = document.getElementById('wa-icon-chat');
  const iconClose = document.getElementById('wa-icon-close');

  let open = false;

  function setOpen(next: boolean) {
    open = next;
    if (!popup || !toggleBtn) return;
    toggleBtn.setAttribute('aria-expanded', String(next));
    if (next) {
      popup.classList.remove('hidden');
      requestAnimationFrame(() => {
        popup.classList.remove('scale-95', 'opacity-0');
        popup.classList.add('scale-100', 'opacity-100');
      });
      iconChat?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      popup.classList.add('scale-95', 'opacity-0');
      popup.classList.remove('scale-100', 'opacity-100');
      iconChat?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      window.setTimeout(() => {
        if (!open) popup.classList.add('hidden');
      }, 180);
    }
  }

  toggleBtn?.addEventListener('click', () => setOpen(!open));
  closeBtn?.addEventListener('click', () => setOpen(false));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
  });
</script>
