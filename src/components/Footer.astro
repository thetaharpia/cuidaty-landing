---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-accent">
  <div class="container mx-auto px-4 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <img
          src="/logo.svg"
          alt="Cuidaty"
          class="mb-4 h-10 w-auto"
          width="120"
          height="40"
          loading="lazy"
          decoding="async"
        />
        <p class="text-sm text-foreground/70">
          Tecnologia que cuida da sua rotina profissional.
        </p>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-foreground">Produto</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#funcionalidades" class="text-foreground/70 transition-colors hover:text-foreground">
              Funcionalidades
            </a>
          </li>
          <li>
            <a href="#planos" class="text-foreground/70 transition-colors hover:text-foreground">
              Planos e Preços
            </a>
          </li>
          <li>
            <a href="#seguranca" class="text-foreground/70 transition-colors hover:text-foreground">
              Segurança
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-foreground">Suporte</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="mailto:contato@thetaharpia.com"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Contato
            </a>
          </li>
          <li>
            <a
              href="https://app.cuidaty.com"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Acessar Plataforma
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-foreground">Sobre</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#sobre" class="text-foreground/70 transition-colors hover:text-foreground">
              Quem Somos
            </a>
          </li>
          <li>
            <a href="#resultados" class="text-foreground/70 transition-colors hover:text-foreground">
              Resultados
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-border pt-8 text-center text-sm text-foreground/60">
      <p>&copy; {currentYear} Cuidaty. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
