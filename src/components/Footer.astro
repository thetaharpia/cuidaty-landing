---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-white">
  <div class="container mx-auto px-4 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <img src="/logo-written.svg" alt="Cuidaty" class="mb-4 h-10 w-auto" loading="lazy" />
        <p class="text-sm text-foreground/70">
          Software para psicologos, consultorios e clinicas de saude.
        </p>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-foreground">Produto</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/#funcionalidades"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Agenda, WhatsApp e prontuário
            </a>
          </li>
          <li>
            <a href="/#planos" class="text-foreground/70 transition-colors hover:text-foreground">
              Planos para consultórios e clínicas
            </a>
          </li>
          <li>
            <a
              href="/#seguranca"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Segurança, LGPD e conformidade
            </a>
          </li>
          <li>
            <a href="/#faq" class="text-foreground/70 transition-colors hover:text-foreground">
              FAQ sobre software para saúde
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-foreground">Suporte</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="mailto:contato@thetaharpia.com"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              contato@thetaharpia.com
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/559691003520"
              target="_blank"
              rel="noopener"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
WhatsApp: Enviar mensagem
            </a>
          </li>
          <li>
            <a
              href="/#contato"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Falar com a gente
            </a>
          </li>
          <li>
            <a
              href="https://ajuda.cuidaty.com"
              target="_blank"
              rel="noopener"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Central de Ajuda
            </a>
          </li>
          <li>
            <a
              href="https://app.cuidaty.com/login"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Acessar Plataforma
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-foreground">Sobre</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/#sobre" class="text-foreground/70 transition-colors hover:text-foreground">
              Quem Somos
            </a>
          </li>
          <li>
            <a href="/time" class="text-foreground/70 transition-colors hover:text-foreground">
              Nosso Time
            </a>
          </li>
          <li>
            <a href="/blog/" class="text-foreground/70 transition-colors hover:text-foreground">
              Blog
            </a>
          </li>
          <li>
            <a
              href="https://startuppsi.com.br/"
              target="_blank"
              rel="noopener"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Parceira: StartupPsi
            </a>
          </li>
          <li>
            <a
              href="/#resultados"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Resultados
            </a>
          </li>
          <li>
            <a
              href="/politica-privacidade"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Política de Privacidade
            </a>
          </li>
          <li>
            <a
              href="/termos-uso"
              class="text-foreground/70 transition-colors hover:text-foreground"
            >
              Termos de Uso
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-border pt-8 flex flex-col items-center gap-4 text-sm text-foreground/60">
      <div class="flex items-center gap-4">
        <a
          href="https://www.instagram.com/cuidaty_com/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cuidaty no Instagram"
          class="text-foreground/60 transition-colors hover:text-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/company/cuidaty"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cuidaty no LinkedIn"
          class="text-foreground/60 transition-colors hover:text-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect width="4" height="12" x="2" y="9"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a
          href="https://www.youtube.com/channel/UCU2CVCFOvYGE1XqTGKsX4wQ"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cuidaty no YouTube"
          class="text-foreground/60 transition-colors hover:text-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/>
            <path d="m10 15 5-3-5-3z"/>
          </svg>
        </a>
        <a
          href="/blog/"
          aria-label="Blog da Cuidaty"
          class="text-foreground/60 transition-colors hover:text-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
        </a>
      </div>
      <p>&copy; {currentYear} Cuidaty. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
