---

<header class="fixed inset-x-0 top-3 z-50 px-4 sm:top-4 md:px-6" id="main-header">
  <div class="mx-auto max-w-7xl">
    <!-- Barra flutuante arredondada, fundo sólido (sem efeito de vidro) -->
    <nav
      class="flex items-center justify-between gap-4 rounded-2xl border border-border bg-white px-5 py-2.5 shadow-lifted md:px-7 md:py-3"
      id="nav-bar"
    >
      <a href="/" class="flex items-center gap-2" aria-label="Cuidaty">
        <img src="/logo-written.svg" alt="Cuidaty" class="h-8 w-auto sm:h-9" loading="eager" />
      </a>

      <div class="hidden items-center gap-6 md:flex">
        <a
          href="/#hero"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Início
        </a>
        <a
          href="/#funcionalidades"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Funcionalidades
        </a>
        <a
          href="/#planos"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Preços
        </a>
        <a
          href="/#sobre"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Sobre
        </a>
        <a
          href="/#contato"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Contato
        </a>
        <a
          href="https://cuidaty.com/blog"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          Blog
        </a>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://app.cuidaty.com/login"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="login_click"
          data-ga-location="header_desktop"
          class="hidden items-center rounded-md border border-cuidaty-primary bg-transparent px-5 py-2 text-sm font-semibold text-cuidaty-primary transition-colors hover:bg-cuidaty-primary/10 sm:inline-flex"
        >
          Entrar
        </a>
        <a
          href="https://app.cuidaty.com/register"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="generate_lead"
          data-ga-location="header_desktop"
          class="hidden items-center gap-1.5 rounded-md bg-cuidaty-primary px-5 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-cuidaty-primary-hover sm:inline-flex"
        >
          Começar grátis
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          class="flex min-h-[40px] min-w-[40px] items-center justify-center rounded-full border border-cuidaty-dark/10 bg-white text-cuidaty-dark transition-colors hover:bg-beige md:hidden"
          aria-label="Abrir menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="mt-2 hidden rounded-2xl border border-border bg-white p-3 shadow-lifted md:hidden"
    >
      <div class="flex flex-col">
        <a
          href="/#hero"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Início
        </a>
        <a
          href="/#funcionalidades"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Funcionalidades
        </a>
        <a
          href="/#planos"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Preços
        </a>
        <a
          href="/#sobre"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Sobre
        </a>
        <a
          href="/#contato"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Contato
        </a>
        <a
          href="https://cuidaty.com/blog"
          class="flex items-center gap-2 rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          Blog
        </a>
        <a
          href="https://app.cuidaty.com/login"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="login_click"
          data-ga-location="header_mobile"
          class="mt-1 flex items-center justify-center rounded-xl border border-cuidaty-primary bg-transparent px-3 py-3 text-base font-semibold text-cuidaty-primary transition-colors hover:bg-cuidaty-primary/10"
          style="min-height: 44px;"
        >
          Entrar
        </a>
        <a
          href="https://app.cuidaty.com/register"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="generate_lead"
          data-ga-location="header_mobile"
          class="flex items-center justify-center gap-2 rounded-xl bg-cuidaty-primary px-3 py-3 text-base font-semibold text-white transition-all hover:bg-cuidaty-primary-hover"
          style="min-height: 44px;"
        >
          Começar grátis
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Link da seção atual (scroll-spy) */
  .nav-active {
    color: #0c202f;
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const desktopMedia = window.matchMedia('(min-width: 768px)');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    const menuOpen = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
    mobileMenuButton.setAttribute('aria-expanded', String(menuOpen));
    document.body.style.overflow = menuOpen ? 'hidden' : '';
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  desktopMedia.addEventListener('change', () => {
    if (desktopMedia.matches) {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  });

  // Scroll-spy: sublinha o link da seção visível na viewport
  const spyLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#nav-bar a[href^="/#"]')
  );
  const linkById = new Map<string, HTMLAnchorElement>();
  spyLinks.forEach((link) => {
    const id = link.getAttribute('href')?.split('#')[1];
    if (id) {
      linkById.set(id, link);
    }
  });
  const spySections = Array.from(linkById.keys())
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (spySections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }
          spyLinks.forEach((link) => link.classList.remove('nav-active'));
          linkById.get(entry.target.id)?.classList.add('nav-active');
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    spySections.forEach((section) => spy.observe(section));
  }
</script>
