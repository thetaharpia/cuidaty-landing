---
const isBlog = Astro.url.pathname.startsWith('/blog');
---

<header class="fixed inset-x-0 top-3 z-50 px-4 sm:top-4 md:px-6" id="main-header">
  <div class="mx-auto max-w-7xl">
    <!-- Barra flutuante arredondada, fundo sólido (sem efeito de vidro) -->
    <nav
      class="flex items-center justify-between gap-4 rounded-2xl border border-border bg-white px-5 py-2.5 shadow-lifted md:px-7 md:py-3"
      id="nav-bar"
    >
      <a href="/" class="flex items-center gap-2" aria-label="Cuidaty">
        <img
          src="/logo-written.svg"
          alt="Cuidaty"
          width="314"
          height="82"
          class="h-8 w-auto sm:h-9"
          loading="eager"
        />
      </a>

      <div class="hidden items-center gap-6 md:flex">
        <a
          href="/#hero"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Início
        </a>
        <a
          href="/#sobre"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Sobre
        </a>
        <a
          href="/#funcionalidades"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Funcionalidades
        </a>
        <a
          href="/#planos"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Preços
        </a>
        <a
          href="/#clinicas"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Para clínicas
        </a>
        <a
          href="/#contato"
          class="text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline"
        >
          Contato
        </a>
        <!-- Ajuda: dúvidas da home ou a Central de Ajuda. <details> nativo, fecha ao clicar fora (script abaixo). -->
        <details class="help-menu relative hidden lg:block" data-help-menu>
          <summary
            class="flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-cuidaty-dark/70 transition-colors hover:text-cuidaty-dark"
          >
            Ajuda
            <svg
              class="help-caret h-3.5 w-3.5 transition-transform"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M6 9l6 6 6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </summary>
          <div
            class="absolute left-1/2 top-full z-10 mt-3 w-64 -translate-x-1/2 rounded-md border border-border bg-white p-1.5 shadow-lifted"
          >
            <a href="/#faq" class="block rounded px-3 py-2.5 hover:bg-cuidaty-dark/5">
              <span class="block text-sm font-semibold text-cuidaty-dark">Dúvidas frequentes</span>
              <span class="block text-xs text-cuidaty-dark/70"
                >Plano grátis, WhatsApp, IA e LGPD</span
              >
            </a>
            <a
              href="https://ajuda.cuidaty.com"
              rel="noopener"
              title="Central de Ajuda da Cuidaty: tutoriais de agenda, prontuário e WhatsApp"
              class="block rounded px-3 py-2.5 hover:bg-cuidaty-dark/5"
            >
              <span class="block text-sm font-semibold text-cuidaty-dark">Central de Ajuda</span>
              <span class="block text-xs text-cuidaty-dark/70"
                >Tutoriais passo a passo da plataforma</span
              >
            </a>
          </div>
        </details>
        <a
          href="https://cuidaty.com/blog"
          aria-current={isBlog ? 'page' : undefined}
          class:list={[
            'inline-flex items-center gap-1.5 text-sm font-medium text-cuidaty-dark/70 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:underline',
            isBlog && 'nav-active',
          ]}
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
            ></path>
          </svg>
          Blog
        </a>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://app.cuidaty.com/login"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="login_click"
          data-ga-location="header_desktop"
          class="hidden items-center rounded-md border border-cuidaty-primary bg-transparent px-5 py-2 text-sm font-semibold text-cuidaty-primary-ink transition-colors hover:bg-cuidaty-primary/10 sm:inline-flex"
        >
          Entrar
        </a>
        <a
          href="https://app.cuidaty.com/register"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="generate_lead"
          data-ga-location="header_desktop"
          class="hidden items-center gap-1.5 rounded-md bg-cuidaty-primary-ink px-5 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-cuidaty-primary-ink-hover sm:inline-flex"
        >
          Começar grátis
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          class="flex min-h-[40px] min-w-[40px] items-center justify-center rounded-full border border-cuidaty-dark/10 bg-white text-cuidaty-dark transition-colors hover:bg-beige md:hidden"
          aria-label="Abrir menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="mt-2 hidden rounded-2xl border border-border bg-white p-3 shadow-lifted md:hidden"
    >
      <div class="flex flex-col">
        <a
          href="/#hero"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Início
        </a>
        <a
          href="/#sobre"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Sobre
        </a>
        <a
          href="/#funcionalidades"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Funcionalidades
        </a>
        <a
          href="/#planos"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Preços
        </a>
        <a
          href="/#clinicas"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Para clínicas
        </a>
        <a
          href="/#contato"
          class="flex items-center rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          Contato
        </a>
        <a
          href="/#faq"
          class="flex items-center gap-2 rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 10h8M8 14h5M5 5h14v11H9l-4 3z"></path>
          </svg>
          Dúvidas frequentes
        </a>
        <a
          href="https://ajuda.cuidaty.com"
          rel="noopener"
          class="flex items-center gap-2 rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark"
          style="min-height: 44px;"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          Central de Ajuda
        </a>
        <a
          href="https://cuidaty.com/blog"
          aria-current={isBlog ? 'page' : undefined}
          class:list={[
            'flex items-center gap-2 rounded-xl px-3 py-3 text-base font-medium text-cuidaty-dark/80 transition-colors hover:bg-beige hover:text-cuidaty-dark',
            isBlog && 'nav-active-mobile',
          ]}
          style="min-height: 44px;"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
            ></path>
          </svg>
          Blog
        </a>
        <a
          href="https://app.cuidaty.com/login"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="login_click"
          data-ga-location="header_mobile"
          class="mt-1 flex items-center justify-center rounded-xl border border-cuidaty-primary bg-transparent px-3 py-3 text-base font-semibold text-cuidaty-primary-ink transition-colors hover:bg-cuidaty-primary/10"
          style="min-height: 44px;"
        >
          Entrar
        </a>
        <a
          href="https://app.cuidaty.com/register"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="generate_lead"
          data-ga-location="header_mobile"
          class="flex items-center justify-center gap-2 rounded-xl bg-cuidaty-primary-ink px-3 py-3 text-base font-semibold text-white transition-all hover:bg-cuidaty-primary-ink-hover"
          style="min-height: 44px;"
        >
          Começar grátis
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Link da seção atual (scroll-spy) */
  .nav-active {
    color: #0c202f;
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }

  /* Item atual no menu mobile */
  .nav-active-mobile {
    color: #0c202f;
    font-weight: 600;
    background-color: #f4f1ea;
  }
  .help-menu summary::-webkit-details-marker {
    display: none;
  }
  .help-menu[open] .help-caret {
    transform: rotate(180deg);
  }
</style>

<script>
  // Menu "Ajuda": fecha ao clicar fora, ao escolher um item ou com Esc.
  document.querySelectorAll<HTMLDetailsElement>('[data-help-menu]').forEach((menu) => {
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    });
    menu
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });

  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const desktopMedia = window.matchMedia('(min-width: 768px)');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    const menuOpen = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
    mobileMenuButton.setAttribute('aria-expanded', String(menuOpen));
    document.body.style.overflow = menuOpen ? 'hidden' : '';
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  desktopMedia.addEventListener('change', () => {
    if (desktopMedia.matches) {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  });

  // Scroll-spy: sublinha o link da seção visível na viewport
  const spyLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#nav-bar a[href^="/#"]')
  );
  const linkById = new Map<string, HTMLAnchorElement>();
  spyLinks.forEach((link) => {
    const id = link.getAttribute('href')?.split('#')[1];
    if (id) {
      linkById.set(id, link);
    }
  });
  const spySections = Array.from(linkById.keys())
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (spySections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }
          spyLinks.forEach((link) => link.classList.remove('nav-active'));
          linkById.get(entry.target.id)?.classList.add('nav-active');
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    spySections.forEach((section) => spy.observe(section));
  }
</script>
