---
import { Image } from 'astro:assets';

import logoWritten from '../assets/logo-written.svg';
---

<header
  class="bg-background/92 fixed left-0 right-0 top-0 z-50 border-b border-border shadow-soft backdrop-blur-md transition-[background-color,border-color,box-shadow,backdrop-filter] duration-300 md:border-transparent md:bg-transparent md:shadow-none md:backdrop-blur-0"
  id="main-header"
>
  <nav class="container mx-auto flex items-center justify-between px-5 py-3 md:px-8 md:py-4">
    <a href="/" class="flex items-center gap-2" aria-label="Cuidaty">
      <Image
        src={logoWritten}
        alt="Cuidaty"
        class="h-8 w-auto sm:h-9"
        loading="eager"
        quality={100}
      />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <a
        href="/#funcionalidades"
        class="text-sm font-medium text-cuidaty-dark/70 transition-colors hover:text-cuidaty-dark"
      >
        Funcionalidades
      </a>
      <a
        href="/#resultados"
        class="text-sm font-medium text-cuidaty-dark/70 transition-colors hover:text-cuidaty-dark"
      >
        Resultados
      </a>
      <a
        href="/#sobre"
        class="text-sm font-medium text-cuidaty-dark/70 transition-colors hover:text-cuidaty-dark"
      >
        Sobre
      </a>
      <a
        href="/#blog"
        class="text-sm font-medium text-cuidaty-dark/70 transition-colors hover:text-cuidaty-dark"
      >
        Blog
      </a>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://app.cuidaty.com/login"
        class="hidden text-sm font-medium text-cuidaty-dark/70 transition-colors hover:text-cuidaty-dark sm:inline-flex"
      >
        Entrar
      </a>
      <a
        href="https://calendly.com/pedro-thetaharpia/30min"
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-md bg-cuidaty-primary px-4 py-2 text-sm font-semibold text-white transition-all hover:bg-cuidaty-primary-hover md:inline-flex"
      >
        Agendar demonstração
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md border border-cuidaty-dark/10 bg-white/90 text-cuidaty-dark shadow-soft transition-colors hover:bg-white md:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="bg-background/98 hidden border-t border-border shadow-soft backdrop-blur-md md:hidden"
  >
    <div class="container mx-auto flex flex-col px-5 py-3">
      <a
        href="/#funcionalidades"
        class="flex items-center py-3.5 text-base font-medium text-cuidaty-dark/80 transition-colors hover:text-cuidaty-dark"
        style="min-height: 44px;"
      >
        Funcionalidades
      </a>
      <a
        href="/#resultados"
        class="flex items-center py-3.5 text-base font-medium text-cuidaty-dark/80 transition-colors hover:text-cuidaty-dark"
        style="min-height: 44px;"
      >
        Resultados
      </a>
      <a
        href="/#sobre"
        class="flex items-center py-3.5 text-base font-medium text-cuidaty-dark/80 transition-colors hover:text-cuidaty-dark"
        style="min-height: 44px;"
      >
        Sobre
      </a>
      <a
        href="/#blog"
        class="flex items-center py-3.5 text-base font-medium text-cuidaty-dark/80 transition-colors hover:text-cuidaty-dark"
        style="min-height: 44px;"
      >
        Blog
      </a>
      <a
        href="https://app.cuidaty.com/login"
        class="flex items-center py-3.5 text-base font-medium text-cuidaty-dark/80 transition-colors hover:text-cuidaty-dark"
        style="min-height: 44px;"
      >
        Entrar
      </a>
      <a
        href="https://calendly.com/pedro-thetaharpia/30min"
        target="_blank"
        rel="noopener"
        class="mt-3 flex items-center justify-center gap-2 rounded-md bg-cuidaty-primary text-base font-semibold text-white transition-colors active:bg-cuidaty-primary-hover"
        style="min-height: 48px;"
      >
        Agendar demonstração
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.getElementById('main-header');
  const desktopMedia = window.matchMedia('(min-width: 768px)');

  const syncHeader = () => {
    const isDesktop = desktopMedia.matches;
    const menuOpen = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
    const shouldElevateDesktop = isDesktop && window.scrollY > 16;

    if (shouldElevateDesktop) {
      header?.classList.add(
        'bg-background/95',
        'backdrop-saturate-150',
        'border-border',
        'shadow-soft'
      );
      header?.classList.remove('bg-transparent', 'border-transparent', 'shadow-none');
      return;
    }

    if (isDesktop) {
      header?.classList.add('bg-transparent', 'border-transparent', 'shadow-none');
      header?.classList.remove(
        'bg-background/95',
        'backdrop-saturate-150',
        'border-border',
        'shadow-soft'
      );
      return;
    }

    header?.classList.add('border-border', 'bg-background/92', 'shadow-soft', 'backdrop-blur-md');
    header?.classList.remove('bg-transparent', 'border-transparent', 'shadow-none');

    if (menuOpen) {
      header?.classList.add('bg-background');
    } else {
      header?.classList.remove('bg-background');
    }
  };

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    const menuOpen = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
    mobileMenuButton.setAttribute('aria-expanded', String(menuOpen));
    document.body.style.overflow = menuOpen ? 'hidden' : '';
    syncHeader();
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      syncHeader();
    });
  });

  window.addEventListener('scroll', syncHeader, { passive: true });
  desktopMedia.addEventListener('change', () => {
    if (desktopMedia.matches) {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    syncHeader();
  });
  syncHeader();
</script>
