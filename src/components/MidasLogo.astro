---
// Marca do MIDAS, a mesma de midas.cuidaty.com (porta, rio e ramo) com o
// wordmark ao lado. Copiada do repositório do MIDAS: mudou lá, muda aqui.
interface Props {
  /** Altura do ícone em px. */
  size?: number;
  showWordmark?: boolean;
  /** Prefixo do clipPath: precisa ser único quando a marca aparece mais de uma vez na página. */
  id?: string;
  class?: string;
}

const { size = 40, showWordmark = true, id = 'midas-logo', class: className } = Astro.props;

const ARCH = 'M8 118 V52 A42 42 0 0 1 92 52 V118 Z';
const LEAF = 'M0 0 C6 -9 19 -10 27 -3 C19 7 7 8 0 0Z';
const WAVE_1 =
  'M-40 100 C-24 88 -12 88 0 98 S24 108 38 96 S62 84 76 96 S100 108 114 96 S134 86 146 96 V130 H-40Z';
const WAVE_2 =
  'M-40 112 C-26 104 -10 104 4 111 S30 118 44 110 S66 102 82 110 S106 118 120 110 S138 104 146 110 V130 H-40Z';
---

<span
  class:list={['inline-flex items-center', className]}
  style={`gap:${size * 0.26}px`}
  role="img"
  aria-label="MIDAS"
>
  <svg
    viewBox="0 -12 100 132"
    width={Math.round((size * 100) / 132)}
    height={size}
    class="shrink-0 overflow-visible"
    aria-hidden="true"
  >
    <defs>
      <clipPath id={`${id}-arch`}><path d={ARCH}></path></clipPath>
    </defs>
    <path d={ARCH} fill="#2D6389"></path>
    <g clip-path={`url(#${id}-arch)`}>
      <path d={WAVE_1} fill="#E9A93A"></path>
      <path d={WAVE_2} fill="#F6D98A"></path>
    </g>
    <path
      d="M40 98 C34 80 62 74 54 54 C50 43 56 32 66 24"
      fill="none"
      stroke="#F7F3EA"
      stroke-width="6.5"
      stroke-linecap="round"></path>
    <path d={LEAF} transform="translate(46.5 79) rotate(200) scale(1.15)" fill="#5EC4AE"></path>
    <path d={LEAF} transform="translate(55 62) rotate(-20) scale(1.25)" fill="#A7E9A5"></path>
    <path d={LEAF} transform="translate(65 25) rotate(-58) scale(1.45)" fill="#E9A93A"></path>
    {
      size >= 32 && (
        <path
          d="M26 38 l2.4 5.6 5.6 2.4 -5.6 2.4 -2.4 5.6 -2.4 -5.6 -5.6 -2.4 5.6 -2.4z"
          fill="#F6D98A"
        />
      )
    }
  </svg>
  {
    showWordmark && (
      <span
        class="inline-flex items-baseline font-serif font-extrabold leading-none text-[#17344d]"
        style={`font-size:${size * 0.62}px`}
        aria-hidden="true"
      >
        MID
        <span class="inline-flex items-baseline text-[#2D6389]">
          <svg class="midas-a" viewBox="0 0 100 100">
            <path d="M0 100 36 0H64L100 100H69L50 40 31 100Z" fill="currentColor" />
          </svg>
          S
        </span>
      </span>
    )
  }
</span>

<style>
  /* O "A" sem a barra do meio, na altura das maiúsculas. O wordmark é flex para
     o espaço em branco do template não abrir vão entre as letras. */
  .midas-a {
    height: 0.66em;
    width: 0.7em;
    margin-inline: 0.01em 0.02em;
    vertical-align: baseline;
  }
</style>
