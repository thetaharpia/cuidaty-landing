---
const calendlyUrl = 'https://calendly.com/pedro-thetaharpia/30min';
const waUrl =
  'https://wa.me/5596984058103?text=Ol%C3%A1%21%20Tenho%20interesse%20em%20conhecer%20o%20Cuidaty.';
---

<div
  id="mobile-cta-bar"
  class="fixed bottom-0 left-0 right-0 z-[55] border-t border-cuidaty-dark/8 bg-background/95 shadow-[0_-2px_16px_rgba(12,32,47,0.07)] backdrop-blur-sm transition-transform duration-300 ease-in-out lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom); transform: translateY(100%);"
>
  <div class="flex items-center gap-2 px-3 py-2.5">
    <a
      href={calendlyUrl}
      target="_blank"
      rel="noopener"
      class="flex flex-1 items-center justify-center gap-2 rounded-lg bg-cuidaty-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors active:bg-cuidaty-primary-hover"
    >
      <svg class="h-3.5 w-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
        ></path>
      </svg>
      Agendar demonstração
    </a>
    <a
      href={waUrl}
      target="_blank"
      rel="noopener"
      aria-label="Falar no WhatsApp"
      class="flex items-center justify-center rounded-lg bg-[#25D366] text-white transition-colors active:bg-[#1fb855]"
      style="min-width: 44px; min-height: 44px;"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"
        ></path>
      </svg>
    </a>
  </div>
  <p class="pb-1.5 text-center text-[10px] text-foreground/45">
    Sem compromisso · Atendimento humano · Resposta em 4h
  </p>
</div>

<script>
  const bar = document.getElementById('mobile-cta-bar');
  if (bar) {
    let lastScrollY = window.scrollY;
    let heroHeight = 0;
    let visible = false;
    let ticking = false;

    const computeHeroHeight = () => {
      const hero = document.getElementById('hero');
      heroHeight = hero ? hero.offsetHeight * 0.6 : 400;
    };

    const setVisible = (show: boolean) => {
      if (visible === show) return;
      visible = show;
      bar.style.transform = show ? 'translateY(0)' : 'translateY(100%)';
    };

    computeHeroHeight();
    window.addEventListener('resize', computeHeroHeight, { passive: true });

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const currentY = window.scrollY;
        const delta = currentY - lastScrollY;
        const pastHero = currentY > heroHeight;
        const nearBottom =
          window.innerHeight + currentY >= document.body.scrollHeight - 120;

        if (!pastHero) {
          setVisible(false);
        } else if (nearBottom) {
          // always show near page bottom (conversion moment)
          setVisible(true);
        } else if (delta > 10) {
          // scrolling down → reading, get out of the way
          setVisible(false);
        } else if (delta < -10) {
          // scrolling up → user looking for controls
          setVisible(true);
        }

        lastScrollY = currentY;
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
