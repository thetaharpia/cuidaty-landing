---
import AppFrame from '../mockups/AppFrame.astro';

/**
 * Demo animado do portal de agendamento do paciente, dentro da moldura de
 * janela (AppFrame), igual aos demais mockups.
 * Portado de cuidaty/public/portal-agendamento-demo.html.
 * CSS namespaced em .pad e script multi-instância (.pad).
 */
interface Props {
  maxWidth?: number;
  class?: string;
}
const { maxWidth = 480, class: className = '' } = Astro.props;
---

<AppFrame title="Cuidaty · Portal de agendamento" maxWidth={maxWidth} class={className}>
  <div class="pad">
    <div class="surface">
    <div class="pt-nav">
      <div class="pt-brand">
        <span class="logo">E</span>
        <span class="nm">Espaço Viver · Psicologia</span>
      </div>
      <div class="nav-right" data-nav-right></div>
    </div>

    <div class="screen">
      <!-- HERO -->
      <section class="scene" data-scene="hero">
        <div class="hero">
          <span class="hlogo">E</span>
          <p class="demo-h1">Espaço Viver</p>
          <p class="tag">Psicologia e saúde mental · atendimento presencial e online</p>
          <span class="cta" data-hero-cta>
            Agendar consulta agora
            <svg class="ic s14" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
          <span class="trust">
            <svg class="ic s12" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            Sem login · sem app · disponível 24h
          </span>
        </div>
      </section>

      <!-- DATA -->
      <section class="scene" data-scene="date">
        <div class="pt-progress">
          <span class="st reached"><span class="n">1</span>Profissional</span>
          <span class="bar"></span>
          <span class="st reached"><span class="n">2</span>Data</span>
          <span class="bar"></span>
          <span class="st dim"><span class="n">3</span>Horário</span>
          <span class="bar"></span>
          <span class="st dim"><span class="n">4</span>Dados</span>
        </div>

        <div class="pro-row">
          <span class="av">A</span>
          <span class="meta">
            <span class="nm">Dra. Ana Martins</span>
            <span class="role">Psicóloga · CRP 06/12345</span>
          </span>
          <span class="when" data-pro-when>
            <svg class="ic s12" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
            18 jun
          </span>
        </div>

        <h2 class="pt-h2">Escolha uma data</h2>
        <div class="pt-cal">
          <div class="pt-cal-head">
            <span class="pt-cal-nav"><svg class="ic s14" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"></path></svg></span>
            <span class="mo">junho de 2026</span>
            <span class="pt-cal-nav"><svg class="ic s14" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg></span>
          </div>
          <div class="pt-dow"><span>dom</span><span>seg</span><span>ter</span><span>qua</span><span>qui</span><span>sex</span><span>sáb</span></div>
          <div class="pt-week">
            <span class="pt-day muted">1</span><span class="pt-day muted">2</span><span class="pt-day avail">3</span><span class="pt-day avail">4</span><span class="pt-day avail">5</span><span class="pt-day muted">6</span><span class="pt-day muted">7</span>
          </div>
          <div class="pt-week">
            <span class="pt-day muted">8</span><span class="pt-day avail">9</span><span class="pt-day avail">10</span><span class="pt-day avail">11</span><span class="pt-day avail">12</span><span class="pt-day muted">13</span><span class="pt-day muted">14</span>
          </div>
          <div class="pt-week">
            <span class="pt-day muted">15</span><span class="pt-day avail">16</span><span class="pt-day avail">17</span><span class="pt-day avail" data-day18>18</span><span class="pt-day avail">19</span><span class="pt-day muted">20</span><span class="pt-day muted">21</span>
          </div>
          <div class="pt-week">
            <span class="pt-day muted">22</span><span class="pt-day avail">23</span><span class="pt-day avail">24</span><span class="pt-day avail">25</span><span class="pt-day avail">26</span><span class="pt-day muted">27</span><span class="pt-day muted">28</span>
          </div>
        </div>
      </section>

      <!-- HORÁRIO -->
      <section class="scene" data-scene="time">
        <div class="pt-progress">
          <span class="st reached"><span class="n">1</span>Profissional</span>
          <span class="bar"></span>
          <span class="st reached"><span class="n">2</span>Data</span>
          <span class="bar"></span>
          <span class="st reached"><span class="n">3</span>Horário</span>
          <span class="bar"></span>
          <span class="st dim"><span class="n">4</span>Dados</span>
        </div>

        <span class="slot-date">
          <svg class="ic s12" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          quinta, 18 de junho
        </span>

        <h2 class="pt-h2">Horários disponíveis</h2>
        <div class="pt-slots">
          <span class="pt-slot">08:00</span>
          <span class="pt-slot">08:50</span>
          <span class="pt-slot dim">09:40</span>
          <span class="pt-slot">10:30</span>
          <span class="pt-slot">11:20</span>
          <span class="pt-slot dim">13:10</span>
          <span class="pt-slot" data-slot14>14:00</span>
          <span class="pt-slot">14:50</span>
          <span class="pt-slot">15:40</span>
        </div>

        <span class="pt-btn" data-continue>
          Continuar com 14:00
          <svg class="ic s14" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </span>
      </section>

      <!-- CONFIRMAÇÃO -->
      <section class="scene" data-scene="done">
        <div class="done">
          <span class="check" data-done-check>
            <svg class="ic" style="width:28px;height:28px" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></svg>
          </span>
          <h2>Solicitação enviada!</h2>
          <p>Recebemos seu pedido. Você recebe a confirmação no WhatsApp em breve.</p>
          <dl class="summary" data-done-summary>
            <div class="srow"><dt>Profissional</dt><dd>Dra. Ana Martins</dd></div>
            <div class="srow"><dt>Data</dt><dd>quinta, 18 de junho</dd></div>
            <div class="srow"><dt>Horário</dt><dd style="text-transform:none">14:00</dd></div>
            <div class="srow proto"><dt>Protocolo</dt><dd>#000482</dd></div>
          </dl>
        </div>
      </section>
    </div>

  </div>
  </div>
</AppFrame>

<style is:global>
  .pad {
    --pt-bg: #f6f7f8;
    --pt-card: #ffffff;
    --pt-heading: #0c202f;
    --pt-muted: #64748b;
    --pt-border: #e3e7eb;
    --pt-primary: #356588;
    --pt-primary-fg: #ffffff;
    --pt-primary-light: rgba(53, 101, 136, 0.1);
    --pt-secondary: #5ac3b0;
    --shadow-xs: 0 1px 2px rgba(12, 32, 47, 0.05);
    --shadow-sm: 0 1px 3px rgba(12, 32, 47, 0.08), 0 1px 2px rgba(12, 32, 47, 0.04);
    color: var(--pt-heading);
    width: 100%;
  }
  .pad * { box-sizing: border-box; margin: 0; padding: 0; }

  .pad .caption { text-align: center; min-height: 42px; display: flex; flex-direction: column; gap: 2px; align-items: center; justify-content: center; }
  .pad .caption .kicker { font-size: 10.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pt-muted); }
  .pad .caption .headline { font-size: 15.5px; font-weight: 600; color: var(--pt-heading); transition: opacity 0.35s ease, transform 0.35s ease; }
  .pad .caption .headline.swap { opacity: 0; transform: translateY(5px); }

  .pad .surface { background: var(--pt-bg); overflow: hidden; display: flex; flex-direction: column; height: 496px; }

  .pad svg.ic { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pad svg.ic.s14 { width: 14px; height: 14px; }
  .pad svg.ic.s12 { width: 12px; height: 12px; }

  .pad .pt-nav { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 9px 13px; background: var(--pt-card); border-bottom: 1px solid var(--pt-border); flex: 0 0 auto; }
  .pad .pt-brand { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .pad .pt-brand .logo { width: 26px; height: 26px; flex: 0 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; background: var(--pt-primary); color: var(--pt-primary-fg); }
  .pad .pt-brand .nm { font-size: 13px; font-weight: 600; color: var(--pt-heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pad .nav-right { font-size: 11.5px; font-weight: 500; flex: 0 0 auto; }
  .pad .nav-pill { display: inline-flex; align-items: center; gap: 5px; background: var(--pt-primary); color: var(--pt-primary-fg); border-radius: 8px; padding: 6px 11px; }
  .pad .nav-back { display: inline-flex; align-items: center; gap: 5px; color: var(--pt-muted); border: 1px solid var(--pt-border); border-radius: 8px; padding: 5px 9px; }

  .pad .screen { position: relative; flex: 1 1 auto; overflow: hidden; }
  .pad .scene { position: absolute; inset: 0; padding: 15px 14px; display: flex; flex-direction: column; opacity: 0; transform: translateY(8px); transition: opacity 0.4s ease, transform 0.4s ease; pointer-events: none; overflow-y: auto; }
  .pad .scene.active { opacity: 1; transform: none; }

  .pad .pt-progress { display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 15px; font-size: 10px; font-weight: 500; color: var(--pt-muted); flex: 0 0 auto; }
  .pad .pt-progress .st { display: flex; align-items: center; gap: 4px; transition: opacity 0.35s ease, color 0.35s ease; }
  .pad .pt-progress .st.dim { opacity: 0.4; }
  .pad .pt-progress .st .n { width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9.5px; font-weight: 600; background: var(--pt-border); color: var(--pt-muted); transition: background 0.35s ease, color 0.35s ease; }
  .pad .pt-progress .st.reached .n { background: var(--pt-primary); color: var(--pt-primary-fg); }
  .pad .pt-progress .st.reached { color: var(--pt-heading); }
  .pad .pt-progress .bar { height: 1px; width: 14px; background: var(--pt-border); }

  .pad .hero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 6px; padding: 8px 6px; }
  .pad .hero .hlogo { width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; background: var(--pt-primary); color: var(--pt-primary-fg); margin-bottom: 6px; box-shadow: var(--shadow-sm); }
  .pad .hero .demo-h1 { font-size: 21px; font-weight: 700; letter-spacing: -0.01em; }
  .pad .hero .tag { font-size: 12.5px; color: var(--pt-muted); max-width: 240px; line-height: 1.45; }
  .pad .hero .cta { margin-top: 12px; display: inline-flex; align-items: center; gap: 7px; background: var(--pt-primary); color: var(--pt-primary-fg); font-size: 13px; font-weight: 600; border-radius: 11px; padding: 12px 20px; box-shadow: var(--shadow-xs); transition: transform 0.15s ease, filter 0.15s ease; }
  .pad .hero .cta.pressed { transform: scale(0.96); filter: brightness(0.95); }
  .pad .hero .trust { margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--pt-muted); }
  .pad .hero .trust svg { color: var(--pt-secondary); }

  .pad .pro-row { display: flex; align-items: center; gap: 11px; background: var(--pt-card); border: 1px solid var(--pt-border); border-radius: 13px; padding: 11px 13px; margin-bottom: 14px; flex: 0 0 auto; }
  .pad .pro-row .av { width: 40px; height: 40px; flex: 0 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 600; background: var(--pt-primary-light); color: var(--pt-primary); }
  .pad .pro-row .meta { min-width: 0; flex: 1; display: flex; flex-direction: column; }
  .pad .pro-row .nm { font-size: 13.5px; font-weight: 600; color: var(--pt-heading); line-height: 1.25; }
  .pad .pro-row .role { font-size: 11px; color: var(--pt-muted); }
  .pad .pro-row .when { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 500; color: var(--pt-primary); background: var(--pt-primary-light); border-radius: 999px; padding: 3px 9px; flex: 0 0 auto; text-transform: capitalize; opacity: 0; transform: scale(0.9); transition: opacity 0.3s ease, transform 0.3s ease; }
  .pad .pro-row .when.show { opacity: 1; transform: none; }

  .pad .pt-h2 { font-size: 14.5px; font-weight: 600; color: var(--pt-heading); letter-spacing: -0.01em; margin-bottom: 10px; flex: 0 0 auto; }

  .pad .pt-cal { background: var(--pt-card); border: 1px solid var(--pt-border); border-radius: 13px; padding: 12px; flex: 0 0 auto; }
  .pad .pt-cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 9px; }
  .pad .pt-cal-head .mo { font-size: 12px; font-weight: 600; color: var(--pt-heading); text-transform: capitalize; }
  .pad .pt-cal-nav { width: 26px; height: 26px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--pt-muted); }
  .pad .pt-dow { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; margin-bottom: 1px; }
  .pad .pt-dow span { padding: 3px 0; font-size: 9px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--pt-muted); }
  .pad .pt-week { display: grid; grid-template-columns: repeat(7, 1fr); }
  .pad .pt-day { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 500; border-radius: 9px; transition: transform 0.2s ease; }
  .pad .pt-day.muted { color: var(--pt-muted); opacity: 0.35; }
  .pad .pt-day.avail { color: var(--pt-heading); background: var(--pt-primary-light); }
  .pad .pt-day.selected { background: var(--pt-primary); color: var(--pt-primary-fg); font-weight: 600; box-shadow: var(--shadow-xs); transform: scale(1.08); }

  .pad .slot-date { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 500; color: var(--pt-primary); background: var(--pt-primary-light); border-radius: 999px; padding: 4px 11px; margin-bottom: 12px; text-transform: capitalize; flex: 0 0 auto; align-self: flex-start; }
  .pad .pt-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; flex: 0 0 auto; }
  .pad .pt-slot { padding: 9px 0; text-align: center; font-size: 12px; font-weight: 500; border-radius: 10px; border: 1px solid var(--pt-border); background: var(--pt-card); color: var(--pt-heading); transition: transform 0.2s ease; }
  .pad .pt-slot.dim { color: var(--pt-muted); opacity: 0.45; text-decoration: line-through; }
  .pad .pt-slot.selected { background: var(--pt-primary); color: var(--pt-primary-fg); border-color: var(--pt-primary); font-weight: 600; transform: scale(1.04); }

  .pad .pt-btn { display: flex; align-items: center; justify-content: center; gap: 7px; width: 100%; padding: 12px; border-radius: 11px; font-size: 13px; font-weight: 600; margin-top: 14px; flex: 0 0 auto; background: var(--pt-primary); color: var(--pt-primary-fg); box-shadow: var(--shadow-xs); opacity: 0; transform: translateY(6px); transition: opacity 0.35s ease, transform 0.35s ease, filter 0.15s ease; }
  .pad .pt-btn.show { opacity: 1; transform: none; }
  .pad .pt-btn.pressed { filter: brightness(0.95); transform: scale(0.98); }

  .pad .done { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 3px; padding: 6px; }
  .pad .done .check { width: 58px; height: 58px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--pt-primary-light); color: var(--pt-primary); margin-bottom: 8px; opacity: 0; transform: scale(0.6); transition: opacity 0.4s ease, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .pad .done .check.show { opacity: 1; transform: none; }
  .pad .done h2 { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
  .pad .done p { font-size: 12px; color: var(--pt-muted); max-width: 240px; line-height: 1.45; }
  .pad .done .summary { margin-top: 14px; width: 100%; background: var(--pt-card); border: 1px solid var(--pt-border); border-radius: 12px; padding: 13px 14px; display: flex; flex-direction: column; gap: 9px; text-align: left; opacity: 0; transform: translateY(8px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .pad .done .summary.show { opacity: 1; transform: none; }
  .pad .done .srow { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; font-size: 12px; }
  .pad .done .srow dt { color: var(--pt-muted); }
  .pad .done .srow dd { font-weight: 600; color: var(--pt-heading); text-transform: capitalize; }
  .pad .done .srow.proto { border-top: 1px solid var(--pt-border); padding-top: 9px; margin-top: 1px; }
  .pad .done .srow.proto dd { font-family: ui-monospace, Menlo, monospace; font-weight: 500; text-transform: none; }

  .pad .pt-foot { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 11px; border-top: 1px solid var(--pt-border); background: var(--pt-card); font-size: 10.5px; color: var(--pt-muted); flex: 0 0 auto; }
  .pad .pt-foot img { height: 13px; width: auto; opacity: 0.75; }

  .pad .timeline { display: flex; gap: 8px; padding: 0 2px; }
  .pad .tl { flex: 1; display: flex; flex-direction: column; gap: 5px; }
  .pad .tl .bar { height: 3px; border-radius: 4px; background: var(--pt-border); overflow: hidden; position: relative; }
  .pad .tl .bar i { position: absolute; inset: 0; width: 0; background: var(--pt-primary); transition: width 0.25s linear; }
  .pad .tl.teal .bar i { background: var(--pt-secondary); }
  .pad .tl .lab { display: flex; align-items: center; gap: 5px; font-size: 10px; color: var(--pt-muted); transition: color 0.3s; }
  .pad .tl.on .lab { color: var(--pt-heading); }
  .pad .tl .lab span { width: 5px; height: 5px; border-radius: 50%; background: var(--pt-border); }
  .pad .tl.on .lab span { background: var(--pt-primary); }
  .pad .tl.teal.on .lab span { background: var(--pt-secondary); }

  .pad .foot { text-align: center; font-size: 10.5px; color: #64748b; }

  @media (prefers-reduced-motion: reduce) {
    .pad .scene { transition: none; }
    .pad .caption .headline,
    .pad .pt-btn,
    .pad .pro-row .when,
    .pad .done .check,
    .pad .done .summary { transition: none; }
  }
</style>

<script>
  function initPortalDemo(root: HTMLElement) {
    const q = (s: string) => root.querySelector<HTMLElement>(s);
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const headline = q('[data-headline]');
    async function setHeadline(t: string) {
      if (!headline) return;
      headline.classList.add('swap');
      await sleep(330);
      headline.textContent = t;
      headline.classList.remove('swap');
    }

    function runProgress(barEl: HTMLElement | null, durationMs: number) {
      return new Promise<void>((resolve) => {
        if (!barEl) return resolve();
        const start = performance.now();
        const t = window.setInterval(() => {
          const p = Math.min(1, (performance.now() - start) / durationMs);
          barEl.style.width = p * 100 + '%';
          if (p >= 1) {
            window.clearInterval(t);
            resolve();
          }
        }, 30);
      });
    }

    const scenes: Record<string, HTMLElement | null> = {
      hero: q('[data-scene="hero"]'),
      date: q('[data-scene="date"]'),
      time: q('[data-scene="time"]'),
      done: q('[data-scene="done"]'),
    };
    async function show(name: string) {
      Object.values(scenes).forEach((s) => s?.classList.remove('active'));
      await sleep(110);
      const s = scenes[name];
      if (s) {
        s.classList.add('active');
        s.scrollTop = 0;
      }
      await sleep(380);
    }
    async function press(el: HTMLElement | null) {
      if (!el) return;
      el.classList.add('pressed');
      await sleep(160);
      el.classList.remove('pressed');
    }

    const navRight = q('[data-nav-right]');
    const setNav = (html: string) => {
      if (navRight) navRight.innerHTML = html;
    };
    const navPill = '<span class="nav-pill">Agendar</span>';
    const navBack =
      '<span class="nav-back"><svg class="ic s12" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Voltar ao site</span>';

    const day18 = q('[data-day18]');
    const proWhen = q('[data-pro-when]');
    const slot14 = q('[data-slot14]');
    const continueBtn = q('[data-continue]');
    const doneCheck = q('[data-done-check]');
    const doneSummary = q('[data-done-summary]');
    const heroCta = q('[data-hero-cta]');
    const bar = (k: string) => q(`[data-bar="${k}"]`);
    const tl = (k: string) => q(`[data-tl="${k}"]`);

    function reset() {
      day18?.classList.remove('selected');
      proWhen?.classList.remove('show');
      slot14?.classList.remove('selected');
      continueBtn?.classList.remove('show');
      doneCheck?.classList.remove('show');
      doneSummary?.classList.remove('show');
      ['date', 'time', 'done'].forEach((k) => {
        const b = bar(k);
        if (b) b.style.width = '0%';
        tl(k)?.classList.remove('on');
      });
      setNav(navPill);
    }

    async function run() {
      reset();

      await setHeadline('Link próprio de agendamento, aberto 24h');
      await show('hero');
      await sleep(1500);
      await press(heroCta);
      await sleep(250);

      setNav(navBack);
      tl('date')?.classList.add('on');
      await setHeadline('O paciente escolhe o melhor dia');
      await show('date');
      runProgress(bar('date'), 2600);
      await sleep(900);
      day18?.classList.add('selected');
      await sleep(260);
      proWhen?.classList.add('show');
      await sleep(1600);

      tl('date')?.classList.remove('on');
      tl('time')?.classList.add('on');
      await setHeadline('E o horário livre na agenda');
      await show('time');
      runProgress(bar('time'), 2600);
      await sleep(950);
      slot14?.classList.add('selected');
      await sleep(360);
      continueBtn?.classList.add('show');
      await sleep(1300);
      await press(continueBtn);
      await sleep(300);

      tl('time')?.classList.remove('on');
      tl('done')?.classList.add('on');
      await setHeadline('Pedido enviado, sem ligar para a clínica');
      setNav('');
      await show('done');
      runProgress(bar('done'), 3200);
      doneCheck?.classList.add('show');
      await sleep(450);
      doneSummary?.classList.add('show');
      await sleep(3000);
    }

    (async () => {
      while (true) {
        await run();
        await sleep(300);
      }
    })();
  }

  function bootPortalDemos() {
    document.querySelectorAll<HTMLElement>('.pad').forEach((root) => {
      if (root.dataset.booted) return;
      root.dataset.booted = '1';
      initPortalDemo(root);
    });
  }

  if (document.readyState !== 'loading') {
    bootPortalDemos();
  } else {
    document.addEventListener('DOMContentLoaded', bootPortalDemos);
  }
</script>
