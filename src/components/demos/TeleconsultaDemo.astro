---
/**
 * Demo animada da transcrição de teleconsulta com IA — componente isolado.
 * Portado de cuidaty/public/cuty-demo-teleconsulta.html (animações preservadas).
 * CSS escopado sob .tel e script multi-instância (.tel).
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['tel', className]}>
  <div class="stage">
    <div class="caption">
      <div class="kicker">Inteligência clínica</div>
      <div class="headline" data-headline>Teleconsulta? O Cuty transcreve os dois lados</div>
    </div>

    <div class="surface">
      <div class="appbar">
        <span class="wdots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="wtitle">Cuidaty · Transcrição</span>
      </div>
      <div class="screen">
        <section class="scene">
          <div class="sect-head">
            <span class="lead"
              ><svg class="ic" viewBox="0 0 24 24"
                ><rect x="9" y="2" width="6" height="12" rx="3"></rect><path
                  d="M19 10v2a7 7 0 0 1-14 0v-2"></path><path d="M12 19v3"></path></svg
              ></span
            >
            <div>
              Transcrever consulta<small
                >gravação ao vivo · áudio descartado após o processamento</small
              >
            </div>
          </div>

          <!-- Painel do gravador (idle / gravando) -->
          <div class="panel" data-recorder>
            <div class="rec-controls">
              <span class="btn primary" data-rec-btn>
                <svg class="ic s14" data-rec-icon viewBox="0 0 24 24"
                  ><rect x="9" y="2" width="6" height="12" rx="3"></rect><path
                    d="M19 10v2a7 7 0 0 1-14 0v-2"></path><path d="M12 19v3"></path></svg
                >
                <span data-rec-label>Gravar consulta</span>
              </span>
              <span class="btn outline" data-upload-btn>
                <svg class="ic s14" viewBox="0 0 24 24"
                  ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path
                    d="M17 8l-5-5-5 5"></path><path d="M12 3v12"></path></svg
                >
                Enviar arquivo
              </span>
              <span class="rec-live" data-rec-live style="display:none">
                <span class="rec-dot"></span>
                <span class="rec-time" data-rec-time>00:00</span>
                <span class="rec-hint">transmitindo ao vivo</span>
              </span>
            </div>
            <div class="toggle" data-toggle-row>
              <span class="switch" data-switch></span>
              <span class="lbl">Incluir áudio de teleconsultas</span>
            </div>
          </div>

          <!-- Card da transcrição (processando / concluída) -->
          <div class="panel hide" data-card-panel>
            <div class="tcard">
              <div class="tcard-head">
                <div class="left">
                  <span class="time">Hoje · 14:32</span>
                  <span class="badge mode">
                    <svg class="ic s12" viewBox="0 0 24 24"
                      ><path d="m22 8-6 4 6 4V8Z"></path><rect
                        x="2"
                        y="6"
                        width="14"
                        height="12"
                        rx="2"></rect></svg
                    >
                    Teleconsulta
                  </span>
                </div>
                <span class="badge secondary" data-status-badge>
                  <span class="spin" style="width:12px;height:12px"></span>
                  Processando
                </span>
              </div>

              <div class="pending-msg" data-pending-msg>
                <span class="spin"></span>
                <span
                  >A transcrição pode levar alguns minutos. Você pode sair desta tela, ela
                  continuará processando.</span
                >
              </div>

              <div data-result-body style="display:none;flex-direction:column;gap:14px">
                <div class="soap-grid">
                  <div class="field" data-i="0">
                    <div class="lbl">Queixa principal</div>
                    <div class="val">Ansiedade com insônia de manutenção há ~2 semanas.</div>
                  </div>
                  <div class="field" data-i="1">
                    <div class="lbl">Subjetivo (S)</div>
                    <div class="val">
                      Pensamento acelerado à noite, despertares frequentes, cansaço diurno.
                    </div>
                  </div>
                  <div class="field" data-i="2">
                    <div class="lbl">Objetivo (O)</div>
                    <div class="val">
                      Paciente colaborativo, discurso organizado, humor ansioso.
                    </div>
                  </div>
                  <div class="field" data-i="3">
                    <div class="lbl">Avaliação (A)</div>
                    <div class="val">Quadro ansioso com impacto no sono, sem sinais de risco.</div>
                  </div>
                  <div class="field full" data-i="4">
                    <div class="lbl">Plano (P)</div>
                    <div class="val">
                      Higiene do sono, técnicas de respiração, retorno em 15 dias.
                    </div>
                  </div>
                </div>

                <div class="card-actions" data-card-actions>
                  <span class="btn primary sm">
                    <svg class="ic s14" viewBox="0 0 24 24"
                      ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"
                      ></path><path d="M14 2v6h6"></path><path d="M12 18v-6"></path><path
                        d="M9 15h6"></path></svg
                    >
                    Usar no novo registro
                  </span>
                </div>

                <div class="details" data-details>
                  <div class="summary">
                    <svg class="ic s14" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
                    Transcrição completa (4 trechos)
                  </div>
                  <div class="body" data-seg-body>
                    <p
                      class="seg"
                      data-label="Profissional"
                      data-text="Boa tarde! Como você tem se sentido desde a última sessão?"
                    >
                    </p>
                    <p
                      class="seg"
                      data-label="Paciente"
                      data-text="Mais ansioso, doutora. À noite minha cabeça não desliga."
                    >
                    </p>
                    <p
                      class="seg"
                      data-label="Profissional"
                      data-text="Entendo. Isso tem atrapalhado o seu sono?"
                    >
                    </p>
                    <p
                      class="seg"
                      data-label="Paciente"
                      data-text="Bastante. Acordo várias vezes e amanheço cansado."
                    >
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="foot">Demonstração ilustrativa · Cuidaty IA</div>
  </div>
</div>

<style is:global>
  .tel {
    --bg: #f8fafc;
    --fg: #0c202f;
    --card: #fff;
    --primary: #356588;
    --secondary: #5ac3b0;
    --muted: #e2e8f0;
    --mf: #64748b;
    --destructive: #ef4444;
    --border: #e2e8f0;
    --r-sm: 0.25rem;
    --r-md: 0.5rem;
    --r-xl: 1rem;
    --sh-xs: 0 1px 2px rgba(12, 32, 47, 0.05);
    --sh-sm: 0 1px 3px rgba(12, 32, 47, 0.08), 0 1px 2px rgba(12, 32, 47, 0.04);
    color: var(--fg);
    display: flex;
    justify-content: center;
  }
  .tel * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  .tel .stage {
    width: 100%;
    max-width: 540px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tel .caption {
    text-align: center;
    min-height: 48px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: center;
    justify-content: center;
  }
  .tel .caption .kicker {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mf);
  }
  .tel .caption .headline {
    font-size: 17px;
    font-weight: 600;
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .tel .caption .headline.swap {
    opacity: 0;
    transform: translateY(5px);
  }
  .tel .surface {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    box-shadow:
      var(--sh-sm),
      0 18px 40px -28px rgba(12, 32, 47, 0.28);
    overflow: hidden;
    height: 548px;
  }
  .tel .appbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .tel .appbar .wdots {
    display: inline-flex;
    gap: 6px;
  }
  .tel .appbar .wdots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(12, 32, 47, 0.15);
  }
  .tel .appbar .wtitle {
    margin-left: 6px;
    font-size: 11px;
    font-weight: 500;
    color: var(--mf);
    letter-spacing: -0.01em;
  }
  .tel .screen {
    position: relative;
    height: calc(100% - 38px);
  }
  .tel .scene {
    position: absolute;
    inset: 0;
    padding: 16px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .tel svg.ic {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tel svg.ic.s14 {
    width: 14px;
    height: 14px;
  }
  .tel svg.ic.s12 {
    width: 12px;
    height: 12px;
  }
  .tel .sect-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .tel .sect-head .lead {
    color: var(--primary);
    display: flex;
  }
  .tel .sect-head small {
    display: block;
    font-size: 11px;
    font-weight: 400;
    color: var(--mf);
  }
  .tel .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border-radius: var(--r-sm);
    font-size: 13px;
    font-weight: 500;
    border: 1px solid transparent;
    box-shadow: var(--sh-xs);
  }
  .tel .btn.primary {
    background: var(--primary);
    color: #fff;
  }
  .tel .btn.destructive {
    background: var(--destructive);
    color: #fff;
  }
  .tel .btn.outline {
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--fg);
    outline: none; /* evita colisão com o utilitário .outline do Tailwind */
  }
  .tel .btn.sm {
    height: 32px;
    font-size: 12px;
  }
  .tel .rec-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .tel .rec-live {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }
  .tel .rec-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--destructive);
    animation: tel-pulse 1.1s infinite;
  }
  .tel .rec-time {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }
  .tel .rec-hint {
    color: var(--mf);
    font-size: 11px;
  }
  .tel .toggle {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tel .switch {
    position: relative;
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background: var(--muted);
    transition: background 0.3s ease;
    flex: 0 0 auto;
  }
  .tel .switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--sh-xs);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tel .switch.on {
    background: var(--primary);
  }
  .tel .switch.on::after {
    transform: translateX(14px);
  }
  .tel .toggle .lbl {
    font-size: 13px;
    color: var(--mf);
  }
  .tel .panel {
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .tel .panel.hide {
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    position: absolute;
    inset: 16px;
  }
  .tel .tcard {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--card);
    padding: 16px;
    box-shadow: var(--sh-xs);
  }
  .tel .tcard-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .tel .tcard-head .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tel .tcard-head .time {
    color: var(--mf);
    font-size: 13px;
  }
  .tel .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: var(--r-md);
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 500;
  }
  .tel .badge.mode {
    border: 1px solid var(--border);
    color: var(--mf);
    font-weight: 400;
  }
  .tel .badge.mode svg {
    width: 12px;
    height: 12px;
  }
  .tel .badge.secondary {
    background: var(--muted);
    color: var(--fg);
  }
  .tel .badge.success {
    background: rgba(90, 195, 176, 0.12);
    color: #2f8b7a;
  }
  .tel .pending-msg {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--mf);
    font-size: 13px;
    line-height: 1.4;
  }
  .tel .spin {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--muted);
    border-top-color: var(--primary);
    animation: tel-spin 0.8s linear infinite;
    flex: 0 0 auto;
  }
  .tel .soap-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .tel .soap-grid .full {
    grid-column: 1 / -1;
  }
  .tel .field {
    display: flex;
    flex-direction: column;
    gap: 3px;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .tel .field.show {
    opacity: 1;
    transform: none;
  }
  .tel .field .lbl {
    color: var(--mf);
    font-size: 11px;
  }
  .tel .field .val {
    font-size: 13px;
    line-height: 1.4;
  }
  .tel .card-actions {
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .tel .card-actions.show {
    opacity: 1;
  }
  .tel .details {
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: rgba(226, 232, 240, 0.25);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .tel .details.show {
    opacity: 1;
  }
  .tel .details .summary {
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tel .details .summary svg {
    transition: transform 0.3s ease;
  }
  .tel .details.open .summary svg {
    transform: rotate(90deg);
  }
  .tel .details .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 12px;
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.5s ease,
      padding 0.5s ease;
  }
  .tel .details.open .body {
    max-height: 260px;
    padding: 4px 12px 12px;
  }
  .tel .seg {
    font-size: 13px;
    line-height: 1.45;
    color: #243747;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .tel .seg.show {
    opacity: 1;
    transform: none;
  }
  .tel .seg b {
    font-weight: 500;
    color: var(--mf);
  }
  .tel .foot {
    text-align: center;
    font-size: 11px;
    color: var(--mf);
  }
  @keyframes tel-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
  @keyframes tel-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tel * {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initTeleconsultaDemo(root: HTMLElement) {
    const q = (s: string) => root.querySelector(s) as HTMLElement;
    const qa = (s: string) => [...root.querySelectorAll(s)] as HTMLElement[];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const headline = q('[data-headline]');
    async function setHeadline(text: string) {
      headline.classList.add('swap');
      await sleep(330);
      headline.textContent = text;
      headline.classList.remove('swap');
    }

    let recRunning = false;
    function startRecTimer() {
      recRunning = true;
      let secs = 0;
      const tick = () => {
        if (!recRunning) return;
        q('[data-rec-time]').textContent =
          `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`;
        secs += 7;
        setTimeout(tick, 320);
      };
      tick();
    }

    const fields = qa('[data-result-body] .field');
    const segs = qa('[data-seg-body] .seg');

    function reset() {
      recRunning = false;
      q('[data-switch]').classList.remove('on');
      q('[data-recorder]').classList.remove('hide');
      q('[data-rec-btn]').className = 'btn primary';
      q('[data-rec-label]').textContent = 'Gravar consulta';
      q('[data-rec-icon]').innerHTML =
        '<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/>';
      q('[data-upload-btn]').style.display = 'inline-flex';
      q('[data-rec-live]').style.display = 'none';
      q('[data-toggle-row]').style.display = 'flex';
      q('[data-rec-time]').textContent = '00:00';
      q('[data-card-panel]').classList.add('hide');
      q('[data-pending-msg]').style.display = 'flex';
      q('[data-result-body]').style.display = 'none';
      q('[data-status-badge]').className = 'badge secondary';
      q('[data-status-badge]').innerHTML =
        '<span class="spin" style="width:12px;height:12px"></span> Processando';
      q('[data-details]').classList.remove('show', 'open');
      fields.forEach((f) => f.classList.remove('show'));
      segs.forEach((s) => {
        s.classList.remove('show');
        s.innerHTML = '';
      });
      q('[data-card-actions]').classList.remove('show');
    }

    async function run() {
      reset();

      await setHeadline('Marque a consulta como teleconsulta');
      await sleep(700);
      q('[data-switch]').classList.add('on');
      await sleep(1500);

      await setHeadline('Grave a consulta ao vivo: os dois lados são capturados');
      q('[data-rec-btn]').className = 'btn destructive';
      q('[data-rec-label]').textContent = 'Parar';
      q('[data-rec-icon]').innerHTML = '<rect x="6" y="6" width="12" height="12" rx="1"/>';
      q('[data-upload-btn]').style.display = 'none';
      q('[data-toggle-row]').style.display = 'none';
      q('[data-rec-live]').style.display = 'flex';
      startRecTimer();
      await sleep(3200);
      recRunning = false;

      await setHeadline('A IA gera a transcrição e o resumo clínico');
      q('[data-recorder]').classList.add('hide');
      q('[data-card-panel]').classList.remove('hide');
      await sleep(2400);

      await setHeadline('Resumo clínico pronto, marcado como teleconsulta');
      q('[data-status-badge]').className = 'badge success';
      q('[data-status-badge]').innerHTML =
        '<svg class="ic s12" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg> Concluída';
      q('[data-pending-msg]').style.display = 'none';
      q('[data-result-body]').style.display = 'flex';
      await sleep(150);
      for (const f of fields) {
        f.classList.add('show');
        await sleep(220);
      }
      await sleep(200);
      q('[data-card-actions]').classList.add('show');
      await sleep(400);

      q('[data-details]').classList.add('show');
      await sleep(500);
      q('[data-details]').classList.add('open');
      await sleep(350);
      for (const s of segs) {
        s.innerHTML = `<b>${s.dataset.label}:</b> ${s.dataset.text}`;
        s.classList.add('show');
        await sleep(450);
      }
      await sleep(3200);
    }

    async function runOnce() {
      await run();
    }
    (root as any).__runDemo = runOnce;
    root.dispatchEvent(new CustomEvent('demo:ready', { bubbles: true }));
    if (!root.closest('[data-controlled]')) {
      (async () => {
        while (true) {
          await runOnce();
          await sleep(400);
        }
      })();
    }
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('.tel').forEach((root) => {
      if (root.dataset.booted) return;
      root.dataset.booted = '1';
      initTeleconsultaDemo(root);
    });
  }
  if (document.readyState !== 'loading') boot();
  else document.addEventListener('DOMContentLoaded', boot);
</script>
