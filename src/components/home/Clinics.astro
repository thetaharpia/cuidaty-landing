---
// Para clínicas: tudo que é do plano Clínicas e Grupos numa seção só. Âncora do "Para clínicas" da navbar.
// Carrossel: a faixa vai da direita para a esquerda sem parar (pausa no hover/foco).
// Com movimento reduzido, vira rolagem lateral manual.
import { PROPOSAL_URL } from '../../lib/plans';

const features = [
  { title: 'Financeiro completo', text: 'Caixa, faturas e checkout, sem planilha paralela.' },
  {
    title: 'Convênios',
    text: 'Guias Geap e SulAmérica emitidas e conferidas, com a glosa mapeada.',
  },
  { title: 'Contratos', text: 'Preenchidos com os dados do prontuário e assinados pelo celular.' },
  { title: 'Metas de receita', text: 'Calculadas a partir do financeiro real da clínica.' },
  { title: 'Multiunidade', text: 'Várias filiais e grupos em uma conta só.' },
  {
    title: 'Equipes e permissões',
    text: 'Cada cargo vê só o que precisa, do prontuário ao caixa.',
  },
  { title: 'Analytics', text: 'Ocupação da agenda, faturamento por operadora e comunicação.' },
  { title: 'Migração de dados', text: 'Seus pacientes e históricos vêm da plataforma anterior.' },
];
const steps = [
  {
    n: '1',
    title: 'Diagnóstico',
    text: 'Mapeamos como a agenda funciona, onde o dinheiro trava e o que cada convênio exige.',
  },
  {
    n: '2',
    title: 'Implantação adaptada',
    text: 'O sistema é montado na sua rotina, com seus modelos e regras de convênio.',
  },
  {
    n: '3',
    title: 'Automação contínua',
    text: 'Confirmação, cobrança e conferência saem da mesa a cada rodada.',
  },
  {
    n: '4',
    title: 'Acompanhamento direto',
    text: 'Revisões com números na mesa e um contato fixo na Cuidaty.',
  },
];
---

<section id="clinicas" class="scroll-mt-24 bg-white py-20 md:py-28">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="kicker">Para clínicas</p>
          <h2 class="mt-4 text-balance text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl">
            Financeiro, convênio e equipe no mesmo lugar.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
            Tudo do plano Clínicas e Grupos, com uma pessoa com nome acompanhando a implantação.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a
            href={PROPOSAL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-solid"
            data-ga-event="contact_click"
            data-ga-location="clinicas">Falar com a gente</a
          >
        </div>
      </div>
    </div>
  </div>

  <div
    class="clinic-marquee mt-12"
    role="region"
    aria-label="Recursos do plano Clínicas e Grupos"
    tabindex="0"
  >
    <div class="clinic-track">
      {
        [false, true].map((copy) => (
          <ul class="clinic-set" aria-hidden={copy ? 'true' : undefined}>
            {features.map((f) => (
              <li class="w-72 shrink-0 rounded-md border border-border bg-white p-6 shadow-soft">
                {/* A cópia do loop não repete os títulos para o Google. */}
                {copy ? (
                  <p class="font-sans text-lg font-semibold text-cuidaty-dark">{f.title}</p>
                ) : (
                  <h3 class="font-sans text-lg font-semibold text-cuidaty-dark">{f.title}</h3>
                )}
                <p class="mt-2 text-sm leading-relaxed text-cuidaty-dark/70">{f.text}</p>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <div class="container mx-auto px-5 md:px-8">
    <ol class="mx-auto mt-16 grid max-w-7xl gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <li class="border-t-2 border-cuidaty-dark pt-5">
            <span class="font-serif text-3xl font-extrabold text-primary-ink">{s.n}</span>
            <h3 class="mt-3 text-xl leading-snug text-cuidaty-dark">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-cuidaty-dark/70">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .clinic-marquee {
    overflow-x: auto;
    padding-block: 0.5rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .clinic-track {
    display: flex;
    width: max-content;
  }
  .clinic-set {
    display: flex;
    gap: 1.25rem;
    padding-right: 1.25rem;
  }
  /* Sem movimento reduzido: rola sozinho; a segunda cópia fecha o loop em -50%. */
  @media (prefers-reduced-motion: no-preference) {
    .clinic-marquee {
      overflow: hidden;
    }
    .clinic-track {
      animation: clinic-scroll 40s linear infinite;
    }
    .clinic-marquee:hover .clinic-track,
    .clinic-marquee:focus-within .clinic-track {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clinic-set[aria-hidden] {
      display: none;
    }
  }
  @keyframes clinic-scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
