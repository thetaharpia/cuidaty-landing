---
// Demo do MIDAS no hero: o funil da clínica, com um orçamento saindo de
// "em aberto" para "fechou" em laço. Ilustração com dados fictícios, só CSS.
const columns = [
  {
    title: 'Novo contato',
    count: 6,
    cards: [
      { name: 'Rafael T.', note: 'WhatsApp · há 4 min', tag: 'Anúncio Meta' },
      { name: 'Clínica Viva', note: 'Telefone · há 20 min', tag: 'Google' },
    ],
  },
  {
    title: 'Orçamento em aberto',
    count: 14,
    cards: [
      { name: 'Marina S.', note: 'Retorno hoje · resp. Ana', tag: 'Avaliação', moving: 'out' },
      { name: 'João P.', note: 'Retorno quinta · resp. Léo', tag: 'Terapia de casal' },
    ],
  },
  {
    title: 'Fechou',
    count: 9,
    cards: [
      { name: 'Marina S.', note: 'Fechado agora', tag: 'Avaliação', moving: 'in' },
      { name: 'Bianca R.', note: 'Fechado ontem', tag: 'Psicoterapia' },
    ],
  },
] as const;
---

<div class="hms" aria-label="Demonstração do funil do MIDAS, com dados fictícios" role="img">
  <div class="hms-frame">
    <div class="hms-bar">
      <span class="hms-dotrow" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="hms-title">MIDAS Vision · funil da clínica</span>
    </div>

    <div class="hms-stats">
      <div>
        <span class="hms-label">Vendas novas no mês</span>
        <span class="hms-value">
          <span class="hms-swap">
            <b class="hms-before">R$ 38.400</b>
            <b class="hms-after">R$ 41.200</b>
          </span>
        </span>
      </div>
      <div>
        <span class="hms-label">Orçamentos sem retorno</span>
        <span class="hms-value"><b>0</b></span>
      </div>
      <div class="hms-stat-wide">
        <span class="hms-label">Contato respondido em</span>
        <span class="hms-value"><b>4 min</b></span>
      </div>
    </div>

    <div class="hms-board">
      {
        columns.map((col) => (
          <div class="hms-col">
            <p class="hms-col-title">
              {col.title}
              <span>{col.count}</span>
            </p>
            {col.cards.map((card) => (
              <div
                class:list={[
                  'hms-card',
                  'moving' in card && card.moving === 'out' && 'hms-card--out',
                  'moving' in card && card.moving === 'in' && 'hms-card--in',
                ]}
              >
                <b>{card.name}</b>
                <span>{card.note}</span>
                <em>{card.tag}</em>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <p class="hms-caption">Demonstração · nomes e dados fictícios</p>
</div>

<style>
  .hms {
    --gold: #e9a93a;
    --gold-ink: #8f5d0d;
    --gold-soft: #fdf3da;
  }
  .hms-frame {
    overflow: hidden;
    border: 1px solid rgb(12 32 47 / 0.12);
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 30px 60px -30px rgb(12 32 47 / 0.25);
  }
  .hms-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgb(12 32 47 / 0.08);
    background: var(--gold-soft);
  }
  .hms-dotrow {
    display: flex;
    gap: 0.3rem;
  }
  .hms-dotrow i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgb(143 93 13 / 0.3);
  }
  .hms-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gold-ink);
  }
  .hms-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1.1rem 1.1rem 0.4rem;
  }
  .hms-stat-wide {
    display: none;
  }
  .hms-label {
    display: block;
    font-size: 0.7rem;
    color: rgb(12 32 47 / 0.6);
  }
  .hms-value {
    display: block;
    margin-top: 0.15rem;
    font-family: 'Bricolage Grotesque Variable', 'Bricolage Grotesque', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    color: #0c202f;
  }
  .hms-swap {
    display: inline-grid;
  }
  .hms-swap b {
    grid-area: 1 / 1;
  }
  .hms-before {
    opacity: 0;
  }
  .hms-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    padding: 0.9rem 1.1rem 1.2rem;
  }
  .hms-col {
    min-width: 0;
    padding: 0.6rem;
    border-radius: 0.7rem;
    background: #f6f4ef;
  }
  .hms-col:last-child {
    background: var(--gold-soft);
  }
  .hms-col-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.2;
    color: rgb(12 32 47 / 0.75);
  }
  .hms-col-title span {
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: rgb(12 32 47 / 0.08);
    font-size: 0.62rem;
  }
  .hms-card {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.4rem;
    padding: 0.55rem 0.6rem;
    border: 1px solid rgb(12 32 47 / 0.08);
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.68rem;
    line-height: 1.3;
  }
  .hms-card b {
    font-size: 0.74rem;
    font-weight: 600;
    color: #0c202f;
  }
  .hms-card span {
    color: rgb(12 32 47 / 0.65);
  }
  .hms-card em {
    justify-self: start;
    margin-top: 0.2rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--gold-soft);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 600;
    color: var(--gold-ink);
  }
  .hms-card--in {
    border-color: var(--gold);
  }
  /* Sem movimento, mostra o estado final: o orçamento já fechado. */
  .hms-card--out {
    display: none;
  }
  .hms-caption {
    margin-top: 0.9rem;
    text-align: center;
    font-size: 0.75rem;
    color: rgb(12 32 47 / 0.6);
  }

  @media (min-width: 640px) {
    .hms-stats {
      grid-template-columns: repeat(3, 1fr);
    }
    .hms-stat-wide {
      display: block;
    }
    .hms-card {
      font-size: 0.74rem;
    }
    .hms-card b {
      font-size: 0.82rem;
    }
    .hms-col-title {
      font-size: 0.74rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hms-card--out {
      display: grid;
      animation: hms-out 7s ease-in-out infinite;
    }
    .hms-card--in {
      animation: hms-in 7s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    .hms-before {
      animation: hms-before 7s ease infinite;
    }
    .hms-after {
      animation: hms-after 7s ease infinite;
    }
  }
  /* 0-40%: orçamento em aberto. 40-50%: passa de coluna. 50-95%: fechado. */
  @keyframes hms-out {
    0%,
    38% {
      max-height: 6rem;
      margin-top: 0.4rem;
      padding-block: 0.55rem;
      border-width: 1px;
      opacity: 1;
      transform: none;
    }
    46% {
      max-height: 6rem;
      margin-top: 0.4rem;
      padding-block: 0.55rem;
      border-width: 1px;
      opacity: 0;
      transform: translateX(40%);
    }
    52%,
    94% {
      max-height: 0;
      margin-top: 0;
      padding-block: 0;
      border-width: 0;
      opacity: 0;
      transform: translateX(40%);
    }
    100% {
      max-height: 6rem;
      margin-top: 0.4rem;
      padding-block: 0.55rem;
      border-width: 1px;
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hms-in {
    0%,
    44% {
      max-height: 0;
      margin-top: 0;
      padding-block: 0;
      border-width: 0;
      opacity: 0;
      transform: translateX(-40%) scale(0.96);
    }
    54%,
    94% {
      max-height: 6rem;
      margin-top: 0.4rem;
      padding-block: 0.55rem;
      border-width: 1px;
      opacity: 1;
      transform: none;
    }
    100% {
      max-height: 0;
      margin-top: 0;
      padding-block: 0;
      border-width: 0;
      opacity: 0;
      transform: none;
    }
  }
  @keyframes hms-before {
    0%,
    48% {
      opacity: 1;
    }
    54%,
    96% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes hms-after {
    0%,
    48% {
      opacity: 0;
    }
    54%,
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
