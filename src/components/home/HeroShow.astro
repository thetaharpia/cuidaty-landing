---
// Hero em sequência, na ordem do atendimento, com "câmera":
//   1. Na web, com zoom em cada tela: cadastro do paciente, agenda e confirmação pelo WhatsApp.
//   2. Consulta: a janela sai e o celular entra grande; a agenda do dia rola até o paciente e a
//      consulta é gravada. Ele dá uma volta (com espessura e costas) e vai para o canto.
//   3. Prontuário: o resumo da transcrição pronto na web.
// Um relógio (ms) move tudo: data-scene e data-zoom no root, e .on nos itens com data-at.
// Com movimento reduzido não há loop: os passos de baixo mostram o fim de cada cena.
const LOOP = 26500;
// No fim do loop a janela some e tudo recomeça pelo cadastro; a última cena termina aqui.
const LEAVE = 25200;
const scenes = [
  { id: 'cad', start: 0, label: 'Cadastro' },
  { id: 'agenda', start: 4000, label: 'Agenda' },
  { id: 'whats', start: 8500, label: 'WhatsApp' },
  { id: 'cel', start: 13000, label: 'Consulta' },
  { id: 'pront', start: 20000, label: 'Prontuário' },
];
const today = [
  ['08:00', 'Maria Souza'],
  ['09:30', 'Ana Paula'],
  ['11:00', 'Carlos Mendes'],
  ['14:00', 'João Lima'],
  ['15:30', 'Beatriz Rocha'],
  ['17:00', 'Rafael Dias'],
];
const live = [
  [16400, 'Fiquei ansioso antes da reunião de quinta…'],
  [17200, '…e dormi mal a semana toda.'],
  [18000, 'Fiz a respiração em três dias, ajudou.'],
];
// Lateral do celular: anéis empilhados em Z, o meio da espessura mais claro (aro arredondado),
// como no PhoneSpin da capy-reels.
const RINGS = 24;
const rings = Array.from({ length: RINGS }, (_, i) => {
  const t = (i + 1) / (RINGS + 1);
  const light = Math.round(60 + 70 * Math.sin(Math.PI * t));
  return { t, color: `rgb(${light}, ${light}, ${light})` };
});
const bars = Array.from({ length: 22 }, (_, i) => 18 + Math.round(70 * Math.abs(Math.sin(i * 1.9))));
const fields = [
  [600, 'Nome completo', 'João Lima', 9],
  [1200, 'Celular', '(11) 98765-4321', 15],
  [1800, 'Nascimento', '12/03/1990', 10],
  [2400, 'E-mail', 'joao@email.com', 14],
];
const week = [
  ['Seg', [['9h', 'Maria S.', 8], ['15h', 'Ana P.', 58]]],
  ['Ter', [['10h', 'Carlos M.', 20], ['16h', 'Beatriz R.', 66]]],
  ['Qua', [['8h', 'Rafael D.', 4], ['11h', 'Maria S.', 30]]],
  ['Qui', [['9h', 'Ana P.', 8]]],
  ['Sex', [['10h', 'Carlos M.', 20], ['17h', 'Beatriz R.', 74]]],
];
const chats = [
  ['Maria Souza', 'Obrigada! Até lá.'],
  ['João Lima', 'Confirmo, obrigado'],
  ['Ana Paula', 'Posso remarcar?'],
];
const soap = [
  [21400, 'Queixa principal', 'Ansiedade antes de reuniões e sono irregular.'],
  [21800, 'Subjetivo (S)', 'Piora na semana; aderiu à respiração em 3 dias.'],
  [22200, 'Avaliação (A)', 'Sintomas compatíveis com ansiedade situacional.'],
  [22600, 'Plano (P)', 'Manter sessões semanais e treino de respiração.'],
];
const nav = [
  ['cad', 'Pacientes', 'M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z'],
  ['agenda', 'Agenda', 'M7 3v3M17 3v3M4 8h16M5 5h14v15H5z'],
  ['whats', 'WhatsApp', 'M5 19l1.4-3.6A7.5 7.5 0 1 1 9 18.6z'],
  ['pront', 'Prontuário', 'M7 4h10v16H7zM10 9h4M10 13h4'],
];
const urls = {
  cad: 'app.cuidaty.com/pacientes/novo',
  agenda: 'app.cuidaty.com/agenda',
  whats: 'app.cuidaty.com/comunicacao',
  pront: 'app.cuidaty.com/pacientes/joao-lima',
};
---

<div class="hs" data-hs data-scene="cel" data-loop={LOOP} data-leave={LEAVE} role="img" aria-label="Demonstração da Cuidaty: consulta gravada no celular, depois cadastro do paciente, agenda, confirmação pelo WhatsApp e prontuário pronto na web">
  <!-- ================= Janela da web ================= -->
  <div class="hs-win">
    <div class="hs-chrome">
      <span class="hs-url">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
        {Object.entries(urls).map(([id, url]) => <span class="hs-for" data-for={id}>{url}</span>)}
      </span>
    </div>
    <div class="hs-app">
      <aside class="hs-side" aria-hidden="true">
        <img src="/logo-mark.png" alt="" width="62" height="81" />
        {nav.map(([id, label, d]) => (
          <span class="hs-nav" data-for={id}>
            <svg viewBox="0 0 24 24"><path d={d} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></path></svg>
            {label}
          </span>
        ))}
      </aside>

      <div class="hs-view">
        <div class="hs-cam">
          <!-- Cadastro -->
          <section class="hs-scene" data-for="cad">
            <p class="hs-crumb">Pacientes / <b>Novo paciente</b></p>
            <div class="hs-form">
              {fields.map(([at, label, value, chars]) => (
                <label class="hs-field">
                  <span>{label}</span>
                  <i class="hs-input"><b class="hs-type" data-at={at} style={`--s:${chars}`}>{value}</b></i>
                </label>
              ))}
              <div class="hs-field">
                <span>Atendimento</span>
                <i class="hs-chips"><b class="hs-chip" data-at="2900">Particular</b><b class="hs-chip hs-chip-off">Convênio</b></i>
              </div>
            </div>
            <span class="hs-btn hs-press" data-press="3300">Salvar paciente</span>
          </section>

          <!-- Agenda -->
          <section class="hs-scene" data-for="agenda">
            <p class="hs-crumb">Agenda · <b>semana de 13/10</b></p>
            <div class="hs-week">
              {week.map(([day, slots]) => (
                <div class="hs-col">
                  <span class="hs-day">{day}</span>
                  {(slots as [string, string, number][]).map(([h, who, top]) => (
                    <i class="hs-slot" style={`top:${top}%`}><b>{h}</b> {who}</i>
                  ))}
                  {day === 'Qui' && (
                    <i class="hs-slot hs-new" data-at="4900" style="top:46%">
                      <b>14h</b> João Lima
                      <small class="hs-remind" data-at="6700">Lembrete no WhatsApp</small>
                    </i>
                  )}
                </div>
              ))}
            </div>
            <p class="hs-note" data-at="5900">Sem conflito de horário</p>
          </section>

          <!-- WhatsApp -->
          <section class="hs-scene hs-wa" data-for="whats">
            <div class="hs-list">
              {chats.map(([who, last], i) => (
                <p class:list={['hs-conv', i === 1 && 'on']}><b>{who}</b><span>{last}</span></p>
              ))}
            </div>
            <div class="hs-chat">
              <p class="hs-chat-head"><b>João Lima</b> · WhatsApp</p>
              <p class="hs-out" data-at="9200">Oi, João! Sua consulta com a Dra. Ana é quinta às 14h. Confirma?</p>
              <p class="hs-typing" data-at="9900"><i></i><i></i><i></i></p>
              <p class="hs-in" data-at="10800">Confirmo, obrigado!</p>
              <p class="hs-sys" data-at="11500">Consulta confirmada na agenda</p>
            </div>
          </section>

          <!-- Prontuário -->
          <section class="hs-scene" data-for="pront">
            <p class="hs-crumb">Pacientes / <b>João Lima</b></p>
            <div class="hs-card">
              <div class="hs-card-head">
                <b>Transcrição · 10/10</b>
                <span class="hs-badge">Presencial</span>
                <span class="hs-badge hs-status">
                  <span class="hs-st-a"><i class="hs-spin"></i>Processando</span>
                  <span class="hs-st-b">Concluída</span>
                </span>
              </div>
              <div class="hs-soap">
                {soap.map(([at, label, text]) => (
                  <div class="hs-sf" data-at={at}><span>{label}</span>{text}</div>
                ))}
              </div>
              <span class="hs-btn hs-press" data-press="23200">Usar no novo registro</span>
            </div>
          </section>
        </div>
        <p class="hs-toast" data-at="3500" data-until="4000">Paciente cadastrado</p>
        <p class="hs-toast" data-at="23500" data-until={LEAVE}>Salvo no prontuário de João Lima</p>
      </div>
    </div>
  </div>

  <!-- ================= Celular ================= -->
  <div class="hs-phone">
   <div class="hs-body">
    <div class="hs-rim" aria-hidden="true">{rings.map((r) => <i style={`--t:${r.t};border-color:${r.color}`}></i>)}</div>
    <span class="hs-btns" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="hs-back" aria-hidden="true"><i></i></div>
    <div class="hs-front">
      <div class="hs-screen">
        <div class="hs-status" aria-hidden="true"><span>9:41</span><span class="hs-island"></span><span>●●●</span></div>

        <!-- Tela 1: agenda do dia, rola até o João -->
        <div class="hs-ps hs-ps-today">
          <p class="hs-ph-title">Hoje<small>sexta, 10 de outubro</small></p>
          <div class="hs-today">
            <div class="hs-today-list">
              {today.map(([h, who]) => (
                <p class:list={['hs-appt', who === 'João Lima' && 'hs-appt-target']}><b>{h}</b>{who}<span>Presencial</span></p>
              ))}
            </div>
          </div>
        </div>

        <!-- Tela 2: gravação -->
        <div class="hs-ps hs-ps-rec">
          <p class="hs-ph-title">João Lima<small>Presencial · gravando</small></p>
          <div class="hs-rec"><span class="hs-dot"></span><span class="hs-timer" data-timer>00:00</span></div>
          <div class="hs-wave" aria-hidden="true">{bars.map((h, i) => <i style={`--h:${h}%;--i:${i}`}></i>)}</div>
          <div class="hs-live">{live.map(([at, text]) => <p data-at={at}>{text}</p>)}</div>
          <div class="hs-ph-foot">
            <span class="hs-stop hs-press" data-press="18800"><i></i></span>
            <span class="hs-sent" data-at="19000">Enviado para transcrição</span>
            <span class="hs-sent hs-ready" data-at="21000">Resumo pronto no prontuário</span>
          </div>
        </div>
      </div>
      <span class="hs-tap" aria-hidden="true"></span>
    </div>
   </div>
  </div>
</div>

<div class="hs-steps" role="tablist" aria-label="Etapas da demonstração">
  {scenes.map((s, i) => (
    <button type="button" role="tab" class="hs-step" data-step={s.id} data-start={s.start} data-end={scenes[i + 1]?.start ?? LEAVE}>
      {s.label}
    </button>
  ))}
</div>

<style>
  .hs {
    --ink: #0c202f;
    --muted: #64748b;
    --line: #e2e8f0;
    --primary: #356588;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1 / 0.86;
    color: var(--ink);
    perspective: 1800px;
  }

  /* ================= Janela ================= */
  .hs-win {
    position: absolute;
    inset: 0 9% 9% 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 2cqw;
    background: #fff;
    box-shadow: 0 40px 80px -40px rgb(12 32 47 / 0.4);
    font-size: 1.95cqw;
    opacity: 0;
    transform: scale(0.9) translateY(4cqw);
    transition:
      opacity 0.8s,
      transform 1s var(--ease);
  }
  .hs:not([data-scene='cel']) .hs-win {
    opacity: 1;
    transform: none;
  }
  .hs.leaving .hs-win {
    opacity: 0;
    transform: scale(0.94);
  }
  .hs-chrome {
    display: flex;
    align-items: center;
    height: 6cqw;
    padding: 0 1.8cqw;
    border-bottom: 1px solid var(--line);
  }
  .hs-url {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 1cqw;
    height: 3.9cqw;
    padding: 0 1.5cqw;
    border-radius: 1cqw;
    background: #f1f5f9;
    color: var(--muted);
    font-size: 1.7cqw;
    white-space: nowrap;
  }
  .hs-url svg {
    width: 1.7cqw;
    height: 1.7cqw;
  }
  .hs-app {
    display: flex;
    flex: 1;
    min-height: 0;
  }
  .hs-side {
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
    width: 17cqw;
    padding: 2cqw 1.2cqw;
    border-right: 1px solid var(--line);
    font-size: 1.6cqw;
    font-weight: 600;
    color: var(--muted);
  }
  .hs-side img {
    align-self: flex-start;
    width: auto;
    height: 3.6cqw;
    margin: 0 0 1.6cqw 0.8cqw;
  }
  .hs-nav {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    padding: 0.9cqw 1cqw;
    border-radius: 0.8cqw;
    transition:
      background 0.4s,
      color 0.4s;
  }
  .hs-nav svg {
    width: 2cqw;
    height: 2cqw;
  }
  .hs-view {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  /* Câmera: cada cena define para onde o zoom vai. */
  .hs-cam {
    position: absolute;
    inset: 0;
    transform-origin: var(--ox, 0) var(--oy, 0);
    transition: transform 1.3s var(--ease);
  }
  .hs[data-zoom] .hs-cam {
    transform: scale(var(--zz, 1.3));
  }
  .hs[data-scene='cad'] .hs-cam {
    --ox: 0%;
    --oy: 10%;
    --zz: 1.32;
  }
  .hs[data-scene='agenda'] .hs-cam {
    --ox: 72%;
    --oy: 55%;
    --zz: 1.55;
  }
  .hs[data-scene='whats'] .hs-cam {
    --ox: 85%;
    --oy: 45%;
    --zz: 1.35;
  }
  .hs[data-scene='pront'] .hs-cam {
    --ox: 40%;
    --oy: 50%;
    --zz: 1.22;
  }

  .hs-for,
  .hs-scene {
    display: none;
  }
  .hs[data-scene='cad'] [data-for='cad'],
  .hs[data-scene='agenda'] [data-for='agenda'],
  .hs[data-scene='whats'] [data-for='whats'],
  .hs[data-scene='pront'] [data-for='pront'],
  .hs[data-scene='cel'] [data-for='cad'] {
    display: block;
  }
  .hs[data-scene='cad'] .hs-nav[data-for='cad'],
  .hs[data-scene='agenda'] .hs-nav[data-for='agenda'],
  .hs[data-scene='whats'] .hs-nav[data-for='whats'],
  .hs[data-scene='pront'] .hs-nav[data-for='pront'] {
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
  }
  .hs-nav {
    display: flex !important;
  }
  .hs-scene {
    position: absolute;
    inset: 0;
    padding: 2.4cqw 2.6cqw;
    animation: hs-scene-in 0.6s var(--ease);
  }
  .hs-wa {
    display: none;
    padding: 0;
  }
  .hs[data-scene='whats'] .hs-wa {
    display: grid;
    grid-template-columns: 34% 1fr;
  }
  .hs-crumb {
    color: var(--muted);
    font-size: 1.7cqw;
  }
  .hs-crumb b {
    color: var(--ink);
  }

  /* Cadastro */
  .hs-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6cqw;
    margin-top: 2.2cqw;
  }
  .hs-field {
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
  }
  .hs-field > span {
    color: var(--muted);
    font-size: 1.5cqw;
    font-weight: 600;
  }
  .hs-input {
    display: flex;
    align-items: center;
    height: 4.4cqw;
    padding: 0 1.2cqw;
    border: 1px solid var(--line);
    border-radius: 0.8cqw;
    font-style: normal;
  }
  .hs-type {
    font-weight: 500;
    white-space: nowrap;
    clip-path: inset(0 100% 0 0);
    transition: clip-path calc(var(--s) * 45ms) steps(var(--s));
  }
  .hs-type.on {
    clip-path: inset(0 0 0 0);
  }
  .hs-chips {
    display: flex;
    gap: 0.8cqw;
    font-style: normal;
  }
  .hs-chip {
    padding: 0.8cqw 1.4cqw;
    border: 1px solid var(--line);
    border-radius: 0.6cqw;
    font-size: 1.6cqw;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .hs-chip.on {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }
  .hs-chip-off {
    color: var(--muted);
  }
  .hs-btn {
    display: inline-block;
    margin-top: 2.2cqw;
    padding: 1.1cqw 2.2cqw;
    border-radius: 0.6cqw;
    background: var(--primary);
    color: #fff;
    font-size: 1.7cqw;
    font-weight: 600;
  }

  /* Agenda */
  .hs-week {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.8cqw;
    height: 78%;
    margin-top: 1.8cqw;
  }
  .hs-col {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 0.8cqw;
  }
  .hs-day {
    display: block;
    padding: 0.8cqw;
    color: var(--muted);
    font-size: 1.5cqw;
    font-weight: 600;
    text-align: center;
  }
  .hs-slot {
    position: absolute;
    left: 0.5cqw;
    right: 0.5cqw;
    margin-top: 3.6cqw;
    padding: 0.6cqw 0.8cqw;
    border-radius: 0.5cqw;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    font-size: 1.35cqw;
    font-style: normal;
    line-height: 1.3;
  }
  .hs-new {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    box-shadow: 0 1.4cqw 2.4cqw -1.4cqw rgb(12 32 47 / 0.35);
  }
  .hs-remind {
    display: block;
    margin-top: 0.4cqw;
    font-size: 1.15cqw;
    font-weight: 600;
    opacity: 0.85;
  }
  .hs-note {
    margin-top: 1.2cqw;
    color: var(--ink);
    font-size: 1.6cqw;
    font-weight: 600;
  }

  /* WhatsApp */
  .hs-list {
    border-right: 1px solid var(--line);
    padding: 1.6cqw 0;
  }
  .hs-conv {
    padding: 1.2cqw 1.6cqw;
    font-size: 1.5cqw;
  }
  .hs-conv b,
  .hs-conv span {
    display: block;
  }
  .hs-conv span {
    color: var(--muted);
    font-size: 1.35cqw;
  }
  .hs-conv.on {
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .hs-chat {
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
    padding: 1.6cqw 2cqw;
  }
  .hs-chat-head {
    padding-bottom: 1.2cqw;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 1.5cqw;
  }
  .hs-chat-head b {
    color: var(--ink);
  }
  .hs-out,
  .hs-in,
  .hs-typing {
    max-width: 78%;
    padding: 1cqw 1.4cqw;
    border-radius: 1.4cqw;
    line-height: 1.4;
  }
  .hs-out {
    align-self: flex-end;
    background: var(--ink);
    color: #fff;
    border-bottom-right-radius: 0.4cqw;
  }
  .hs-in,
  .hs-typing {
    border: 1px solid var(--line);
    border-bottom-left-radius: 0.4cqw;
  }
  .hs-typing {
    display: flex;
    gap: 0.5cqw;
  }
  .hs-typing i {
    width: 0.9cqw;
    height: 0.9cqw;
    border-radius: 50%;
    background: var(--muted);
    animation: hs-bounce 0.9s infinite;
  }
  .hs-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .hs-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  .hs-typing.on.gone {
    display: none;
  }
  .hs-sys {
    align-self: center;
    padding: 0.6cqw 1.4cqw;
    border-radius: 99px;
    color: var(--muted);
    font-size: 1.5cqw;
    font-weight: 600;
  }

  /* Prontuário */
  .hs-card {
    margin-top: 1.8cqw;
    padding: 2cqw;
    border: 1px solid var(--line);
    border-radius: 1.2cqw;
  }
  .hs-card-head {
    display: flex;
    align-items: center;
    gap: 1cqw;
  }
  .hs-card-head b {
    margin-right: auto;
  }
  .hs-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.3cqw 1.2cqw;
    border: 1px solid var(--line);
    border-radius: 0.5cqw;
    color: var(--muted);
    font-size: 1.5cqw;
    white-space: nowrap;
  }
  .hs-status {
    display: inline-grid;
    justify-items: end;
  }
  .hs-status > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6cqw;
    transition: opacity 0.3s;
  }
  .hs-st-b {
    color: var(--ink);
    font-weight: 600;
    opacity: 0;
  }
  .hs.done .hs-st-a {
    opacity: 0;
  }
  .hs.done .hs-st-b {
    opacity: 1;
  }
  .hs-spin {
    width: 1.3cqw;
    height: 1.3cqw;
    border: 0.3cqw solid var(--line);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: hs-rot 0.8s linear infinite;
  }
  .hs-soap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2cqw;
    margin-top: 1.8cqw;
  }
  .hs-sf {
    padding: 1.2cqw 1.4cqw;
    border: 1px solid var(--line);
    border-radius: 0.8cqw;
    font-size: 1.65cqw;
    line-height: 1.4;
  }
  .hs-sf span {
    display: block;
    margin-bottom: 0.4cqw;
    color: var(--muted);
    font-size: 1.4cqw;
    font-weight: 600;
  }
  .hs-toast {
    position: absolute;
    left: 2.6cqw;
    bottom: 2.4cqw;
    padding: 1.1cqw 2cqw;
    border-radius: 0.6cqw;
    background: var(--ink);
    color: #fff;
    font-size: 1.7cqw;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ================= Celular ================= */
  /* Formato do mockup-phone do daisyUI (v5): corpo preto, borda cinza lisa, cantos e câmera
     proporcionais à largura --pw do aparelho (462×978 no original). */
  .hs-phone {
    --pw: 40cqw;
    --edge: #6b6b6b;
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--pw);
    aspect-ratio: 462 / 978;
    transform-style: preserve-3d;
    transform: translateX(-50%) rotateY(0deg);
    transition:
      left 1.1s var(--ease),
      top 1.1s var(--ease),
      width 1.1s var(--ease),
      transform 1.1s var(--ease),
      opacity 0.6s;
  }
  /* Na web o celular vai para o canto, menor. */
  .hs:not([data-scene='cel']) .hs-phone {
    --pw: 26cqw;
    left: 86%;
    top: 34%;
  }
  /* Antes da consulta não há celular: ele espera escondido no centro e entra girando na cena dele. */
  .hs:is([data-scene='cad'], [data-scene='agenda'], [data-scene='whats']) .hs-phone {
    --pw: 40cqw;
    left: 50%;
    top: 0;
    opacity: 0;
    transform: translateX(-50%) translateY(8cqw) scale(0.8) rotateY(-28deg) rotateX(10deg);
  }
  .hs.leaving .hs-phone {
    opacity: 0;
  }
  .hs.spin .hs-phone {
    animation: hs-spin 1.1s var(--ease);
  }
  /* Corpo do celular: de frente, reto. A espessura --pd só aparece quando ele gira. */
  .hs-body {
    --pd: 4cqw;
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .hs:not([data-scene='cel']) .hs-body {
    --pd: 2.4cqw;
  }
  .hs-front,
  .hs-back {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--pw) * 0.141);
    backface-visibility: hidden;
    transform: translateZ(calc(var(--pd) / 2));
  }
  .hs-front {
    padding: calc(var(--pw) * 0.013);
    border: calc(var(--pw) * 0.0108) solid var(--edge);
    background: #000;
    box-shadow: 0 50px 80px -40px rgb(12 32 47 / 0.6);
  }
  .hs-back {
    transform: rotateY(180deg) translateZ(calc(var(--pd) / 2));
    border: calc(var(--pw) * 0.0108) solid var(--edge);
    background: linear-gradient(160deg, #2a2a2c, #161617 60%, #222224);
  }
  .hs-back i {
    position: absolute;
    top: 5%;
    left: 8%;
    width: 36%;
    aspect-ratio: 1;
    border-radius: 28%;
    background:
      radial-gradient(circle at 30% 30%, #0d0f12 0 16%, transparent 17%),
      radial-gradient(circle at 70% 30%, #0d0f12 0 16%, transparent 17%),
      radial-gradient(circle at 50% 72%, #0d0f12 0 16%, transparent 17%),
      linear-gradient(150deg, #3a3a3c, #2a2a2c);
  }
  /* Espessura: anéis empilhados em Z, para o celular não virar folha de perfil. */
  .hs-rim i {
    position: absolute;
    inset: 0;
    border: calc(var(--pw) * 0.0108) solid;
    border-radius: calc(var(--pw) * 0.141);
    transform: translateZ(calc(var(--pd) / 2 - var(--t) * var(--pd)));
  }
  /* Botões: volume e silencioso à esquerda, liga à direita, no meio da espessura. */
  .hs-btns i {
    position: absolute;
    width: calc(var(--pd) * 0.55);
    border-radius: 99px;
    background: linear-gradient(90deg, #4a4a4c, #8a8a8c, #4a4a4c);
    transform: translateZ(0) rotateY(90deg);
  }
  .hs-btns i:nth-child(1) {
    left: calc(var(--pd) * -0.27 - 0.3cqw);
    top: 18%;
    height: 4%;
  }
  .hs-btns i:nth-child(2) {
    left: calc(var(--pd) * -0.27 - 0.3cqw);
    top: 25%;
    height: 8%;
  }
  .hs-btns i:nth-child(3) {
    right: calc(var(--pd) * -0.27 - 0.3cqw);
    top: 24%;
    height: 11%;
  }
  /* Reflexo do vidro. */
  .hs-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.22) 0%, rgb(255 255 255 / 0) 38%);
    pointer-events: none;
  }
  .hs-screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--pw) * 0.117);
    background: #fff;
    font-size: 2.1cqw;
  }
  .hs:not([data-scene='cel']) .hs-screen {
    font-size: 1.4cqw;
  }
  /* Onde o navegador suporta, os cantos viram superelipse, como no daisyUI. */
  @supports (corner-shape: superellipse(1.45)) {
    .hs-front,
    .hs-back,
    .hs-rim i {
      corner-shape: superellipse(1.45);
      border-radius: calc(var(--pw) * 0.195);
    }
    .hs-screen {
      corner-shape: superellipse(1.87);
      border-radius: calc(var(--pw) * 0.219);
    }
  }
  .hs-status {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.4em 1.6em 0;
    font-size: 0.75em;
    font-weight: 600;
  }
  .hs-island {
    width: 28%;
    height: calc(var(--pw) * 0.078);
    border-radius: 99px;
    background: #0b0b0c;
  }
  .hs-ps {
    position: absolute;
    inset: 4.2em 0 0;
    padding: 0.8em 1.2em 1.4em;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.6s var(--ease),
      opacity 0.4s;
  }
  .hs-ps-rec {
    transform: translateX(100%);
  }
  .hs.rec .hs-ps-today {
    transform: translateX(-30%);
    opacity: 0;
  }
  .hs.rec .hs-ps-rec {
    transform: none;
  }
  .hs-ph-title {
    font-size: 1.3em;
    font-weight: 700;
  }
  .hs-ph-title small {
    display: block;
    color: var(--muted);
    font-size: 0.62em;
    font-weight: 500;
  }
  .hs-today {
    flex: 1;
    min-height: 0;
    margin-top: 0.8em;
    overflow: hidden;
  }
  .hs-today-list {
    transition: transform 1s var(--ease);
  }
  .hs.scrolled .hs-today-list {
    transform: translateY(-4.4em);
  }
  .hs-appt {
    display: grid;
    grid-template-columns: 3.4em 1fr;
    padding: 0.75em 0.8em;
    margin-bottom: 0.5em;
    border: 1px solid var(--line);
    border-radius: 0.8em;
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.3s;
  }
  .hs-appt b {
    grid-row: span 2;
    color: var(--ink);
  }
  .hs-appt span {
    color: var(--muted);
    font-size: 0.75em;
  }
  .hs.picked .hs-appt-target {
    border-color: var(--ink);
    transform: scale(1.03);
  }
  .hs-tap {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 4cqw;
    height: 4cqw;
    margin: -2cqw;
    border-radius: 50%;
    background: rgb(12 32 47 / 0.25);
    opacity: 0;
    pointer-events: none;
  }
  .hs.tapping .hs-tap {
    animation: hs-tap 0.5s ease-out;
  }
  .hs-rec {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1em;
  }
  .hs-dot {
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
    background: #ef4444;
  }
  .hs-timer {
    font-size: 1.8em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .hs-wave {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.2em;
    margin-top: 0.6em;
  }
  .hs-wave i {
    width: 0.22em;
    height: var(--h);
    border-radius: 99px;
    background: var(--ink);
  }
  .hs-live {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5em;
    margin-top: 0.9em;
    color: var(--muted);
    line-height: 1.4;
  }
  .hs-ph-foot {
    display: grid;
    justify-items: center;
    gap: 0.5em;
  }
  .hs-stop {
    display: grid;
    place-items: center;
    width: 3.4em;
    height: 3.4em;
    border: 0.25em solid #fff;
    box-shadow: 0 0 0 1px #fecaca;
    border-radius: 50%;
    background: #ef4444;
  }
  .hs-stop i {
    width: 1em;
    height: 1em;
    border-radius: 0.2em;
    background: #fff;
  }
  .hs-sent {
    grid-area: 2 / 1;
    color: var(--ink);
    font-size: 0.78em;
    font-weight: 600;
    text-align: center;
  }
  .hs.ready .hs-sent:not(.hs-ready) {
    visibility: hidden;
  }

  /* ================= Passos ================= */
  .hs-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }
  .hs-step {
    position: relative;
    overflow: hidden;
    padding: 0.4rem 0.8rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 600;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .hs-step.on {
    border-color: #356588;
    color: #356588;
  }
  .hs-step.on::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: #356588;
    transform-origin: left;
    animation: hs-progress var(--dur, 5s) linear both;
  }

  /* ================= Aparecer na hora certa ================= */
  [data-at]:not(.hs-type):not(.hs-chip) {
    opacity: 0;
    translate: 0 0.8cqw;
    transition:
      opacity 0.35s,
      translate 0.35s;
  }
  [data-at].on:not(.hs-type):not(.hs-chip) {
    opacity: 1;
    translate: 0 0;
  }
  .hs-new[data-at] {
    translate: 0 -8cqw;
    transition:
      opacity 0.3s,
      translate 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .hs-press.pressed {
    animation: hs-press 0.4s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hs.rec:not(.stopped) .hs-wave i {
      animation: hs-wave 0.9s ease-in-out infinite alternate;
      animation-delay: calc(var(--i) * -0.13s);
    }
    .hs.rec:not(.stopped) .hs-dot {
      animation: hs-blink 1s steps(2) infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs *,
    .hs-step.on::after {
      transition: none !important;
      animation: none !important;
    }
  }

  @keyframes hs-scene-in {
    from {
      opacity: 0;
      transform: translateY(1.5cqw);
    }
  }
  @keyframes hs-spin {
    from {
      transform: translateX(-50%) rotateY(0deg);
    }
    to {
      transform: translateX(-50%) rotateY(360deg);
    }
  }
  @keyframes hs-tap {
    from {
      opacity: 1;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(2.4);
    }
  }
  @keyframes hs-press {
    50% {
      transform: scale(0.92);
    }
  }
  @keyframes hs-wave {
    from {
      transform: scaleY(0.3);
    }
  }
  @keyframes hs-blink {
    50% {
      opacity: 0.2;
    }
  }
  @keyframes hs-rot {
    to {
      rotate: 1turn;
    }
  }
  @keyframes hs-bounce {
    50% {
      transform: translateY(-0.6cqw);
    }
  }
  @keyframes hs-progress {
    from {
      transform: scaleX(0);
    }
  }
</style>

<script>
  // Um relógio só: cena, zoom, estados do celular, itens com data-at e os passos.
  const root = document.querySelector<HTMLElement>('[data-hs]');
  if (root) {
    const LOOP = Number(root.dataset.loop);
    const LEAVE = Number(root.dataset.leave);
    const steps = Array.from(document.querySelectorAll<HTMLButtonElement>('.hs-step'));
    const SCENES = steps.map((s) => ({ id: s.dataset.step!, start: Number(s.dataset.start), end: Number(s.dataset.end) }));
    // Janela de zoom de cada cena: entra depois do começo e sai antes do fim.
    const ZOOM: Record<string, [number, number]> = {
      cad: [400, 3000],
      agenda: [4600, 7700],
      whats: [9000, 12300],
      pront: [21200, 23900],
    };
    // Estados do celular e da página, cada um ligado entre [de, até).
    const STATES: [string, number, number][] = [
      ['scrolled', 14200, LOOP],
      ['picked', 15000, LOOP],
      ['tapping', 15300, 15800],
      ['rec', 15600, LOOP],
      ['stopped', 18800, LOOP],
      ['spin', 19200, 20300],
      ['done', 21000, LOOP],
      ['ready', 21000, LOOP],
      ['leaving', LEAVE, LOOP],
    ];
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-at]')).map((el) => ({
      el,
      at: Number(el.dataset.at),
      until: Number(el.dataset.until || LOOP),
    }));
    const typing = root.querySelector<HTMLElement>('.hs-typing');
    const timer = root.querySelector<HTMLElement>('[data-timer]');
    const presses = Array.from(root.querySelectorAll<HTMLElement>('.hs-press'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let t = 0;
    let last = performance.now();
    let running = false;
    let frame = 0;
    let inView = false;

    const render = () => {
      const scene = [...SCENES].reverse().find((s) => t >= s.start)!;
      const sceneId = scene.id;
      if (root.dataset.scene !== sceneId) {
        root.dataset.scene = sceneId;
      }
      steps.forEach((s, i) => {
        const on = SCENES[i].id === scene.id;
        if (s.classList.contains('on') !== on) {
          s.classList.toggle('on', on);
          s.setAttribute('aria-selected', String(on));
          s.style.setProperty('--dur', `${SCENES[i].end - SCENES[i].start}ms`);
        }
      });
      const z = ZOOM[scene.id];
      root.toggleAttribute('data-zoom', !!z && t >= z[0] && t < z[1]);
      STATES.forEach(([cls, from, to]) => root.classList.toggle(cls, t >= from && t < to));
      items.forEach(({ el, at, until }) => el.classList.toggle('on', t >= at && t < until));
      typing?.classList.toggle('gone', t >= 10800);
      presses.forEach((p) => {
        const at = Number(p.dataset.press);
        p.classList.toggle('pressed', t >= at && t < at + 400);
      });
      if (timer) {
        const s = Math.max(0, Math.floor((Math.min(t, 18800) - 15600) / 1000)) + 42 * 60 + 10;
        timer.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
      }
    };

    const tick = (now: number) => {
      // O timestamp do rAF pode ser anterior ao performance.now() de quem chamou: nunca anda para trás.
      t = (t + Math.min(Math.max(now - last, 0), 100)) % LOOP;
      last = now;
      render();
      frame = requestAnimationFrame(tick);
    };
    const play = () => {
      if (running || reduce || !inView || document.hidden) return;
      running = true;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };
    const pause = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    steps.forEach((s, i) =>
      s.addEventListener('click', () => {
        t = reduce ? SCENES[i].end - 1 : SCENES[i].start + 1;
        render();
      })
    );

    t = reduce ? LOOP - 1500 : 0;
    render();
    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      inView ? play() : pause();
    }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
  }
</script>
