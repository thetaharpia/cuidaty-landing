---
// Integrações: a Cuidaty no centro (logo), ligada às ferramentas do dia a dia.
// Convênios ficam na seção própria (Convenios.astro).
// Animação: logo respira, ondas saem do centro, linhas se desenham, selos entram.
const tiles = [
  { name: 'WhatsApp', icon: '/integracoes/whatsapp.svg', x: 27, y: 24 },
  { name: 'Google Agenda', icon: '/integracoes/google-agenda.svg', x: 73, y: 76 },
];
const uses = [
  {
    name: 'WhatsApp',
    icon: '/integracoes/whatsapp.svg',
    text: 'Confirmação, lembrete e conversa com o paciente saem da Cuidaty, sem copiar e colar. Menos falta, nenhuma mensagem esquecida.',
  },
  {
    name: 'Google Agenda',
    icon: '/integracoes/google-agenda.svg',
    text: 'Sessões sincronizadas com o Google Agenda. Compromisso pessoal e atendimento no mesmo lugar, sem horário duplicado.',
  },
];
---

<section id="integracoes" class="bg-white py-20 md:py-28">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <h2 class="text-balance text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl">
          Conecta com o que você já usa.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
          O paciente continua no WhatsApp. Sua agenda continua no Google. A Cuidaty liga tudo.
        </p>
      </div>

      <div class="mt-12 grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
        <div
          class="relative mx-auto aspect-[1/1] w-full max-w-xl sm:aspect-[9/6]"
          data-demo
          role="img"
          aria-label="A Cuidaty no centro, conectada ao WhatsApp e ao Google Agenda"
        >
          <svg
            class="absolute inset-0 size-full"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            {
              tiles.map((t, i) => (
                <line
                  class="hub-line"
                  x1={t.x}
                  y1={t.y}
                  x2="50"
                  y2="50"
                  pathLength="1"
                  style={`--d:${0.6 + i * 0.25}s`}
                />
              ))
            }
          </svg>

          <span class="hub-ring" style="--r:0"></span>
          <span class="hub-ring" style="--r:1"></span>

          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <div
              class="hub-core grid size-[8.25rem] place-items-center rounded-full border border-border bg-white shadow-soft"
            >
              <img
                src="/logo-mark.png"
                alt=""
                width="62"
                height="81"
                loading="lazy"
                class="h-[5rem] w-auto"
              />
            </div>
          </div>

          <ul>
            {
              tiles.map((t, i) => (
                <li
                  class="absolute w-max -translate-x-1/2 -translate-y-1/2"
                  style={`left:${t.x}%;top:${t.y}%`}
                >
                  <div
                    class="a a-pop flex items-center gap-2.5 rounded-2xl border border-border bg-white px-3.5 py-2.5 shadow-soft sm:px-5 sm:py-3"
                    style={`--d:${1.2 + i * 0.25}s`}
                  >
                    <img
                      src={t.icon}
                      alt=""
                      width="28"
                      height="28"
                      loading="lazy"
                      class="size-6 sm:size-7"
                    />
                    <span class="whitespace-nowrap text-xs font-semibold text-cuidaty-dark sm:text-sm">
                      {t.name}
                    </span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <ul class="divide-y divide-border border-y border-border">
          {
            uses.map((u) => (
              <li class="flex gap-4 py-6">
                <img
                  src={u.icon}
                  alt=""
                  width="28"
                  height="28"
                  loading="lazy"
                  class="mt-0.5 size-7 shrink-0"
                />
                <div>
                  <h3 class="font-sans text-lg font-semibold text-cuidaty-dark">{u.name}</h3>
                  <p class="mt-1.5 leading-relaxed text-cuidaty-dark/70">{u.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
