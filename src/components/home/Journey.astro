---
// Antes, durante e depois da sessão: três blocos, cada um com uma demo animada do produto.
// Âncora #funcionalidades.
const antes = [
  'Recorrências automáticas e detecção de conflitos',
  'Confirmação 24h antes, direto no WhatsApp do paciente',
  'Portal de agendamento online e portal do paciente',
];
const durante = [
  'Transcrição e resumo em SOAP ou outros formatos',
  'Cuty AI responde dúvidas sobre o paciente, citando a fonte',
  'Prontuário eletrônico completo, com acesso por perfil',
];
const depois = [
  'Contrato preenchido com os dados do prontuário, assinado pelo celular',
  'Financeiro completo: caixa, faturas e checkout',
  'Guias Geap e SulAmérica conferidas, com a glosa mapeada',
  'Metas de receita geradas a partir do seu financeiro real',
];
const financeiro = [
  ['Contrato', 'Psicoterapia individual', 'Enviado', 'Assinado'],
  ['Fatura', 'Maria Souza · junho', 'Aberta', 'Paga'],
  ['Guia Geap', 'Sessão de 10/06', 'Em análise', 'Conferida'],
  ['Glosa', 'Convênio SulAmérica', 'Pendente', 'Resolvida'],
];
---

<section id="funcionalidades" class="bg-white py-20 md:py-28">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <h2 class="text-balance text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl">
          Antes, durante e depois da sessão.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
          Cada etapa do seu dia no mesmo sistema, sem planilha, sem aba aberta, sem copiar e colar.
        </p>
      </div>

      <!-- ANTES -->
      <article class="mt-14 grid items-center gap-10 rounded-3xl border border-border bg-white p-6 shadow-lifted sm:p-8 lg:sticky lg:grid-cols-2 lg:gap-16 lg:p-12 lg:top-28">
        <div>
          <p class="kicker">Antes da sessão</p>
          <h3 class="mt-4 text-balance text-3xl leading-tight text-cuidaty-dark md:text-4xl">
            A agenda se confirma sozinha.
          </h3>
          <p class="mt-4 leading-relaxed text-cuidaty-dark/70">
            Marque com recorrência, evite conflitos de horário e deixe o lembrete e a confirmação no
            WhatsApp por conta da Cuidaty. Resultado dos clientes: −60% de no-show.
          </p>
          <ul class="mt-6 space-y-2 text-[0.95rem] text-cuidaty-dark/80">
            {antes.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="mock-window" data-demo aria-label="Demonstração: confirmação de consulta pelo WhatsApp">
          <div class="mock-bar"><span>WhatsApp · Cuidaty → Maria Souza</span></div>
          <div class="space-y-4 p-6">
            <div class="a bubble-in" style="--d:.4s">
              Oi, Maria! Sua consulta com a Dra. Ana é amanhã às 14h. Você confirma?
            </div>
            <div class="relative h-11">
              <div class="typing a-typing absolute right-0 top-0" style="--d:1.2s">
                <i></i><i></i><i></i>
              </div>
              <div class="bubble-out a a-pop absolute right-0 top-0" style="--d:2.2s">Confirmo</div>
            </div>
            <div class="mock-row a a-flash" style="--d:2.8s">
              <span><span class="lbl">Qui 14h</span><span class="nm">Maria Souza</span></span>
              <span class="st">
                <span class="st-a a-out" style="--d:3.6s">Pendente</span>
                <span class="st-b a" style="--d:3.7s">Confirmado</span>
              </span>
            </div>
            <p class="a flex items-baseline gap-3" style="--d:4.6s">
              <span class="font-serif text-2xl font-extrabold text-primary-ink">−60%</span>
              <span class="text-sm text-cuidaty-dark/70">de no-show nos clientes da Cuidaty</span>
            </p>
          </div>
        </div>
      </article>

      <!-- DURANTE -->
      <article class="mt-6 grid items-center gap-10 rounded-3xl border border-border bg-white p-6 shadow-lifted sm:p-8 lg:sticky lg:grid-cols-2 lg:gap-16 lg:p-12 lg:top-[8.5rem]">
        <div class="mock-window lg:order-1" data-demo aria-label="Demonstração: pergunta ao Cuty AI sobre o paciente">
          <div class="mock-bar"><span>Cuidaty · Prontuário · João Lima</span></div>
          <div class="space-y-4 p-6">
            <div class="a flex items-center gap-3 rounded-xl border border-border px-4 py-3 text-sm" style="--d:.4s">
              <span class="text-[0.65rem] font-semibold uppercase tracking-wider text-primary-ink">Cuty AI</span>
              <span class="a-type block whitespace-nowrap" style="--d:.8s">
                O que combinamos na última sessão?
              </span>
            </div>
            <div class="a bubble-in" style="--d:2.6s">
              Vocês combinaram o treino de respiração e revisar o sono.
              <span class="mt-2 block text-xs font-medium text-primary-ink">
                Fonte: sessão de 12/06, trecho 3
              </span>
            </div>
            <p class="text-xs text-cuidaty-dark/50">Demonstração ilustrativa · Cuidaty</p>
          </div>
        </div>
        <div class="lg:order-2">
          <p class="kicker">Durante a sessão</p>
          <h3 class="mt-4 text-balance text-3xl leading-tight text-cuidaty-dark md:text-4xl">
            A sessão vira prontuário.
          </h3>
          <p class="mt-4 leading-relaxed text-cuidaty-dark/70">
            Grave a consulta, presencial ou por teleconsulta. A Cuidaty transcreve e entrega o resumo
            clínico estruturado. Você revisa e confirma, em vez de digitar.
          </p>
          <ul class="mt-6 space-y-2 text-[0.95rem] text-cuidaty-dark/80">
            {durante.map((t) => <li>{t}</li>)}
          </ul>
          <p class="mt-5 text-xs leading-relaxed text-cuidaty-dark/60">
            O áudio é descartado após o processamento. A IA auxilia, não substitui o seu julgamento
            clínico.
          </p>
        </div>
      </article>

      <!-- DEPOIS -->
      <article class="mt-6 grid items-center gap-10 rounded-3xl border border-border bg-white p-6 shadow-lifted sm:p-8 lg:sticky lg:grid-cols-2 lg:gap-16 lg:p-12 lg:top-[10rem]">
        <div>
          <p class="kicker">Depois da sessão</p>
          <h3 class="mt-4 text-balance text-3xl leading-tight text-cuidaty-dark md:text-4xl">
            Contrato, cobrança e convênio sem planilha.
          </h3>
          <p class="mt-4 leading-relaxed text-cuidaty-dark/70">
            Da assinatura do contrato à guia conferida, o que sobra do atendimento já está organizado
            e com o dinheiro à vista.
          </p>
          <ul class="mt-6 space-y-2 text-[0.95rem] text-cuidaty-dark/80">
            {depois.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="mock-window" data-demo aria-label="Demonstração: financeiro com contratos, faturas, guias e meta">
          <div class="mock-bar"><span>Cuidaty · Financeiro</span></div>
          <div class="p-6">
            {
              financeiro.map(([lbl, nm, from, to], i) => (
                <div class="mock-row a a-flash" style={`--d:${0.3 + i * 0.3}s;`}>
                  <span><span class="lbl">{lbl}</span><span class="nm">{nm}</span></span>
                  <span class="st">
                    <span class="st-a a-out" style={`--d:${2 + i * 0.7}s`}>{from}</span>
                    <span class="st-b a" style={`--d:${2.1 + i * 0.7}s`}>{to}</span>
                  </span>
                </div>
              ))
            }
            <div class="a mt-5" style="--d:5s">
              <div class="flex items-center justify-between text-sm font-semibold">
                <span>Meta de receita · R$ 12 mil/mês</span>
                <span class="a text-primary-ink" style="--d:6.2s">78%</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-cuidaty-gray">
                <div
                  class="a-fill h-full origin-left rounded-full bg-primary"
                  style="width:78%;--d:5.2s"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Espaço de rolagem: mantém a pilha completa fixa por um instante antes de soltar. -->
      <div class="hidden h-[32vh] lg:block" aria-hidden="true"></div>
    </div>
  </div>
</section>
