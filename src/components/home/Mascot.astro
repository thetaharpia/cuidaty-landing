<style>
  .mascot {
    --rx: 0deg;
    --tx: 0px;
    --ty: 0px;
    position: relative;
    display: inline-block;
    width: 7rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .mascot svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .m-head {
    transform-box: fill-box;
    transform-origin: 45% 100%;
    transform: translate(var(--tx), var(--ty)) rotate(var(--rx));
  }
  .m-leaf,
  .m-cloud,
  .m-stem {
    transform-box: fill-box;
  }
  /* Cada folha gira em volta de onde encosta no caule. */
  .m-leaf-l {
    transform-origin: 100% 100%;
  }
  .m-leaf-r {
    transform-origin: 0% 100%;
  }
  .m-leaf-b {
    transform-origin: 100% 100%;
  }
  .m-cloud {
    transform-origin: 50% 100%;
  }
  .m-burst {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .m-burst svg {
    position: absolute;
    left: 40%;
    top: 55%;
    width: 14%;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .m-head {
      transition: transform 0.12s linear;
    }
    .mascot:not(.is-in) .m-stem {
      clip-path: inset(100% 0 0 0);
    }
    .mascot:not(.is-in) .m-leaf,
    .mascot:not(.is-in) .m-cloud {
      transform: scale(0);
    }
    .mascot.is-in .m-stem {
      animation: m-grow 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .mascot.is-in .m-leaf {
      animation:
        m-sprout 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both,
        m-gust 4.8s ease-in-out infinite;
    }
    .mascot.is-in .m-leaf-b {
      animation-delay: 0.5s, 1.1s;
    }
    .mascot.is-in .m-leaf-r {
      animation-delay: 0.7s, 2.4s;
    }
    .mascot.is-in .m-leaf-l {
      animation-delay: 0.9s, 3.3s;
    }
    .mascot.is-in .m-cloud {
      animation:
        m-sprout 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s both,
        m-float 2.6s ease-in-out 1.7s infinite alternate;
    }
    /* Clique: a cabeça dá uma chacoalhada (propriedade scale, separada do transform do cursor). */
    .mascot.poke .m-head {
      animation: m-jiggle 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .mascot.poke .m-burst svg {
      animation: m-fly 1.1s ease-out forwards;
    }
    .mascot.poke .m-burst svg:nth-child(2) {
      --dx: -150%;
      animation-delay: 0.08s;
    }
    .mascot.poke .m-burst svg:nth-child(3) {
      --dx: 140%;
      animation-delay: 0.16s;
    }
  }

  @keyframes m-grow {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes m-sprout {
    from {
      transform: scale(0);
    }
  }
  /* Rajada: balança pouco, dá um tranco e volta, como vento de verdade. */
  @keyframes m-gust {
    0%,
    100% {
      rotate: 0deg;
    }
    22% {
      rotate: -6deg;
    }
    36% {
      rotate: 11deg;
    }
    46% {
      rotate: -4deg;
    }
    60% {
      rotate: 5deg;
    }
  }
  @keyframes m-float {
    to {
      translate: 0 -12px;
    }
  }
  @keyframes m-jiggle {
    30% {
      scale: 1.08 0.94;
    }
    60% {
      scale: 0.96 1.05;
    }
  }
  @keyframes m-fly {
    10% {
      opacity: 1;
    }
    to {
      opacity: 0;
      transform: translate(var(--dx, 0%), -320%) rotate(220deg);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mascot]').forEach((el) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.classList.add('is-in');
      return;
    }
    new IntersectionObserver(
      ([e], io) => {
        if (e.isIntersecting) {
          el.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.4 }
    ).observe(el);

    // Olha para o cursor: inclina e escorrega alguns pixels na direção dele.
    let raf = 0;
    window.addEventListener(
      'pointermove',
      (ev) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          const dx = (ev.clientX - (r.left + r.width / 2)) / window.innerWidth;
          const dy = (ev.clientY - (r.top + r.height / 2)) / window.innerHeight;
          el.style.setProperty('--rx', `${(dx * 14).toFixed(2)}deg`);
          el.style.setProperty('--tx', `${(dx * 24).toFixed(1)}px`);
          el.style.setProperty('--ty', `${(dy * 16).toFixed(1)}px`);
        });
      },
      { passive: true }
    );

    el.addEventListener('click', () => {
      el.classList.remove('poke');
      void el.offsetWidth; // reinicia a animação em cliques seguidos
      el.classList.add('poke');
    });
  });
</script>
