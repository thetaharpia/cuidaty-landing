---
// Mascote: a cabeça da logo (logo-mark.png vetorizado com potrace, peça por peça) viva na página.
// A cabeça acompanha o cursor, as folhas balançam presas ao caule e a nuvem flutua. Ao entrar na
// tela o caule cresce e as folhas brotam; clicar chacoalha a cabeça e solta folhinhas.
// Com movimento reduzido fica parado, igual à logo.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

