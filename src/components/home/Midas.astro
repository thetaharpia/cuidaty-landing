---
// Cuidaty + MIDAS no caminho de uma paciente (fictícia), do anúncio à fatura.
// Em vez de descrever cada etapa, mostra o que aparece na tela de quem trabalha.
// Ouro é MIDAS, teal/azul é Cuidaty. Fundo claro, como o site todo. A animação usa o [data-demo] do Motion.astro.
import { MIDAS_URL, whatsappUrl } from '../../lib/contact';

const WA_URL = whatsappUrl(
  'Olá! Quero entender como o MIDAS pode aumentar o faturamento da minha clínica.'
);

const stops = [
  {
    owner: 'MIDAS',
    stage: 'Anúncio',
    kind: 'ad',
    caption: 'Meta e Google, medidos pela venda.',
  },
  {
    owner: 'MIDAS',
    stage: 'Primeiro contato',
    kind: 'chat',
    caption: 'Roteiro de WhatsApp e telefone para a recepção.',
  },
  {
    owner: 'MIDAS',
    stage: 'Orçamento',
    kind: 'quote',
    caption: 'Todo orçamento tem dono e data de retorno.',
  },
  {
    owner: 'Cuidaty',
    stage: 'Agendamento',
    kind: 'slot',
    caption: 'Confirmação e lembrete saem sozinhos.',
  },
  {
    owner: 'Cuidaty',
    stage: 'Consulta',
    kind: 'record',
    caption: 'A IA escreve, você revisa e aprova.',
  },
  {
    owner: 'Cuidaty',
    stage: 'Financeiro',
    kind: 'invoice',
    caption: 'Fatura, caixa e guia de convênio.',
  },
] as const;

const delay = (i: number) => `${(0.25 + i * 0.3).toFixed(2)}s`;
---

<section
  id="midas"
  class="duo relative scroll-mt-24 overflow-hidden bg-[#fdf8ec] py-20 text-cuidaty-dark lg:py-8"
  aria-labelledby="midas-title"
>
  <!-- No desktop a seção cabe numa tela, como a das funcionalidades: em cima o pitch e a
       prova lado a lado, embaixo o caminho da paciente. -->
  <div class="container relative mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <header>
          <p class="text-sm font-semibold text-cuidaty-dark/60">
            <span class="text-[#8f5d0d]">MIDAS</span> + <span class="text-primary-ink">Cuidaty</span
            >
          </p>
          <h2
            id="midas-title"
            class="mt-3 text-balance text-4xl font-bold leading-[1.02] tracking-tight md:text-5xl lg:text-[2.75rem]"
          >
            Uma paciente, do anúncio à fatura paga.
          </h2>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-cuidaty-dark/70">
            Nas três primeiras etapas trabalha o MIDAS, nas três últimas, a Cuidaty. Cada um
            funciona sozinho. A Marina e os dados são fictícios.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href={WA_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-btn hero-btn--midas"
              data-ga-event="contact_click"
              data-ga-location="midas_whatsapp">Pedir diagnóstico no WhatsApp</a
            >
            <a
              href={MIDAS_URL}
              target="_blank"
              rel="noopener"
              class="font-semibold text-cuidaty-dark underline decoration-[#e9a93a] underline-offset-4"
              data-ga-event="midas_click"
              data-ga-location="midas_site">Ver o site do MIDAS</a
            >
          </div>
        </header>

        <!-- Prova do MIDAS: o número que a cliente disse, o que foi feito e a frase dela -->
        <figure
          class="rounded-2xl border border-cuidaty-dark/10 bg-white p-6 shadow-[0_24px_50px_-34px_rgb(12_32_47_/_0.45)]"
        >
          <div class="flex flex-wrap items-end gap-x-4 gap-y-1">
            <p class="font-serif text-5xl font-bold leading-none tracking-tight text-[#a8690b]">
              R$ 170 mil
            </p>
            <p class="pb-1 text-sm leading-snug text-cuidaty-dark/65">
              a mais no faturamento em um mês
            </p>
          </div>
          <p class="mt-3 text-sm leading-snug text-cuidaty-dark">
            <b class="font-semibold">O que o MIDAS fez:</b> automação no WhatsApp, Instagram e Facebook,
            e estratégia comercial.
          </p>
          <blockquote
            class="mt-3 border-t border-cuidaty-dark/10 pt-3 text-[0.95rem] leading-relaxed text-cuidaty-dark/85"
          >
            “Nós tivemos um valor de 170 mil reais a mais no nosso faturamento, por uma estratégia
            exclusiva que nós tivemos dentro do sistema.”
          </blockquote>
          <figcaption class="mt-3 flex items-center gap-3 text-sm text-cuidaty-dark/70">
            <img
              src="/testimonials/bruna-sal-clinic.webp"
              alt=""
              width="32"
              height="32"
              class="size-8 rounded-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span><b class="font-semibold text-cuidaty-dark">Bruna</b> · Sal Clinic, São Paulo</span
            >
          </figcaption>
        </figure>
      </div>

      <ol class="duo-track mt-12 lg:mt-10" data-demo>
        <li class="duo-line" aria-hidden="true"><i></i></li>
        {
          stops.map((s, i) => (
            <li
              class:list={[
                'duo-stop a',
                s.owner === 'MIDAS' ? 'duo-stop--midas' : 'duo-stop--cuidaty',
              ]}
              style={`--d:${delay(i)}`}
            >
              <p class="duo-owner">{i % 3 === 0 ? s.owner : ''}</p>
              <div class="duo-head">
                <span class="duo-dot" aria-hidden="true" />
                <h3>{s.stage}</h3>
              </div>

              <div class="duo-art">
                {s.kind === 'ad' && (
                  <>
                    <span class="duo-meta">Patrocinado</span>
                    <b>Avaliação psicológica com hora marcada</b>
                    <span class="duo-chip">Enviar mensagem</span>
                  </>
                )}
                {s.kind === 'chat' && (
                  <>
                    <span class="duo-bubble">Tem horário à noite?</span>
                    <span class="duo-bubble duo-bubble--out">Quinta, 19h?</span>
                    <span class="duo-meta">respondido em 4 min</span>
                  </>
                )}
                {s.kind === 'quote' && (
                  <>
                    <span class="duo-meta">Orçamento · Marina S.</span>
                    <b>Retorno quinta · resp. Ana</b>
                    <span class="duo-flip" style={`--d:${delay(i + 1.4)}`}>
                      <span class="duo-chip duo-flip-a">Em aberto</span>
                      <span class="duo-chip duo-chip--on duo-flip-b">Fechado</span>
                    </span>
                  </>
                )}
                {s.kind === 'slot' && (
                  <>
                    <span class="duo-meta">Agenda · quinta</span>
                    <b>19h · Marina S.</b>
                    <span class="duo-chip duo-chip--on">✓ Confirmado no WhatsApp</span>
                  </>
                )}
                {s.kind === 'record' && (
                  <>
                    <span class="duo-meta">Prontuário · resumo SOAP</span>
                    <span class="duo-lines">
                      <i />
                      <i />
                      <i />
                    </span>
                    <span class="duo-chip">Aguardando sua revisão</span>
                  </>
                )}
                {s.kind === 'invoice' && (
                  <>
                    <span class="duo-meta">Fatura · Marina S.</span>
                    <b>Sessão de avaliação</b>
                    <span class="duo-chip duo-chip--on">Paga</span>
                  </>
                )}
              </div>
              <p class="duo-cap">{s.caption}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .duo {
    --gold: #e9a93a;
    --teal: #4fb3a1;
  }
  .duo::before {
    content: '';
    position: absolute;
    inset: auto auto -30% -10%;
    width: 60rem;
    height: 40rem;
    max-width: 120vw;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(240 185 85 / 0.28), transparent);
    filter: blur(50px);
    pointer-events: none;
  }
  .duo::after {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 50rem;
    height: 34rem;
    max-width: 110vw;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(90 195 176 / 0.18), transparent);
    filter: blur(50px);
    pointer-events: none;
  }

  /* Celular: linha vertical à esquerda. A partir de 1024px: seis colunas e linha horizontal. */
  .duo-track {
    position: relative;
    display: grid;
    gap: 2.25rem;
    padding-left: 2.6rem;
    list-style: none;
  }
  .duo-line {
    position: absolute;
    top: 0.4rem;
    bottom: 0;
    left: 8px;
    width: 3px;
    border-radius: 3px;
    background: rgb(12 32 47 / 0.08);
  }
  .duo-line i {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, var(--gold) 0 46%, var(--teal) 54% 100%);
    box-shadow: 0 0 14px rgb(240 185 85 / 0.35);
    transform-origin: top left;
  }
  .duo-stop {
    --tone: var(--gold);
    --ink: #8f5d0d;
    min-width: 0;
  }
  .duo-stop--cuidaty {
    --tone: var(--teal);
    --ink: #2d6389;
  }
  .duo-owner {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .duo-owner:empty {
    display: none;
  }
  .duo-head {
    position: relative;
    margin-top: 0.2rem;
  }
  .duo-head h3 {
    font-family: 'Geist Variable', 'Geist', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: #0c202f;
  }
  .duo-dot {
    position: absolute;
    top: 0.15rem;
    left: -2.6rem;
    width: 19px;
    height: 19px;
    border: 3px solid var(--tone);
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 5px #fdf8ec,
      0 0 14px var(--tone);
  }
  .duo-art {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    margin-top: 0.8rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid rgb(12 32 47 / 0.1);
    border-radius: 0.8rem;
    background: #fff;
    box-shadow: 0 10px 30px -22px rgb(12 32 47 / 0.35);
    font-size: 0.82rem;
    line-height: 1.35;
    color: #0c202f;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .duo-stop:hover .duo-art {
    border-color: var(--tone);
    box-shadow: 0 18px 36px -22px var(--tone);
    transform: translateY(-3px);
  }
  .duo-art b {
    font-weight: 600;
    color: #0c202f;
  }
  .duo-meta {
    font-size: 0.7rem;
    color: rgb(12 32 47 / 0.55);
  }
  .duo-chip {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border: 1px solid rgb(12 32 47 / 0.18);
    border-radius: 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgb(12 32 47 / 0.75);
    max-width: 100%;
  }
  .duo-chip--on {
    border-color: var(--tone);
    background: color-mix(in srgb, var(--tone) 16%, white);
    color: var(--ink);
  }
  .duo-bubble {
    max-width: 100%;
    padding: 0.35rem 0.6rem;
    border-radius: 0.7rem 0.7rem 0.7rem 0.15rem;
    background: #f1efe9;
    color: #0c202f;
  }
  .duo-bubble--out {
    justify-self: end;
    border-radius: 0.7rem 0.7rem 0.15rem 0.7rem;
    background: color-mix(in srgb, var(--tone) 24%, white);
  }
  .duo-lines {
    display: grid;
    gap: 0.3rem;
    width: 100%;
  }
  .duo-lines i {
    height: 0.4rem;
    border-radius: 999px;
    background: rgb(12 32 47 / 0.12);
  }
  .duo-lines i:nth-child(2) {
    width: 82%;
  }
  .duo-lines i:nth-child(3) {
    width: 58%;
  }
  /* Orçamento: começa em aberto e fecha. Sem movimento, mostra só o fechado. */
  .duo-flip {
    display: inline-grid;
  }
  .duo-flip > * {
    grid-area: 1 / 1;
    justify-self: start;
  }
  .duo-flip-a {
    opacity: 0;
  }
  .duo-cap {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgb(12 32 47 / 0.65);
  }

  @media (min-width: 1024px) {
    .duo-track {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.1rem;
      padding-left: 0;
    }
    .duo-line {
      top: calc(1.5rem + 8px);
      right: 0;
      bottom: auto;
      left: 0;
      width: auto;
      height: 3px;
    }
    .duo-line i {
      background: linear-gradient(90deg, var(--gold) 0 46%, var(--teal) 54% 100%);
    }
    .duo-owner,
    .duo-owner:empty {
      display: block;
      height: 1.5rem;
    }
    .duo-head {
      margin-top: 0;
    }
    .duo-cap {
      display: none;
    }
    .duo-dot {
      position: relative;
      top: auto;
      left: auto;
      display: block;
      margin-bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .reveal-ready [data-demo]:not(.is-playing) .duo-line i {
      transform: scale(0);
    }
    .reveal-ready [data-demo].is-playing .duo-line i {
      animation: duo-draw 2.1s cubic-bezier(0.4, 0, 0.2, 1) 0.15s both;
    }
    .reveal-ready [data-demo].is-playing .duo-flip-a {
      animation: duo-flip-a 0.4s ease both;
      animation-delay: var(--d, 0s);
    }
    .reveal-ready [data-demo].is-playing .duo-flip-b {
      animation: duo-flip-b 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes duo-draw {
    from {
      transform: scale(0);
    }
  }
  @keyframes duo-flip-a {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes duo-flip-b {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
  }
</style>
