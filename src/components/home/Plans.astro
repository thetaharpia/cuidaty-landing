---
import { plans } from '../../lib/plans';
---

<section id="planos" class="bg-cuidaty-light py-20 md:py-28">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <h2 class="text-balance text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl">
          Comece grátis. Evolua no seu ritmo.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
          Plano gratuito permanente para até 10 pacientes. Nos planos pagos, 3 dias de teste grátis.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          plans.map((plan) => (
            <article
              id={plan.slug === 'clinicas' ? 'consultoria' : undefined}
              class:list={[
                'sp-rise relative grid grid-rows-subgrid row-span-6 gap-y-0 rounded-2xl bg-white p-6',
                plan.recommended
                  ? 'border-2 border-primary shadow-lifted'
                  : 'border border-border',
              ]}
            >
              {plan.recommended && (
                <span class="absolute -top-3 left-6 rounded-full bg-primary-ink px-3 py-1 text-xs font-semibold text-white">
                  Recomendado
                </span>
              )}
              <h3 class="text-2xl text-cuidaty-dark">{plan.name}</h3>
              <p class="mt-2 text-sm font-semibold text-primary-ink">{plan.subtitle}</p>
              <p class="mt-2 text-sm leading-relaxed text-cuidaty-dark/70">{plan.tagline}</p>

              <p class="mt-5 flex items-baseline gap-1">
                <span
                  class:list={[
                    'font-serif font-extrabold leading-none text-cuidaty-dark',
                    plan.cycle ? 'text-4xl' : 'text-3xl',
                  ]}
                >
                  {plan.price}
                </span>
                {plan.cycle && <span class="text-sm text-cuidaty-dark/60">{plan.cycle}</span>}
              </p>

              <ul class="check-list mb-7 mt-6 space-y-3 text-sm leading-relaxed">
                {plan.inherits && <li class="no-check font-semibold">{plan.inherits}</li>}
                {plan.features.map((f) => <li>{f}</li>)}
                {plan.exclusions?.map((f) => <li class="no-check text-cuidaty-dark/50">{f}</li>)}
                {plan.featuresNote && <li class="no-check font-semibold">{plan.featuresNote}</li>}
              </ul>

              <a
                href={plan.cta.href}
                target={plan.cta.href.startsWith('http') ? '_blank' : undefined}
                rel={plan.cta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class:list={['mt-auto w-full', plan.recommended ? 'btn-solid' : 'btn-line']}
                data-cta-location="plans"
                data-plan={plan.slug}
                data-event={plan.cta.event}
              >
                {plan.cta.label}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
