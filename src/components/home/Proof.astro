---
// Prova social: números e depoimentos, juntos. Texto dos depoimentos igual ao da seção anterior.
// Números com a data. Fonte: base de produção em 10/10/2026. As horas de áudio passam de 1.000
// somando o histórico que se perdeu antes da base atual (ela sozinha tem 102h). Uso do chat fica de
// fora: volume baixo e caindo. Profissionais e pacientes: base local, sem as contas de teste.
const stats = [
  { value: '+80', label: 'profissionais usando a Cuidaty' },
  { value: '+1.000', label: 'pacientes acompanhados' },
  { value: '+1.000h', label: 'de áudio clínico transcrito e organizado' },
  { value: '750+', label: 'registros clínicos que cada profissional pesquisa com o Cuty AI, só nos próprios pacientes' },
];
const statsUpdatedAt = '10/10/2026';
const testimonials = [
  {
    quote:
      'A Cuidaty trouxe leveza à minha rotina. Antes era um caos responder mensagens no WhatsApp entre sessões.',
    photo: '/testimonials/huini.webp',
    name: 'Huini Coelho',
    role: 'Psicóloga e Gestalt-Terapeuta · CRP AP 10/06891',
  },
  {
    quote:
      'Tenho tudo em um só lugar, da evolução dos prontuários à comunicação com os pacientes. Com a I.A, as evoluções e o resumo do histórico clínico ficaram ainda melhores, e ainda crio e envio instrumentos clínicos direto pela plataforma.',
    photo: '/testimonials/fernanda.webp',
    name: 'Fernanda Mancilha',
    role: 'Psicóloga · CRP MG 04/78540',
  },
  {
    quote:
      'A Cuidaty trouxe organização para a gestão da nossa clínica, assertividade e agilidade.',
    photo: '/testimonials/giovana.webp',
    name: 'Giovana Ferreira',
    role: 'Gestora de atividades clínicas, Startuppsi · CRP RJ 05/86762',
  },
];
const clinics = [
  {
    img: '/clinics/startuppsi.svg',
    name: 'StartupPsi',
    desc: 'Parceiro oficial na transformação digital da psicologia brasileira.',
    href: 'https://startuppsi.com.br/',
    round: false,
  },
  {
    img: '/clinics/pro-implante.jpg',
    name: 'Pro-Implante',
    desc: 'Confia na automação de atendimentos com a Cuidaty.',
    href: null,
    round: true,
  },
  {
    img: '/clinics/ressignificar-clin.webp',
    name: 'Ressignificar Clin',
    desc: 'Psicologia integrada, com a rotina da clínica na Cuidaty.',
    href: 'https://www.instagram.com/ressignificarclin/',
    round: false,
  },
];
---

<section id="depoimentos" class="bg-white py-20 md:py-28">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <h2 class="text-balance text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl">
          Você pode cuidar de tudo sozinho, mas não precisa.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
          Quem usa, o quanto usa e o que já passou pela Cuidaty.
        </p>
      </div>

      <dl class="mt-12 grid gap-8 border-y border-border py-10 grid-cols-2 lg:grid-cols-4">
        {
          stats.map((st) => (
            <div>
              <dt class="font-serif text-4xl font-bold leading-none text-cuidaty-dark md:text-5xl">
                {st.value}
              </dt>
              <dd class="mt-3 max-w-[16rem] text-sm text-cuidaty-dark/70">{st.label}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-xs text-cuidaty-dark/70">Métricas atualizadas em {statsUpdatedAt}.</p>

      <!-- Depoimentos: um por vez, a citação entra palavra por palavra e a foto de quem fala acende. -->
      <div class="tst mx-auto mt-16 max-w-3xl text-center" data-tst>
        <div class="tst-quotes">
          {
            testimonials.map((t, i) => (
              <figure class:list={['tst-q', i === 0 && 'on']} aria-hidden={i === 0 ? undefined : 'true'}>
                <blockquote class="text-balance font-serif text-2xl font-semibold leading-snug text-cuidaty-dark md:text-[2rem]">
                  “{t.quote.split(' ').map((w, n, all) => <span style={`--i:${n}`}>{n < all.length - 1 ? `${w} ` : w}</span>)}”
                </blockquote>
                <figcaption class="mt-6 text-sm text-cuidaty-dark/70">
                  <b class="font-semibold text-cuidaty-dark">{t.name}</b> · {t.role}
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="mt-8 flex justify-center gap-3" role="tablist" aria-label="Depoimentos">
          {
            testimonials.map((t, i) => (
              <button
                type="button"
                role="tab"
                class:list={['tst-av', i === 0 && 'on']}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`Depoimento de ${t.name}`}
                data-i={i}
              >
                <img src={t.photo} alt="" width="56" height="56" loading="lazy" decoding="async" />
              </button>
            ))
          }
        </div>
      </div>

      <!-- Clínicas que confiam na gente -->
      <div class="mt-20 border-t border-border pt-14">
        <h3 class="text-2xl text-cuidaty-dark md:text-3xl">Clínicas que confiam na gente</h3>
        <ul class="mt-10 grid gap-10 md:grid-cols-3">
          {
            clinics.map((c) => (
              <li class="flex items-start gap-5">
                <span class="grid h-16 w-28 shrink-0 place-items-center rounded-xl border border-border bg-white p-2">
                  <img
                    src={c.img}
                    alt={`Logo ${c.name}`}
                    width={c.round ? 48 : 96}
                    height={48}
                    loading="lazy"
                    decoding="async"
                    class={c.round ? 'size-12 rounded-full object-cover' : 'h-12 w-24 object-contain'}
                  />
                </span>
                <span>
                  {c.href ? (
                    <a
                      href={c.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-semibold text-cuidaty-dark underline-offset-4 hover:underline"
                    >
                      {c.name}
                    </a>
                  ) : (
                    <span class="font-semibold text-cuidaty-dark">{c.name}</span>
                  )}
                  <span class="mt-1 block text-sm leading-relaxed text-cuidaty-dark/70">
                    {c.desc}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .tst-quotes {
    display: grid;
  }
  .tst-q {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .tst-q.on {
    visibility: visible;
  }
  .tst-av {
    position: relative;
    padding: 0;
    border-radius: 0.75rem;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tst-av img {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.75rem;
    object-fit: cover;
    filter: grayscale(1);
    opacity: 0.55;
    transition: filter 0.4s, opacity 0.4s;
  }
  .tst-av:hover img,
  .tst-av.on img {
    filter: none;
    opacity: 1;
  }
  .tst-av.on {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 10px 24px -10px rgb(12 32 47 / 0.45);
  }
  /* Barra de tempo do depoimento atual. */
  .tst-av.on::after {
    content: '';
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: -10px;
    height: 2px;
    border-radius: 2px;
    background: #356588;
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tst-q.on blockquote span {
      display: inline-block;
      white-space: pre;
      animation: tst-word 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--i) * 28ms);
    }
    .tst-q.on figcaption {
      animation: tst-word 0.6s 0.3s both;
    }
    .tst.playing .tst-av.on::after {
      animation: tst-time var(--tst-dur, 7s) linear both;
    }
    .tst.paused .tst-av.on::after {
      animation-play-state: paused;
    }
  }
  @keyframes tst-word {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(0.4em);
    }
  }
  @keyframes tst-time {
    from {
      transform: scaleX(0);
    }
  }
</style>

<script>
  // Troca o depoimento a cada 7s enquanto a seção está na tela; pausa com o mouse ou o foco nela.
  const root = document.querySelector<HTMLElement>('[data-tst]');
  if (root) {
    const quotes = Array.from(root.querySelectorAll<HTMLElement>('.tst-q'));
    const avatars = Array.from(root.querySelectorAll<HTMLButtonElement>('.tst-av'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DUR = 7000;
    let index = 0;
    let timer = 0;
    let inView = false;
    let hold = false;

    const show = (i: number) => {
      index = (i + quotes.length) % quotes.length;
      quotes.forEach((q, n) => {
        q.classList.toggle('on', n === index);
        q.toggleAttribute('aria-hidden', n !== index);
      });
      avatars.forEach((a, n) => {
        a.classList.toggle('on', n === index);
        a.setAttribute('aria-selected', String(n === index));
      });
      schedule();
    };
    const schedule = () => {
      clearTimeout(timer);
      const playing = inView && !hold && !reduce;
      root.classList.toggle('playing', playing);
      if (playing) timer = window.setTimeout(() => show(index + 1), DUR);
    };

    avatars.forEach((a, n) => a.addEventListener('click', () => show(n)));
    root.addEventListener('pointerenter', () => ((hold = true), root.classList.add('paused'), clearTimeout(timer)));
    root.addEventListener('pointerleave', () => {
      hold = false;
      // Recomeça a barra junto com o relógio.
      root.classList.remove('paused', 'playing');
      void root.offsetWidth;
      schedule();
    });
    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      schedule();
    }).observe(root);
  }
</script>
