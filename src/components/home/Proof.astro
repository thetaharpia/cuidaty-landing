---
// Prova social: números e depoimentos, juntos. Texto dos depoimentos igual ao da seção anterior.
const stats = [
  { to: 98, pre: '', suf: '%', label: 'taxa média de resposta automática' },
  { to: 60, pre: '−', suf: '%', label: 'de redução no no-show das consultas' },
  { to: 30, pre: '', suf: 'min', label: 'tempo médio de resposta em dias úteis' },
];
const testimonials = [
  {
    quote:
      'A Cuidaty trouxe leveza à minha rotina. Antes era um caos responder mensagens no WhatsApp entre sessões.',
    photo: '/testimonials/huini.webp',
    name: 'Huini Coelho',
    role: 'Psicóloga e Gestalt-Terapeuta · CRP 10/06891',
  },
  {
    quote:
      'Tenho tudo em um só lugar, da evolução dos prontuários à comunicação com os pacientes. Com a I.A, as evoluções e o resumo do histórico clínico ficaram ainda melhores, e ainda crio e envio instrumentos clínicos direto pela plataforma.',
    photo: '/testimonials/fernanda.webp',
    name: 'Fernanda Mancilha',
    role: 'Psicóloga · CRP MG 04/78540',
  },
  {
    quote:
      'A Cuidaty trouxe organização para a gestão da nossa clínica, assertividade e agilidade.',
    photo: '/testimonials/giovana.webp',
    name: 'Giovana Ferreira',
    role: 'Gestora de atividades clínicas, Startuppsi · CRP 05/86762',
  },
];
const clinics = [
  {
    img: '/clinics/startuppsi.svg',
    name: 'StartupPsi',
    desc: 'Parceiro oficial na transformação digital da psicologia brasileira.',
    href: 'https://startuppsi.com.br/',
    round: false,
  },
  {
    img: '/clinics/pro-implante.jpg',
    name: 'Pro-Implante',
    desc: 'Confia na automação de atendimentos com a Cuidaty.',
    href: null,
    round: true,
  },
  {
    img: '/clinics/ressignificar-clin.webp',
    name: 'Ressignificar Clin',
    desc: 'Psicologia integrada, com a rotina da clínica na Cuidaty.',
    href: 'https://www.instagram.com/ressignificarclin/',
    round: false,
  },
];
const initials = (n: string) =>
  n
    .split(' ')
    .map((p) => p[0])
    .slice(0, 2)
    .join('');
---

<section id="depoimentos" class="bg-cuidaty-light py-20 md:py-28">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <h2 class="text-balance text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl">
          Você pode cuidar de tudo sozinho, mas não precisa.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
          Mais de 500 profissionais já confiam na Cuidaty.
        </p>
      </div>

      <dl class="mt-12 grid gap-8 border-y border-border py-10 sm:grid-cols-3">
        {
          stats.map((st) => (
            <div>
              <dt class="font-serif text-4xl font-bold leading-none text-cuidaty-dark md:text-5xl">
                {st.pre}{st.to}{st.suf}
              </dt>
              <dd class="mt-3 max-w-[16rem] text-sm text-cuidaty-dark/70">{st.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 grid gap-10 lg:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="sp-rise flex flex-col justify-between border-t-2 border-cuidaty-dark pt-6">
              <blockquote class="text-[1.02rem] leading-relaxed text-cuidaty-dark">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-6 flex items-center gap-3">
                {t.photo ? (
                  <img
                    src={t.photo}
                    alt={`Foto de ${t.name}`}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                    class="size-11 shrink-0 rounded-full object-cover"
                  />
                ) : (
                  <span class="grid size-11 shrink-0 place-items-center rounded-full bg-cuidaty-gray text-sm font-semibold text-cuidaty-dark">
                    {initials(t.name)}
                  </span>
                )}
                <span>
                  <span class="block text-sm font-semibold text-cuidaty-dark">{t.name}</span>
                  <span class="block text-xs text-cuidaty-dark/60">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <!-- Clínicas que confiam na gente -->
      <div class="mt-20 border-t border-border pt-14">
        <h3 class="text-2xl text-cuidaty-dark md:text-3xl">Clínicas que confiam na gente</h3>
        <ul class="mt-10 grid gap-10 md:grid-cols-3">
          {
            clinics.map((c) => (
              <li class="flex items-start gap-5">
                <span class="grid h-16 w-28 shrink-0 place-items-center rounded-xl border border-border bg-white p-2">
                  <img
                    src={c.img}
                    alt={`Logo ${c.name}`}
                    loading="lazy"
                    decoding="async"
                    class={c.round ? 'size-12 rounded-full object-cover' : 'h-12 w-24 object-contain'}
                  />
                </span>
                <span>
                  {c.href ? (
                    <a
                      href={c.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-semibold text-cuidaty-dark underline-offset-4 hover:underline"
                    >
                      {c.name}
                    </a>
                  ) : (
                    <span class="font-semibold text-cuidaty-dark">{c.name}</span>
                  )}
                  <span class="mt-1 block text-sm leading-relaxed text-cuidaty-dark/70">
                    {c.desc}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
