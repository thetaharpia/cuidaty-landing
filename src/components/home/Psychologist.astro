<style>
  .psy {
    --hr: 0deg;
    display: inline-block;
    width: 100%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .psy svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .psy-leaf,
  .psy-body,
  .psy-head {
    transform-box: view-box;
  }
  /* Pontos de giro em coordenadas do desenho: base de cada ramo e o pescoço. */
  .psy-leaf-l {
    transform-origin: 393px 682px;
  }
  .psy-leaf-r {
    transform-origin: 940px 1017px;
  }
  .psy-body {
    transform-origin: 607px 1536px;
  }
  .psy-head {
    transform-origin: 607px 269px;
    transform: rotate(var(--hr));
  }
  .psy-eyes {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .psy-head {
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .psy:not(.is-in) .psy-leaf {
      transform: scale(0);
    }
    .psy:not(.is-in) .psy-body {
      opacity: 0;
      transform: translateY(24px);
    }
    .psy.is-in .psy-body {
      animation:
        psy-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both,
        psy-breathe 4.2s ease-in-out 1s infinite;
    }
    .psy.is-in .psy-leaf {
      animation:
        psy-sprout 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both,
        psy-gust 5s ease-in-out infinite;
    }
    .psy.is-in .psy-leaf-l {
      animation-delay: 0.3s, 1.2s;
    }
    .psy.is-in .psy-leaf-r {
      animation-delay: 0.5s, 2.9s;
    }
    /* Clique: os ramos também se agitam. */
    .psy.nod .psy-leaf {
      animation:
        psy-sprout 0.9s both,
        psy-gust 5s ease-in-out infinite,
        psy-shake 0.7s ease-in-out;
    }
    .psy.is-in .psy-eyes {
      animation: psy-blink 4.5s 2s infinite;
    }
    .psy.nod .psy-head {
      animation: psy-nod 0.9s ease-in-out;
    }
  }

  @keyframes psy-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes psy-breathe {
    50% {
      scale: 1 1.012;
    }
  }
  @keyframes psy-sprout {
    from {
      transform: scale(0);
    }
  }
  /* Rajada: balança pouco, dá um tranco e volta. */
  @keyframes psy-gust {
    0%,
    100% {
      rotate: 0deg;
    }
    22% {
      rotate: -3deg;
    }
    36% {
      rotate: 7deg;
    }
    46% {
      rotate: -2deg;
    }
    60% {
      rotate: 3deg;
    }
  }
  @keyframes psy-shake {
    30% {
      scale: 1.06;
    }
    60% {
      scale: 0.97;
    }
  }
  @keyframes psy-blink {
    0%,
    94%,
    100% {
      scale: 1 1;
    }
    97% {
      scale: 1 0.1;
    }
  }
  @keyframes psy-nod {
    30% {
      rotate: 7deg;
    }
    60% {
      rotate: -3deg;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-psy]').forEach((el) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(
      ([e], io) => {
        if (e.isIntersecting) {
          el.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.35 }
    ).observe(el);

    // A cabeça inclina um pouco na direção do cursor.
    let raf = 0;
    window.addEventListener(
      'pointermove',
      (ev) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          const dx = (ev.clientX - (r.left + r.width * 0.56)) / window.innerWidth;
          el.style.setProperty('--hr', `${Math.max(-8, Math.min(8, dx * 18)).toFixed(2)}deg`);
        });
      },
      { passive: true }
    );

    el.addEventListener('click', () => {
      el.classList.remove('nod');
      void el.offsetWidth; // reinicia em cliques seguidos
      el.classList.add('nod');
    });
  });
</script>
