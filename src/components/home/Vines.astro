<style>
  .vn {
    position: absolute;
    z-index: 0;
    width: clamp(7rem, 16vw, 13rem);
    height: auto;
    overflow: visible;
    fill: #ddfdbe;
    pointer-events: none;
  }
  .vn-tr {
    top: 2rem;
    right: 0;
  }
  .vn-bl {
    bottom: 1rem;
    left: 0;
  }
  .vn-sway,
  .vn-leaf,
  .vn-stem {
    transform-box: fill-box;
  }
  /* O ramo de cima nasce embaixo; o de baixo, no pé direito. */
  .vn-tr .vn-sway {
    transform-origin: 70% 100%;
  }
  .vn-bl .vn-sway {
    transform-origin: 80% 100%;
  }
  .vn-leaf {
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vn:not(.is-in) .vn-stem {
      clip-path: inset(100% 0 0 0);
    }
    .vn:not(.is-in) .vn-leaf {
      transform: scale(0);
    }
    .vn.is-in .vn-stem {
      animation: vn-grow 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .vn.is-in .vn-sway {
      animation: vn-branch 7s ease-in-out 1.4s infinite alternate;
    }
    .vn.is-in .vn-leaf {
      animation:
        vn-sprout 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both,
        vn-gust 5.5s ease-in-out infinite;
      animation-delay: calc(0.5s + var(--n) * 0.18s), calc(1.5s + var(--n) * -1.3s);
    }
    .vn-bl.is-in .vn-leaf {
      animation-duration: 0.7s, 6.3s;
    }
  }

  @keyframes vn-grow {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes vn-sprout {
    from {
      transform: scale(0);
    }
  }
  @keyframes vn-branch {
    from {
      rotate: -2.5deg;
    }
    to {
      rotate: 2deg;
    }
  }
  /* Rajada: balança pouco, dá um tranco e volta, como vento de verdade. */
  @keyframes vn-gust {
    0%,
    100% {
      rotate: 0deg;
      scale: 1;
    }
    20% {
      rotate: -5deg;
    }
    34% {
      rotate: 9deg;
      scale: 1.05;
    }
    42% {
      rotate: -3deg;
    }
    55% {
      rotate: 4deg;
    }
    75% {
      rotate: -2deg;
    }
  }
</style>

<script>
  // Os ramos crescem quando entram na tela.
  document.querySelectorAll<SVGElement>('[data-vn]').forEach((el) => {
    new IntersectionObserver(
      ([e], io) => {
        if (e.isIntersecting) {
          el.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.2 }
    ).observe(el);
  });
</script>
