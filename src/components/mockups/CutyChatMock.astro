---
import AppFrame from './AppFrame.astro';
import Icon from './Icon.astro';

/**
 * Mockup: Cuty AI respondendo com base no prontuário, com citação de fonte.
 * Estado final da cena Chat do cuidaty-reels.
 */
interface Props {
  maxWidth?: number;
  class?: string;
}
const { maxWidth = 420, class: className = '' } = Astro.props;

const question = 'Faça um resumo do que mudou na consulta de hoje.';
const answerPre =
  'Na consulta de hoje, Breno relatou cefaleia recorrente vespertina, intensidade 7/10, associada a insônia há ~3 semanas';
const answerPost =
  '. Exame neurológico sem alterações. Conduta: higiene do sono e retorno em 30 dias.';
---

<AppFrame title="Cuidaty · Cuty AI" maxWidth={maxWidth} class={className}>
  <div class="flex h-full flex-col p-5">
    <!-- cabeçalho -->
    <div class="flex items-center gap-3 border-b border-border pb-4">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-cuidaty-primary/10 text-cuidaty-primary"
      >
        <Icon name="bot" size={20} />
      </span>
      <div class="min-w-0">
        <p class="text-base font-semibold leading-tight text-cuidaty-dark">Cuty IA</p>
        <p class="text-xs text-muted-foreground">Breno Prestes</p>
      </div>
      <div class="ml-auto flex gap-1 text-muted-foreground">
        <span class="flex h-8 w-8 items-center justify-center rounded-md"><Icon name="history" size={18} /></span>
        <span class="flex h-8 w-8 items-center justify-center rounded-md"><Icon name="pencil" size={18} /></span>
        <span class="flex h-8 w-8 items-center justify-center rounded-md"><Icon name="x" size={18} /></span>
      </div>
    </div>

    <!-- conversa -->
    <div class="flex flex-1 flex-col gap-4 py-6">
      <div
        class="max-w-[86%] self-end rounded-2xl bg-cuidaty-primary px-4 py-3 text-sm leading-relaxed text-white"
      >
        {question}
      </div>

      <div
        class="max-w-[90%] self-start rounded-2xl bg-muted px-4 py-3 text-sm leading-relaxed text-foreground"
      >
        {answerPre}
        <span
          class="mx-1 inline-flex h-5 min-w-5 items-center justify-center rounded bg-cuidaty-primary/12 px-1.5 align-text-top text-xs font-semibold text-cuidaty-primary"
          >1</span
        >{answerPost}
        <span
          class="mt-3 flex items-center gap-2 border-t border-cuidaty-dark/10 pt-3 text-xs text-muted-foreground"
        >
          <span
            class="flex h-5 w-5 flex-none items-center justify-center rounded bg-cuidaty-primary/12 text-[0.65rem] font-semibold text-cuidaty-primary"
            >1</span
          >
          Prontuário · Consulta 16/06/2026 — Queixa principal
        </span>
      </div>
    </div>

    <!-- composer -->
    <div class="mt-auto flex items-end gap-3 border-t border-border pt-4">
      <span
        class="flex flex-1 items-center rounded-md border border-border px-4 py-3 text-sm text-muted-foreground"
      >
        Escreva sua pergunta...
      </span>
      <span
        class="flex h-11 w-11 flex-none items-center justify-center rounded-md bg-cuidaty-primary text-white"
      >
        <Icon name="send" size={20} />
      </span>
    </div>
  </div>
</AppFrame>
