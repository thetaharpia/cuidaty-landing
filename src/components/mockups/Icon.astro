---
/**
 * Ícones de linha usados nos mockups das features de IA.
 * Portados de cuidaty-reels/src/icons.tsx (Lucide-style, stroke currentColor).
 */
interface Props {
  name:
    | 'mic'
    | 'square'
    | 'check'
    | 'chevron'
    | 'file-plus'
    | 'history'
    | 'pencil'
    | 'x'
    | 'send'
    | 'bot'
    | 'calendar'
    | 'plus'
    | 'clock'
    | 'search'
    | 'video'
    | 'upload'
    | 'whatsapp'
    | 'arrow-right'
    | 'globe'
    | 'alert';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  mic: '<rect x="9" y="2" width="6" height="12" rx="3" /><path d="M19 10v2a7 7 0 0 1-14 0v-2" /><path d="M12 19v3" />',
  square: '<rect x="6" y="6" width="12" height="12" rx="1" />',
  check: '<path d="M20 6 9 17l-5-5" />',
  chevron: '<path d="m9 18 6-6-6-6" />',
  'file-plus':
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6" /><path d="M12 18v-6" /><path d="M9 15h6" />',
  history: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l3 2" />',
  pencil: '<path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />',
  x: '<path d="M18 6 6 18" /><path d="M6 6l12 12" />',
  send: '<path d="M3 3 21 12 3 21l4-9Z" /><path d="M7 12h14" />',
  bot: '<rect x="3" y="11" width="18" height="10" rx="2" /><circle cx="12" cy="5" r="2" /><path d="M12 7v4" /><path d="M8 16h.01" /><path d="M16 16h.01" />',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" />',
  plus: '<path d="M12 5v14M5 12h14" />',
  clock: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />',
  search: '<circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />',
  video: '<path d="m22 8-6 4 6 4V8Z" /><rect x="2" y="6" width="14" height="12" rx="2" />',
  upload: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="M17 8l-5-5-5 5" /><path d="M12 3v12" />',
  whatsapp:
    '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6" />',
  globe:
    '<circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" />',
  alert:
    '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" />',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={paths[name]}
/>
