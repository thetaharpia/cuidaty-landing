---
import { getLatestPosts } from '../../lib/blog.server';
import BlogCard from '../BlogCard.astro';

const posts = await getLatestPosts(3);
---

<section id="blog" class="bg-white py-20 md:py-28">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-balance text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl">
            Notícias e reflexões da área da saúde
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
            Acompanhe o blog da Cuidaty, nossa casa de conteúdo sobre psicologia, gestão clínica e
            cuidado com quem cuida.
          </p>
        </div>
        <a href="/blog/" class="btn-line shrink-0 self-start md:self-auto">Ver todos os artigos</a>
      </div>

      {
        posts.length > 0 ? (
          <div class="stagger-cards mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogCard post={post} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <div class="mt-12 rounded-2xl border border-border bg-white p-10 text-center">
            <p class="mb-6 text-cuidaty-dark/70">Nenhum post encontrado no momento.</p>
            <a href="/blog/" class="font-semibold text-primary-ink underline underline-offset-4">
              Acessar o blog
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
