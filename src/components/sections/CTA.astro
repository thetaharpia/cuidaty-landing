---

---

<section id="contato" class="bg-white py-24 md:py-32">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto grid max-w-6xl gap-16 lg:grid-cols-[1.1fr_1fr] lg:items-start">
      <!-- Esquerda: chamada -->
      <div>
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
          Converse com a gente
        </p>

        <h2
          class="mb-8 font-serif text-4xl font-semibold leading-[1.05] tracking-tight text-cuidaty-dark md:text-5xl lg:text-6xl"
        >
          Fale direto<br />
          <span class="italic text-cuidaty-dark/70">com a gente.</span>
        </h2>

        <p class="max-w-xl text-lg leading-relaxed text-foreground/70">
          Tire suas dúvidas sobre o Cuidaty pelo canal que preferir. Atendimento humano, sem robô.
          Atendemos profissionais da saúde mental e clínicas multidisciplinares em todo o Brasil,
          com resposta média em até 4 horas em dias úteis.
        </p>
      </div>

      <!-- Direita: canais de contato -->
      <aside class="lg:border-l lg:border-border lg:pl-12">
        <p class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-foreground/50">
          Canais de contato
        </p>

        <ul class="space-y-6">
          <li>
            <a
              href="https://wa.me/5596984058103?text=Ol%C3%A1%21%20Tenho%20interesse%20em%20conhecer%20o%20Cuidaty."
              target="_blank"
              rel="noopener"
              class="group flex items-start gap-4 text-foreground/80 transition-colors hover:text-foreground"
            >
              <svg
                class="mt-1 h-5 w-5 flex-shrink-0 text-cuidaty-primary"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
                ></path>
              </svg>
              <span>
                <span class="block font-serif text-lg font-medium text-cuidaty-dark">WhatsApp</span>
                <span class="text-sm text-foreground/60 group-hover:text-foreground/80"
                  >Enviar mensagem</span
                >
              </span>
            </a>
          </li>

          <li>
            <a
              href="mailto:contato@thetaharpia.com?subject=Quero%20conhecer%20o%20Cuidaty"
              class="group flex items-start gap-4 text-foreground/80 transition-colors hover:text-foreground"
            >
              <svg
                class="mt-1 h-5 w-5 flex-shrink-0 text-cuidaty-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <span>
                <span class="block font-serif text-lg font-medium text-cuidaty-dark">E-mail</span>
                <span class="text-sm text-foreground/60 group-hover:text-foreground/80"
                  >contato@thetaharpia.com</span
                >
              </span>
            </a>
          </li>

          <li>
            <a
              href="https://www.instagram.com/cuidaty_com/"
              target="_blank"
              rel="noopener"
              class="group flex items-start gap-4 text-foreground/80 transition-colors hover:text-foreground"
            >
              <svg
                class="mt-1 h-5 w-5 flex-shrink-0 text-cuidaty-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="1.5"></rect>
                <path
                  stroke-width="1.5"
                  d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2" stroke-linecap="round"
                ></line>
              </svg>
              <span>
                <span class="block font-serif text-lg font-medium text-cuidaty-dark">Instagram</span>
                <span class="text-sm text-foreground/60 group-hover:text-foreground/80"
                  >@cuidaty_com</span
                >
              </span>
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>
