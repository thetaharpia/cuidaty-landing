---
import ConsultoriaDemo from '../demos/ConsultoriaDemo.astro';
import { whatsappUrl } from '../../lib/contact';

/**
 * Seção Consultoria — posicionamento de serviço para o gestor de clínica.
 * Bloco claro: o argumento não é funcionalidade, é o que a Cuidaty faz junto
 * da clínica. O painel ao lado mostra o produto trabalhando, para a promessa
 * de serviço não ficar só no texto.
 */
const MEETING_URL = 'https://calendly.com/pedro-thetaharpia/30min';

// Gestor de clínica costuma decidir no WhatsApp antes de abrir agenda: os dois
// caminhos ficam lado a lado, e a mensagem já chega com o contexto de clínica.
const WA_URL = whatsappUrl(
  'Olá! Sou responsável por uma clínica e quero entender como a Cuidaty trabalha junto com a gestão.'
);

const results = [
  { value: 100, suffix: '%', label: 'de visibilidade financeira da clínica' },
  { value: 80, prefix: '−', suffix: '%', label: 'de redução nas glosas de convênio' },
];

// Alturas diferentes de propósito: no lockup da Geap a marca ocupa boa parte
// da arte, no da SulAmérica o logotipo é uma fatia menor. Igualar a altura do
// arquivo deixaria uma visualmente menor que a outra.
const convenios = [
  {
    nome: 'Geap Saúde',
    img: '/convenios/geap.webp',
    site: 'https://www.geap.org.br',
    w: 488,
    h: 150,
    classe: 'h-11',
  },
  {
    nome: 'SulAmérica Saúde',
    img: '/convenios/sulamerica.webp',
    site: 'https://portal.sulamericaseguros.com.br/',
    w: 417,
    h: 143,
    classe: 'h-14',
  },
];

const pillars = [
  {
    title: 'Consultoria além do suporte',
    desc: 'Suporte no dia a dia você tem sempre. Junto vem quem estuda a operação antes de configurar, para o sistema sair de uma conversa e não de um manual padrão.',
  },
  {
    title: 'O sistema se adapta a você',
    desc: 'Sua clínica não muda o jeito de trabalhar para caber no software. Campos, fluxos e documentos são ajustados à realidade dela.',
  },
  {
    title: 'Automação sob medida',
    desc: 'Processo que consome a equipe vira automação. Não é esperar entrar no roadmap: é construir o que a sua operação pede agora.',
  },
  {
    title: 'Mais faturamento no convênio',
    desc: 'Guia emitida do jeito que a operadora exige, glosa mapeada por motivo e receita que estava parada voltando para o caixa.',
  },
];
---

<section id="consultoria" class="relative scroll-mt-24 overflow-hidden bg-white py-24 md:py-32">
  <div class="container relative mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
        <div>
          <p
            class="csr mb-5 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary"
          >
            <span
              class="rounded-full bg-cuidaty-primary px-2 py-0.5 text-[10px] font-bold tracking-normal text-white"
              >Novo</span
            >
            Para gestores de clínica
          </p>

          <h2
            class="csr font-serif text-4xl font-semibold leading-[1.15] tracking-tight text-cuidaty-dark md:text-4xl lg:text-5xl"
            style="--d:60ms"
          >
            Software sozinho<br />não resolve clínica.
            <span class="mt-2 block italic text-cuidaty-dark/60">Por isso entramos junto.</span>
          </h2>

          <p class="csr mt-6 max-w-xl text-lg leading-relaxed text-foreground/70" style="--d:120ms">
            A Cuidaty não termina no login. Junto com o sistema vem um time de tecnologia que
            entende a operação da sua clínica, adapta a plataforma a ela e continua por perto depois
            que tudo está no ar.
          </p>

          <div class="csr mt-10 flex flex-wrap items-center gap-5" style="--d:180ms">
            <a
              href={MEETING_URL}
              target="_blank"
              rel="noopener"
              data-ga-event="generate_lead"
              data-ga-location="consultoria_agenda"
              class="group inline-flex items-center gap-3 rounded-md bg-cuidaty-primary px-7 py-3.5 text-base font-semibold text-white transition-all hover:bg-cuidaty-primary-hover hover:shadow-lifted"
            >
              Agendar uma conversa
              <svg
                class="h-5 w-5 transition-transform group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <a
              href={WA_URL}
              target="_blank"
              rel="noopener"
              data-ga-event="generate_lead"
              data-ga-location="consultoria_whatsapp"
              class="inline-flex items-center gap-2.5 rounded-md border border-cuidaty-dark/20 px-6 py-3.5 text-base font-semibold text-cuidaty-dark transition-colors hover:border-cuidaty-dark/40 hover:bg-cuidaty-dark/[0.03]"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
                ></path>
              </svg>
              Chamar no WhatsApp
            </a>
          </div>

          <p class="csr mt-4 text-sm text-foreground/50" style="--d:200ms">
            Trinta minutos na agenda, ou uma mensagem agora. Sem compromisso nos dois.
          </p>
        </div>

        <div class="csr flex w-full justify-center lg:justify-end" style="--d:240ms">
          <ConsultoriaDemo />
        </div>
      </div>

      <!-- Resultados: sem card, só tipografia e respiro. Os contadores sobem
           quando a faixa entra na tela. -->
      <div
        class="csr mt-20 grid gap-12 border-t border-cuidaty-dark/10 pt-14 md:grid-cols-3 md:gap-10"
      >
        {
          results.map((r) => (
            <div>
              <div class="font-serif text-6xl font-semibold leading-none tracking-tight text-cuidaty-primary lg:text-7xl">
                <span
                  data-count={r.value}
                  data-prefix={r.prefix ?? ''}
                  data-suffix={r.suffix ?? ''}
                >
                  {`${r.prefix ?? ''}0${r.suffix ?? ''}`}
                </span>
              </div>
              <p class="mt-4 max-w-[16rem] text-[0.95rem] leading-relaxed text-foreground/65">
                {r.label}
              </p>
            </div>
          ))
        }

        {
          /* Terceiro resultado não tem número: em vez de forçar um símbolo ao
            lado dos contadores, vira o fecho da faixa. */
        }
        <div class="self-end">
          <p class="font-serif text-[1.75rem] font-medium italic leading-snug text-cuidaty-dark">
            E o paciente sente a diferença.
          </p>
          <p class="mt-3 max-w-[18rem] text-[0.95rem] leading-relaxed text-foreground/65">
            Consulta confirmada sozinha, atendimento no horário e nada de burocracia na recepção.
          </p>
        </div>
      </div>

      <!-- Integrações de convênio: nomes em texto, sem logotipo de terceiro -->
      <div class="mt-16 border-t border-cuidaty-dark/10 pt-10 md:mt-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
          Integração com convênios
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-12 gap-y-6">
          {
            convenios.map((c) => (
              <a
                href={c.site}
                target="_blank"
                rel="noopener"
                title={`Site oficial da ${c.nome}`}
                class="transition-opacity hover:opacity-70"
              >
                <img
                  src={c.img}
                  alt={`Logotipo ${c.nome}`}
                  width={c.w}
                  height={c.h}
                  loading="lazy"
                  decoding="async"
                  class:list={['w-auto object-contain', c.classe]}
                />
              </a>
            ))
          }
        </div>
        <p class="mt-6 max-w-2xl text-[0.95rem] leading-relaxed text-foreground/65">
          A Cuidaty é um sistema de gestão para clínicas que integra com Geap e SulAmérica: guias
          emitidas e conferidas dentro da plataforma, no formato que cada operadora exige, com a
          glosa mapeada por motivo. Novas integrações de convênio entram conforme a necessidade da
          sua clínica.
        </p>
      </div>

      <ul class="mt-6 grid gap-5 md:grid-cols-2 md:gap-6">
        {
          pillars.map((p, i) => (
            <li
              class="csr border-cuidaty-dark/8 rounded-2xl border bg-white p-7 md:p-8"
              style={`--d:${i * 70}ms`}
            >
              <span class="block h-px w-8 bg-cuidaty-secondary" aria-hidden="true" />
              <h3 class="mt-5 font-serif text-2xl font-semibold leading-tight text-cuidaty-dark">
                {p.title}
              </h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-foreground/70">{p.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Revelação em scroll: os elementos sobem ao entrar na tela. */
  .csr {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0ms);
  }
  .csr.in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .csr {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#consultoria');

  if (section) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = section.querySelectorAll<HTMLElement>('.csr');

    // Contador que sobe até o valor final, desacelerando no fim.
    function countUp(el: HTMLElement) {
      const target = Number(el.dataset.count ?? '0');
      const duration = 1100;
      const start = performance.now();

      const prefix = el.dataset.prefix ?? '';
      const suffix = el.dataset.suffix ?? '';

      function frame(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = prefix + Math.round(target * eased) + suffix;
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    if (reduced) {
      reveals.forEach((el) => el.classList.add('in'));
      section.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        el.textContent =
          (el.dataset.prefix ?? '') + (el.dataset.count ?? '0') + (el.dataset.suffix ?? '');
      });
    } else {
      const io = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            el.classList.add('in');
            el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            observer.unobserve(el);
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
      );
      reveals.forEach((el) => io.observe(el));
    }
  }
</script>
