---
import ContratosDemo from '../demos/ContratosDemo.astro';

/**
 * Seção Contratos — gestão automatizada de contratos.
 * Contraponto claro ao bloco escuro de Metas: demo à esquerda no desktop,
 * narrativa do modelo preenchido → envio → assinatura arquivada.
 */
const REGISTER_URL = 'https://app.cuidaty.com/register';
---

<section id="contratos" class="relative overflow-hidden bg-cuidaty-light py-24 md:py-32">
  <div class="container relative mx-auto px-5 md:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
      <div class="lg:order-last">
        <p
          class="mb-5 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary"
        >
          <span
            class="rounded-full bg-cuidaty-primary px-2 py-0.5 text-[10px] font-bold tracking-normal text-white"
            >Novo</span
          >
          Contratos · Gestão automatizada
        </p>

        <h2
          class="font-serif text-4xl font-semibold leading-[1.05] tracking-tight text-cuidaty-dark md:text-5xl lg:text-[3.4rem]"
        >
          Do modelo à assinatura,<br />sem sair da Cuidaty.
          <span class="mt-2 block italic text-cuidaty-dark/60">O paciente assina do celular.</span>
        </h2>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-foreground/70">
          Escolha um modelo e os dados do paciente entram sozinhos, direto do prontuário. O contrato
          vai por WhatsApp ou e-mail, e você acompanha quem visualizou, quem assinou e o que está
          perto de vencer.
        </p>

        <ul class="mt-8 space-y-3.5">
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed"
              >Modelos prontos preenchidos automaticamente com os dados do prontuário</span
            >
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed"
              >Envio por WhatsApp ou e-mail, com status de visualização e assinatura em tempo real</span
            >
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed"
              >Vencimentos e renovações monitorados, com o contrato arquivado no prontuário</span
            >
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap items-center gap-5">
          <a
            href={REGISTER_URL}
            target="_blank"
            rel="noopener"
            data-ga-event="generate_lead"
            data-ga-location="contratos_section"
            class="group inline-flex items-center gap-3 rounded-md bg-cuidaty-primary px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-cuidaty-primary-hover"
          >
            Enviar meu primeiro contrato
            <svg
              class="h-5 w-5 transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <p class="text-sm text-foreground/50">Sem papel, sem impressora, sem correio.</p>
        </div>
      </div>

      <div class="flex w-full justify-center lg:order-first">
        <ContratosDemo class="w-full" />
      </div>
    </div>
  </div>
</section>
