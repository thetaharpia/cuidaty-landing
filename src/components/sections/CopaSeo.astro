---
/**
 * Seção sazonal de SEO da Copa do Mundo (clima Brasil 🇧🇷).
 *
 * Renderizada SOMENTE quando `COPA_THEME` está ligado (ver src/lib/copa.ts).
 * Liga a cobertura da Seleção ao tema de saúde mental / psicologia do esporte,
 * público da Cuidaty. As FAQs da Copa também entram no FAQPage do <head>.
 */
import { copaSeoIntro, copaTopics, copaFaqs } from '../../lib/copa';
---

<section id="copa" class="bg-beige py-24 md:py-32" aria-label="Cuidaty na Copa do Mundo">
  <div class="container mx-auto max-w-6xl px-5 md:px-8">
    <div class="mb-12 max-w-3xl">
      <p
        class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary"
      >
        <span aria-hidden="true">🇧🇷</span> Cuidaty na Copa do Mundo
      </p>
      <h2
        class="text-balance font-serif text-3xl font-semibold leading-[1.05] tracking-tight text-cuidaty-dark md:text-4xl lg:text-5xl"
      >
        Saúde mental também joga a Copa do Mundo.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-foreground/70">{copaSeoIntro}</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        copaTopics.map((topic) => (
          <article class="rounded-xl border border-border bg-white p-6 shadow-soft transition-shadow hover:shadow-lifted md:p-7">
            <h3 class="font-serif text-xl font-semibold leading-snug text-cuidaty-dark">
              {topic.heading}
            </h3>
            <p class="mt-3 leading-relaxed text-foreground/70">{topic.text}</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-cuidaty-primary">
              {topic.player}
            </p>
          </article>
        ))
      }
    </div>

    {
      copaFaqs.length > 0 && (
        <div class="mt-10 space-y-4">
          {copaFaqs.map((faq) => (
            <details class="group rounded-xl border border-border bg-white p-6 shadow-soft transition-shadow open:shadow-lifted md:p-7">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-semibold text-cuidaty-dark marker:content-none">
                <span>{faq.question}</span>
                <span class="mt-0.5 flex-shrink-0 text-2xl font-normal leading-none text-cuidaty-primary transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 leading-relaxed text-foreground/70">{faq.answer}</p>
            </details>
          ))}
        </div>
      )
    }
  </div>
</section>
