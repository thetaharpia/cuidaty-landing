---
import { homeFaqs } from '../../lib/seo';

const helpTopics = [
  { label: 'Agenda online', href: 'https://ajuda.cuidaty.com/agenda' },
  { label: 'Prontuário eletrônico', href: 'https://ajuda.cuidaty.com/prontuario' },
  { label: 'WhatsApp e lembretes', href: 'https://ajuda.cuidaty.com/comunicacao' },
  { label: 'Transcrição de consultas', href: 'https://ajuda.cuidaty.com/transcricao' },
  { label: 'Cuty AI', href: 'https://ajuda.cuidaty.com/cuty-ia' },
  { label: 'Financeiro', href: 'https://ajuda.cuidaty.com/financeiro' },
  { label: 'Portal de agendamento', href: 'https://ajuda.cuidaty.com/portal' },
  { label: 'Pacientes', href: 'https://ajuda.cuidaty.com/pacientes' },
  { label: 'Equipe e permissões', href: 'https://ajuda.cuidaty.com/permissoes' },
  { label: 'Conta e assinatura', href: 'https://ajuda.cuidaty.com/conta' },
];
---

<section id="faq" class="bg-white py-24 md:py-32">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <!-- Cabeçalho (esquerda, fixo no desktop) -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
          Perguntas frequentes
        </p>
        <h2
          class="text-balance font-serif text-3xl font-semibold leading-[1.05] tracking-tight text-cuidaty-dark md:text-4xl lg:text-5xl"
        >
          Dúvidas comuns sobre software para clínicas e consultórios.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-foreground/70">
          Respostas rápidas sobre agenda online, WhatsApp, prontuário eletrônico, financeiro,
          equipes e conformidade para a área da saúde.
        </p>
        <p class="mt-6 text-base leading-relaxed text-foreground/70">
          Precisa do passo a passo? A
          <a
            href="https://ajuda.cuidaty.com"
            rel="noopener"
            class="font-semibold text-cuidaty-primary underline underline-offset-4 hover:text-cuidaty-primary-hover"
          >
            Central de Ajuda da Cuidaty
          </a>
          reúne tutoriais de cada recurso da plataforma, com telas e exemplos.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            helpTopics.map((topic) => (
              <li>
                <a
                  href={topic.href}
                  rel="noopener"
                  class="inline-flex rounded-full border border-border bg-white px-3.5 py-1.5 text-sm text-foreground/70 transition-colors hover:border-cuidaty-primary hover:text-cuidaty-dark"
                >
                  {topic.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Lista (direita) -->
      <div class="space-y-4">
        {
          homeFaqs.map((faq) => (
            <details class="group rounded-xl border border-border bg-white p-6 shadow-soft transition-shadow open:shadow-lifted md:p-7">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-semibold text-cuidaty-dark marker:content-none">
                <span>{faq.question}</span>
                <span class="mt-0.5 flex-shrink-0 text-2xl font-normal leading-none text-cuidaty-primary transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 leading-relaxed text-foreground/70">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
