---
import { Image } from 'astro:assets';

import acompanheAtendimentoBot from '../../assets/acompanhe-atendimento-do-seu-bot-em-tempo-real.png';
import agendaSemanal from '../../assets/agenda-semanal.png';
import aviseAgendamentoWhatsapp from '../../assets/avise-agendamento-no-wahtsapp.png';
import configureAutomacoesWhatsapp from '../../assets/configure-automacoes-whatsapp.png';
import gestaoDeEquipe from '../../assets/gestao-de-equipe.png';
import painelFinanceiro from '../../assets/painel-financeiro-acompanhe-profissionais-destaque.png';
import prontuario from '../../assets/prontuario.png';
import relatorios from '../../assets/relatorios.png';
import useWhatsappNoApp from '../../assets/use-whatsapp-dentro-da-plataforma-integrado-com-sua-rotina-clinica.png';
---

<section id="funcionalidades" class="bg-beige py-24 md:py-32">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto mb-24 max-w-4xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
        Entrega de valor
      </p>
      <h2
        class="font-serif text-4xl font-semibold leading-[1.05] tracking-tight text-cuidaty-dark md:text-5xl lg:text-6xl"
      >
        Tecnologia que<br />
        <span class="italic text-cuidaty-dark/70">acolhe em silêncio.</span>
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-foreground/70">
        Quatro capacidades que funcionam em background para que você fique com os pacientes, não com
        a burocracia.
      </p>
    </div>

    <article
      class="mx-auto mb-32 grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.3fr] lg:items-center lg:gap-16"
    >
      <div>
        <div class="mb-5 flex items-baseline gap-4">
          <span class="font-serif text-2xl font-semibold text-cuidaty-primary/80">01</span>
          <span class="h-px flex-1 bg-cuidaty-primary/20"></span>
        </div>
        <h3
          class="mb-5 font-serif text-3xl font-semibold leading-tight text-cuidaty-dark md:text-4xl"
        >
          Automacao via WhatsApp
        </h3>
        <p class="mb-8 text-lg leading-relaxed text-foreground/70">
          Um assistente automatizado que atende na plataforma e no aplicativo do seu consultorio —
          configure uma vez, funciona todos os dias.
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Fluxos prontos de boas-vindas, confirmacao e lembrete
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Uso do WhatsApp dentro da plataforma e tambem no aplicativo
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Acompanhamento do bot em tempo real — voce assume quando quiser
            </span>
          </li>
        </ul>
      </div>

      <div>
        <div class="space-y-4 sm:hidden">
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={configureAutomacoesWhatsapp}
              alt="Interface de configuracao das automacoes de WhatsApp no Cuidaty"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={acompanheAtendimentoBot}
              alt="Acompanhamento de atendimentos do bot em tempo real"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="mx-auto w-[52%] overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={useWhatsappNoApp}
              alt="Tela do aplicativo do Cuidaty com atendimento pelo WhatsApp"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>

        <div class="relative hidden sm:block sm:pb-24">
          <figure
            class="relative z-10 overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={configureAutomacoesWhatsapp}
              alt="Interface de configuracao das automacoes de WhatsApp no Cuidaty"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="relative z-20 ml-auto mt-[-12%] w-[78%] overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted md:mt-[-10%] md:w-[72%]"
          >
            <Image
              src={acompanheAtendimentoBot}
              alt="Acompanhamento de atendimentos do bot em tempo real"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="absolute bottom-0 left-6 z-30 w-[30%] overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted md:w-[28%]"
          >
            <Image
              src={useWhatsappNoApp}
              alt="Tela do aplicativo do Cuidaty com atendimento pelo WhatsApp"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>
        <figcaption class="mt-3 text-right font-serif text-xs italic text-foreground/55">
          Configure, acompanhe em tempo real e atenda tambem pelo aplicativo.
        </figcaption>
      </div>
    </article>

    <article
      class="mx-auto mb-32 grid max-w-6xl gap-12 lg:grid-cols-[1.3fr_1fr] lg:items-center lg:gap-16"
    >
      <div class="lg:order-1">
        <div class="space-y-4 sm:hidden">
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={agendaSemanal}
              alt="Agenda semanal do Cuidaty com consultas agendadas"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={aviseAgendamentoWhatsapp}
              alt="Aviso de agendamento enviado automaticamente pelo WhatsApp"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>

        <div class="relative hidden sm:block">
          <figure
            class="relative overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={agendaSemanal}
              alt="Agenda semanal do Cuidaty com consultas agendadas"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="relative z-10 ml-auto mt-[-14%] w-[68%] overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted md:mt-[-10%] md:w-[62%]"
          >
            <Image
              src={aviseAgendamentoWhatsapp}
              alt="Aviso de agendamento enviado automaticamente pelo WhatsApp"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>
        <figcaption class="mt-3 text-right font-serif text-xs italic text-foreground/55">
          Cada agendamento na plataforma dispara a notificacao automaticamente.
        </figcaption>
      </div>

      <div class="lg:order-2">
        <div class="mb-5 flex items-baseline gap-4">
          <span class="font-serif text-2xl font-semibold text-cuidaty-primary/80">02</span>
          <span class="h-px flex-1 bg-cuidaty-primary/20"></span>
        </div>
        <h3
          class="mb-5 font-serif text-3xl font-semibold leading-tight text-cuidaty-dark md:text-4xl"
        >
          Agenda e presenca digital
        </h3>
        <p class="mb-8 text-lg leading-relaxed text-foreground/70">
          Uma agenda integrada que trabalha por voce — agendou na plataforma, o paciente recebe a
          notificacao no WhatsApp.
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Visao semanal e mensal, com status por cor
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Cada agendamento na plataforma dispara confirmacao e lembrete no WhatsApp
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Link de agendamento proprio — funciona 24 horas
            </span>
          </li>
        </ul>
      </div>
    </article>

    <article
      class="mx-auto mb-32 grid max-w-6xl gap-12 border-t border-cuidaty-dark/10 pt-16 lg:grid-cols-[1fr_1.3fr] lg:items-center lg:gap-16"
    >
      <div>
        <div class="mb-5 flex items-baseline gap-4">
          <span class="font-serif text-2xl font-semibold text-cuidaty-primary/80">03</span>
          <span class="h-px flex-1 bg-cuidaty-primary/20"></span>
        </div>
        <h3
          class="mb-5 font-serif text-3xl font-semibold leading-tight text-cuidaty-dark md:text-4xl"
        >
          Financeiro e gestao de equipes
        </h3>
        <p class="mb-8 text-lg leading-relaxed text-foreground/70">
          Tenha visao clara da operacao: acompanhe receita, repasses, status das consultas e a
          estrutura da sua equipe no mesmo sistema.
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Painel financeiro com receita, a receber, cancelamentos e tendencias
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Profissionais em destaque, repasses e desempenho acompanhados em tempo real
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Gestao de equipes com papeis, hierarquia e visibilidade por profissional
            </span>
          </li>
        </ul>
      </div>

      <div>
        <div class="space-y-4 sm:hidden">
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={painelFinanceiro}
              alt="Painel financeiro do Cuidaty com receita, repasses e profissionais em destaque"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={gestaoDeEquipe}
              alt="Tela de gestao de equipes do Cuidaty"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>

        <div class="relative hidden sm:block sm:pb-16">
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={painelFinanceiro}
              alt="Painel financeiro do Cuidaty com receita, repasses e profissionais em destaque"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="absolute bottom-0 right-0 w-[58%] overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={gestaoDeEquipe}
              alt="Tela de gestao de equipes do Cuidaty"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>
        <figcaption class="mt-3 text-right font-serif text-xs italic text-foreground/55">
          Resultado financeiro e equipe organizados no mesmo painel de gestao.
        </figcaption>
      </div>
    </article>

    <article
      class="mx-auto grid max-w-6xl gap-12 border-t border-cuidaty-dark/10 pt-16 lg:grid-cols-[1.3fr_1fr] lg:items-center lg:gap-16"
    >
      <div class="lg:order-1">
        <div class="space-y-4 sm:hidden">
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={prontuario}
              alt="Tela de prontuarios do Cuidaty com registros medicos e historico do paciente"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={relatorios}
              alt="Tela de relatorios clinicos do Cuidaty"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>

        <div class="relative hidden sm:block">
          <figure
            class="overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted"
          >
            <Image
              src={prontuario}
              alt="Tela de prontuarios do Cuidaty com registros medicos e historico do paciente"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
          <figure
            class="relative z-10 ml-auto mt-[-12%] w-[68%] overflow-hidden rounded-sm border border-cuidaty-dark/10 bg-white shadow-lifted md:w-[62%]"
          >
            <Image
              src={relatorios}
              alt="Tela de relatorios clinicos do Cuidaty"
              loading="lazy"
              quality={90}
              format="webp"
              class="h-auto w-full"
            />
          </figure>
        </div>
        <figcaption class="mt-3 text-right font-serif text-xs italic text-foreground/55">
          Registros clinicos e relatorios conectados para acompanhar cada paciente.
        </figcaption>
      </div>

      <div class="lg:order-2">
        <div class="mb-5 flex items-baseline gap-4">
          <span class="font-serif text-2xl font-semibold text-cuidaty-primary/80">04</span>
          <span class="h-px flex-1 bg-cuidaty-primary/20"></span>
        </div>
        <h3
          class="mb-5 font-serif text-3xl font-semibold leading-tight text-cuidaty-dark md:text-4xl"
        >
          Prontuarios e relatorios
        </h3>
        <p class="mb-8 text-lg leading-relaxed text-foreground/70">
          Centralize o historico do paciente e transforme cada atendimento em documentos e
          relatorios prontos para consulta ou compartilhamento.
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Prontuario eletronico completo com registros pesquisaveis
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Relatorios clinicos e documentos personalizaveis por especialidade
            </span>
          </li>
          <li class="flex gap-3 text-foreground/75">
            <span class="mt-3 h-px w-5 flex-shrink-0 bg-cuidaty-secondary" aria-hidden="true"
            ></span>
            <span class="text-[0.95rem] leading-relaxed">
              Historico organizado para consulta rapida e acompanhamento longitudinal
            </span>
          </li>
        </ul>
      </div>
    </article>

    <div class="mx-auto mt-20 max-w-5xl text-center">
      <a
        href="/#planos"
        class="inline-flex items-center gap-2 text-sm font-semibold text-cuidaty-primary transition-colors hover:text-cuidaty-dark"
      >
        Ver todos os planos
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
      <p class="mt-4 text-sm text-foreground/50">
        + mais de 30 funcionalidades incluidas para a gestao completa do seu consultorio
      </p>
    </div>
  </div>
</section>
