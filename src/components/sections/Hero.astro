---
import ConsultationFlow from './ConsultationFlow.astro';
---

<section id="hero" class="relative min-h-[100dvh] overflow-hidden bg-white">
  <h1 class="sr-only">
    Software para psicólogos, clínicas e consultórios de saúde com agenda online, prontuário
    eletrônico e automação de WhatsApp
  </h1>

  <!-- Mobile layout -->
  <div
    class="container relative mx-auto flex min-h-[100dvh] flex-col px-5 pb-8 pt-24 sm:pt-28 lg:hidden"
  >
    <div class="hero-fade hero-fade-up flex flex-1 flex-col justify-center py-8">
      <img
        src="/logo-written.svg"
        alt="Cuidaty"
        width="314"
        height="82"
        loading="eager"
        class="mb-6 w-auto self-start"
        style="height: clamp(2.75rem, 11vw, 4rem);"
      />

      <p class="mb-7 font-serif text-xl italic leading-snug text-cuidaty-dark/75" data-typewriter>
        <span class="tw-text">Menos burocracia. Mais escuta.</span><span
          class="tw-caret"
          aria-hidden="true"></span>
      </p>

      <p class="mb-8 max-w-prose text-base leading-relaxed text-foreground/70">
        A plataforma de gestão para psicólogos e demais profissionais de saúde: agenda, prontuário,
        financeiro, WhatsApp e um assistente de IA que transcreve consultas e tira dúvidas sobre o
        paciente — tudo num só lugar, para você focar no cuidado.
      </p>

      <!-- Primary CTA, full-width -->
      <a
        href="#contato"
        class="group flex items-center justify-center gap-2 rounded-md bg-cuidaty-primary px-6 text-base font-semibold text-white transition-all active:bg-cuidaty-primary-hover"
        style="min-height: 52px;"
      >
        Falar com a gente
        <svg
          class="h-4 w-4 transition-transform group-active:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <p class="mt-4 text-center text-sm text-foreground/60">
        Mais de <span class="font-semibold text-foreground/80">500 profissionais</span> já confiam no Cuidaty.
      </p>

      <!-- Jornada animada do atendimento -->
      <ConsultationFlow class="mt-12" />
    </div>
  </div>

  <!-- Desktop layout: texto + jornada animada (no lugar da imagem) -->
  <div
    class="container relative mx-auto hidden min-h-[100dvh] max-w-7xl items-center gap-16 px-8 py-28 lg:grid lg:grid-cols-[1.1fr_1fr] xl:gap-24 xl:px-12"
  >
    <!-- Texto editorial -->
    <div class="hero-fade hero-fade-left flex flex-col">
      <img
        src="/logo-written.svg"
        alt="Cuidaty"
        width="314"
        height="82"
        loading="eager"
        class="mb-8 w-auto self-start"
        style="height: clamp(3.25rem, 6vw, 5.5rem);"
      />

      <p
        class="mb-8 max-w-md font-serif text-2xl font-normal italic leading-tight text-cuidaty-dark/80 xl:text-3xl"
        data-typewriter
      >
        <span class="tw-text">Menos burocracia. Mais escuta.</span><span
          class="tw-caret"
          aria-hidden="true"></span>
      </p>

      <p class="mb-10 max-w-md text-base leading-relaxed text-foreground/70 xl:text-lg">
        A plataforma de gestão para psicólogos e demais profissionais de saúde: agenda, prontuário,
        financeiro, WhatsApp e um assistente de IA que transcreve consultas e tira dúvidas sobre o
        paciente — tudo num só lugar, para você focar no cuidado.
      </p>

      <div
        class="hero-fade hero-fade-up flex flex-col items-start gap-6"
        style="animation-delay: 0.25s;"
      >
        <a
          href="#contato"
          class="group inline-flex items-center gap-3 rounded-md bg-cuidaty-primary px-8 py-4 text-base font-semibold text-white transition-all hover:bg-cuidaty-primary-hover"
        >
          Falar com a gente
          <svg
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>

        <p class="text-sm text-foreground/60">
          Mais de <span class="font-semibold text-foreground/80">500 profissionais</span> já confiam no
          Cuidaty.
        </p>
      </div>
    </div>

    <!-- Jornada animada do atendimento (no lugar da imagem) -->
    <div class="hero-fade hero-fade-right w-full" style="animation-delay: 0.35s;">
      <ConsultationFlow />
    </div>
  </div>
</section>

<style>
  .hero-fade {
    opacity: 0;
    will-change: opacity, transform;
  }

  .hero-fade-left {
    transform: translateX(-24px);
  }

  .hero-fade-right {
    transform: translateX(24px);
  }

  .hero-fade-up {
    transform: translateY(16px);
  }

  .hero-fade.is-visible {
    animation: heroFadeIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-fade-left.is-visible {
    animation: heroFadeInLeft 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-fade-right.is-visible {
    animation: heroFadeInRight 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-fade-up.is-visible {
    animation: heroFadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes heroFadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes heroFadeInRight {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes heroFadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }

  /* Typewriter — cursor piscando ao lado do texto */
  .tw-caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 3px;
    background: currentColor;
    vertical-align: -0.12em;
    animation: twBlink 0.9s steps(1) infinite;
  }
  [data-typewriter].is-done .tw-caret {
    animation: none;
    opacity: 0;
  }
  @keyframes twBlink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tw-caret {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeElements = document.querySelectorAll('.hero-fade');
    fadeElements.forEach((el, index) => {
      setTimeout(
        () => {
          el.classList.add('is-visible');
        },
        100 + index * 120
      );
    });

    // Typewriter de "Menos burocracia. Mais escuta."
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach((el) => {
      const textEl = el.querySelector<HTMLElement>('.tw-text');
      if (!textEl) {
        return;
      }
      const full = textEl.textContent ?? '';
      if (reduceMotion) {
        el.classList.add('is-done');
        return;
      }

      textEl.textContent = '';
      let i = 0;
      const type = () => {
        if (i >= full.length) {
          el.classList.add('is-done');
          return;
        }
        const char = full.charAt(i);
        textEl.textContent += char;
        i += 1;
        // pausa maior após pontuação para dar ritmo
        const delay = char === '.' ? 420 : char === ' ' ? 50 : 55;
        window.setTimeout(type, delay);
      };
      window.setTimeout(type, 650);
    });
  });
</script>
