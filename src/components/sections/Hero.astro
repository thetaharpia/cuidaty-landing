---
import { Image } from 'astro:assets';
import backgroundImage from '../../assets/background-first-page.jpg';
import psychologistImage from '../../assets/psycologist-taking-coffe.jpg';
---

<section id="hero" class="relative min-h-[100dvh] overflow-hidden bg-beige">
  <h1 class="sr-only">
    Software para psicólogos, clínicas e consultórios de saúde com agenda online, prontuário
    eletrônico e automação de WhatsApp
  </h1>

  <!-- Background image (desktop only, as ambient texture) -->
  <div class="absolute inset-0 hidden lg:block">
    <Image
      src={backgroundImage}
      alt=""
      class="h-full w-full object-cover"
      widths={[1024, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      quality={80}
      format="webp"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-beige via-beige/85 to-beige/30"></div>
  </div>

  <!-- Mobile layout -->
  <div
    class="container relative mx-auto flex min-h-[100dvh] flex-col px-5 pb-8 pt-24 sm:pt-28 lg:hidden"
  >
    <div class="hero-fade hero-fade-up flex flex-1 flex-col justify-center py-8">
      <!-- Urgency eyebrow -->
      <div
        class="mb-5 inline-flex w-fit items-center gap-2 rounded-full bg-cuidaty-accent-light/60 px-3 py-1.5 text-xs font-semibold text-cuidaty-dark"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-cuidaty-secondary"></span>
        Demonstração personalizada · sem compromisso
      </div>

      <p
        class="mb-5 font-serif text-[2.75rem] font-semibold leading-[1.02] tracking-tight text-cuidaty-dark"
      >
        Recupere <span class="text-cuidaty-primary">8 horas</span> da sua semana.
      </p>

      <p class="mb-7 font-serif text-xl italic leading-snug text-cuidaty-dark/75">
        Menos burocracia. Mais escuta.
      </p>

      <p class="mb-8 max-w-prose text-base leading-relaxed text-foreground/70">
        O Cuidaty é um sistema para psicólogos, consultórios e clínicas de saúde com agenda online,
        prontuário eletrônico, financeiro e automação de WhatsApp.
      </p>

      <!-- Stat pills — trust signals visible in first viewport -->
      <dl class="mb-8 grid grid-cols-3 gap-2">
        <div class="rounded-md border border-cuidaty-primary/15 bg-white px-3 py-2.5">
          <dt class="font-serif text-lg font-semibold text-cuidaty-primary">500+</dt>
          <dd class="text-[11px] leading-tight text-foreground/60">profissionais</dd>
        </div>
        <div class="rounded-md border border-cuidaty-primary/15 bg-white px-3 py-2.5">
          <dt class="font-serif text-lg font-semibold text-cuidaty-primary">−73%</dt>
          <dd class="text-[11px] leading-tight text-foreground/60">de faltas</dd>
        </div>
        <div class="rounded-md border border-cuidaty-primary/15 bg-white px-3 py-2.5">
          <dt class="font-serif text-lg font-semibold text-cuidaty-primary">4h</dt>
          <dd class="text-[11px] leading-tight text-foreground/60">resposta</dd>
        </div>
      </dl>

      <!-- Primary CTA, full-width -->
      <a
        href="https://calendly.com/pedro-thetaharpia/30min"
        target="_blank"
        rel="noopener"
        class="group flex items-center justify-center gap-2 rounded-md bg-cuidaty-primary px-6 text-base font-semibold text-white transition-all active:bg-cuidaty-primary-hover"
        style="min-height: 52px;"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        Agendar demonstração grátis
        <svg
          class="h-4 w-4 transition-transform group-active:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <p class="mt-4 text-center text-xs text-foreground/55">
        30 minutos com o fundador · Atendimento humano
      </p>
    </div>
  </div>

  <!-- Desktop layout: editorial two-column -->
  <div
    class="container relative mx-auto hidden h-[100dvh] min-h-[700px] max-w-7xl items-center gap-16 px-8 lg:grid lg:grid-cols-[1.1fr_1fr] xl:gap-24 xl:px-12"
  >
    <!-- Left: Editorial text column -->
    <div class="hero-fade hero-fade-left flex flex-col justify-center">
      <div
        class="mb-6 inline-flex w-fit items-center gap-2 rounded-full bg-cuidaty-accent-light/60 px-3.5 py-1.5 text-xs font-semibold text-cuidaty-dark"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-cuidaty-secondary"></span>
        Demonstração personalizada · sem compromisso
      </div>

      <p
        class="mb-8 font-serif font-semibold leading-[0.95] tracking-tight text-cuidaty-dark"
        style="font-size: clamp(3.5rem, 7vw, 6.5rem);"
      >
        Cuidat<span class="text-cuidaty-secondary">y</span>.
      </p>

      <p
        class="mb-8 max-w-md font-serif text-2xl font-normal italic leading-tight text-cuidaty-dark/80 xl:text-3xl"
      >
        Menos burocracia. Mais escuta.
      </p>

      <p class="mb-10 max-w-md text-base leading-relaxed text-foreground/70 xl:text-lg">
        Sistema para psicólogos, consultórios e clínicas de saúde com agenda online, prontuário
        eletrônico, financeiro, equipes, relatórios e automação de WhatsApp.
      </p>

      <!-- Trust pills for desktop -->
      <div class="mb-8 flex flex-wrap gap-3 text-sm">
        <span
          class="rounded-full bg-cuidaty-accent-light/50 px-3.5 py-1.5 font-medium text-cuidaty-dark"
        >
          500+ profissionais
        </span>
        <span
          class="rounded-full bg-cuidaty-accent-light/50 px-3.5 py-1.5 font-medium text-cuidaty-dark"
        >
          −73% de faltas
        </span>
        <span
          class="rounded-full bg-cuidaty-accent-light/50 px-3.5 py-1.5 font-medium text-cuidaty-dark"
        >
          8h/semana economizadas
        </span>
      </div>

      <div
        class="hero-fade hero-fade-up flex flex-col items-start gap-6"
        style="animation-delay: 0.25s;"
      >
        <a
          href="https://calendly.com/pedro-thetaharpia/30min"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-3 rounded-md bg-cuidaty-primary px-8 py-4 text-base font-semibold text-white transition-all hover:bg-cuidaty-primary-hover"
        >
          Agendar demonstração
          <svg
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>

        <p class="text-sm text-foreground/60">
          Mais de <span class="font-semibold text-foreground/80">500 profissionais</span> já confiam no
          Cuidaty.
        </p>
      </div>
    </div>

    <!-- Right: Editorial photograph -->
    <div class="hero-fade hero-fade-right relative flex h-full items-center">
      <figure class="relative w-full">
        <Image
          src={psychologistImage}
          alt="Profissional da saúde em seu consultório"
          class="h-[72vh] max-h-[620px] w-full rounded-sm object-cover shadow-lifted"
          width={640}
          height={800}
          loading="eager"
          decoding="async"
          quality={85}
          format="webp"
        />
        <figcaption
          class="absolute -bottom-1 -left-1 bg-beige px-4 py-2 font-serif text-xs italic text-cuidaty-dark/70"
        >
          Um suporte que cuida de quem cuida.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero-fade {
    opacity: 0;
    will-change: opacity, transform;
  }

  .hero-fade-left {
    transform: translateX(-24px);
  }

  .hero-fade-right {
    transform: translateX(24px);
  }

  .hero-fade-up {
    transform: translateY(16px);
  }

  .hero-fade.is-visible {
    animation: heroFadeIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-fade-left.is-visible {
    animation: heroFadeInLeft 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-fade-right.is-visible {
    animation: heroFadeInRight 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-fade-up.is-visible {
    animation: heroFadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes heroFadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes heroFadeInRight {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes heroFadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fadeElements = document.querySelectorAll('.hero-fade');
    fadeElements.forEach((el, index) => {
      setTimeout(
        () => {
          el.classList.add('is-visible');
        },
        100 + index * 120
      );
    });
  });
</script>
