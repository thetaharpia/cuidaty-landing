---
import { Image } from 'astro:assets';
---

<section id="hero" class="relative h-[100dvh] min-h-[600px] overflow-hidden bg-gradient-to-br from-beige to-white">
  <!-- Warm background from Figma -->
  <div class="absolute inset-0">
    <Image
      src="/background-first-page.jpg"
      alt=""
      class="h-full w-full object-cover"
      width={1920}
      height={1080}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      quality={85}
      format="webp"
    />
    <!-- Subtle dark overlay for better text contrast -->
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <!-- Mobile layout: centered branding focus -->
  <div class="container relative mx-auto flex h-full flex-col px-4 md:px-6 lg:hidden">
    <!-- Centered branding block - the main focus -->
    <div class="hero-fade hero-fade-up flex flex-1 flex-col items-center justify-center">
      <Image
        src="/assets/logo-written.svg"
        alt="Cuidaty"
        width={314}
        height={82}
        class="mb-4 w-64 drop-shadow-2xl sm:w-80"
        loading="eager"
      />
      <h1 class="sr-only">Cuidaty - Mais que um software, um suporte invisível</h1>
      <p
        class="max-w-xs text-center text-base font-light text-white/90 drop-shadow-lg sm:max-w-sm sm:text-lg"
      >
        Mais que um software, um suporte invisível
      </p>
    </div>

    <!-- Bottom section: CTA + trust -->
    <div class="hero-fade hero-fade-up flex flex-col items-center gap-4 pb-10 sm:pb-14" style="animation-delay: 0.3s;">
      <p class="text-sm font-light text-white/95 drop-shadow-md sm:text-base">
        A tecnologia que devolve o respiro à sua rotina clínica.
      </p>

      <!-- CTA Button -->
      <a
        href="#planos"
        class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-white/50 bg-white/90 px-6 py-3 text-sm font-bold text-cuidaty-primary shadow-2xl backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-white sm:gap-3 sm:px-8 sm:py-4 sm:text-base"
      >
        Quero saber mais
        <svg
          class="h-4 w-4 sm:h-5 sm:w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <!-- Trust indicator -->
      <div
        class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-2 text-white/90 shadow-lg backdrop-blur-sm sm:gap-3 sm:px-5 sm:py-2.5"
      >
        <svg class="h-4 w-4 flex-shrink-0 text-white" fill="currentColor" viewBox="0 0 20 20">
          <path
            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
          ></path>
        </svg>
        <p class="text-xs font-semibold sm:text-sm">Mais de 500 profissionais confiam no Cuidaty</p>
      </div>
    </div>
  </div>

  <!-- Desktop layout: two-column with photo card -->
  <div class="container relative mx-auto hidden h-full px-4 md:px-6 lg:flex lg:flex-col lg:justify-end lg:pb-20 lg:pt-28">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-2 items-end gap-12">
      <!-- Left: Big Branding Logo and Name -->
      <div class="hero-fade hero-fade-left flex flex-col items-start justify-end">
        <div class="flex flex-col items-start">
          <Image
            src="/logo.svg"
            alt="Cuidaty Logo"
            width={320}
            height={320}
            class="h-72 w-72 drop-shadow-2xl xl:h-80 xl:w-80"
            loading="eager"
          />
          <h1
            class="font-serif text-9xl font-bold leading-none tracking-tight text-white drop-shadow-2xl xl:text-[10rem]"
          >
            Cuidat<span class="text-cuidaty-secondary">y</span>
          </h1>
          <p
            class="mt-2 max-w-md text-left text-2xl font-light text-white/90 drop-shadow-lg lg:text-3xl"
          >
            Mais que um software, um suporte invisível
          </p>
        </div>
      </div>

      <!-- Right: Image + Content -->
      <div class="hero-fade hero-fade-right flex flex-col items-end space-y-6">
        <!-- Professional image -->
        <div class="w-full max-w-lg">
          <div class="animate-float relative">
            <div
              class="relative overflow-hidden rounded-3xl border-2 border-white/20 bg-white/10 p-2 shadow-[0_20px_60px_rgba(0,0,0,0.3)] backdrop-blur-sm"
            >
              <Image
                src="/psycologist-taking-coffe.jpg"
                alt="Profissional da saúde trabalhando em seu consultório"
                class="h-auto w-full rounded-2xl object-cover"
                width={600}
                height={750}
                loading="eager"
                quality={90}
                format="webp"
              />
              <div class="absolute -bottom-8 -right-8 h-40 w-40 rounded-full bg-white/30 blur-3xl">
              </div>
            </div>
            <!-- Floating badge -->
            <div
              class="absolute -right-4 -top-4 rounded-2xl border-2 border-white/50 bg-white/90 p-4 shadow-2xl backdrop-blur-md"
            >
              <div class="flex items-center gap-2">
                <div
                  class="h-3 w-3 animate-pulse rounded-full bg-green-400 shadow-[0_0_10px_rgba(74,222,128,0.6)]"
                >
                </div>
                <span class="text-sm font-bold text-cuidaty-primary">Disponível</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Information below the image -->
        <div class="hero-fade hero-fade-up w-full max-w-md space-y-5 text-right">
          <p class="text-lg font-light leading-relaxed text-white/95 drop-shadow-md lg:text-xl">
            A tecnologia que devolve o respiro à sua rotina clínica.
          </p>

          <!-- CTA Button -->
          <div class="flex justify-end">
            <a
              href="#planos"
              class="inline-flex items-center justify-center gap-3 rounded-full border-2 border-white/50 bg-white/90 px-8 py-4 font-bold text-cuidaty-primary shadow-2xl backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-white hover:shadow-[0_20px_60px_rgba(255,255,255,0.4)]"
            >
              Quero saber mais
              <svg
                class="h-5 w-5 transition-transform group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>

          <!-- Trust indicator -->
          <div class="flex justify-end">
            <div
              class="inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 px-5 py-2.5 text-white/90 shadow-lg backdrop-blur-sm"
            >
              <svg class="h-5 w-5 flex-shrink-0 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                ></path>
              </svg>
              <p class="text-sm font-semibold">Mais de 500 profissionais confiam no Cuidaty</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fade-in entrance animations */
  .hero-fade {
    opacity: 0;
    will-change: opacity, transform;
  }

  .hero-fade-left {
    transform: translateX(-40px);
  }

  .hero-fade-right {
    transform: translateX(40px);
  }

  .hero-fade-up {
    transform: translateY(30px);
  }

  .hero-fade.is-visible {
    animation: heroFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-fade-left.is-visible {
    animation: heroFadeInLeft 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-fade-right.is-visible {
    animation: heroFadeInRight 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-fade-up.is-visible {
    animation: heroFadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes heroFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes heroFadeInLeft {
    from { opacity: 0; transform: translateX(-40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes heroFadeInRight {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes heroFadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>

<script>
  // Trigger fade-in animations on first load
  document.addEventListener('DOMContentLoaded', () => {
    const fadeElements = document.querySelectorAll('.hero-fade');

    // Stagger the animations for a cascading effect
    fadeElements.forEach((el, index) => {
      setTimeout(() => {
        el.classList.add('is-visible');
      }, 200 + index * 250);
    });
  });
</script>
