---
import { Image } from 'astro:assets';
---

<section id="resultados" class="relative bg-secondary py-20 md:py-28 overflow-hidden">
  <!-- Blobs -->
  <div class="absolute -top-24 -left-24 w-72 h-72 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-cuidaty-primary/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: 2×2 icon stat cards -->
      <div class="grid grid-cols-2 gap-5">

        <!-- 500+ Profissionais -->
        <div class="bg-white rounded-3xl p-7 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-12 h-12 text-cuidaty-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <p class="font-serif text-4xl font-bold text-cuidaty-primary mb-1">500+</p>
          <p class="text-sm text-cuidaty-primary/70 font-medium leading-snug">Profissionais ativos</p>
        </div>

        <!-- 4.9/5 Avaliação -->
        <div class="bg-white rounded-3xl p-7 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-12 h-12 text-cuidaty-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
          </svg>
          <p class="font-serif text-4xl font-bold text-cuidaty-primary mb-1">4.9/5</p>
          <p class="text-sm text-cuidaty-primary/70 font-medium leading-snug">Avaliação média</p>
        </div>

        <!-- 8 horas -->
        <div class="bg-white rounded-3xl p-7 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-12 h-12 text-cuidaty-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="font-serif text-4xl font-bold text-cuidaty-primary mb-1">8 horas</p>
          <p class="text-sm text-cuidaty-primary/70 font-medium leading-snug">Economizadas por média na semana</p>
        </div>

        <!-- 73% no-show -->
        <div class="bg-white rounded-3xl p-7 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-12 h-12 text-cuidaty-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
          </svg>
          <p class="font-serif text-4xl font-bold text-cuidaty-primary mb-1">73%</p>
          <p class="text-sm text-cuidaty-primary/70 font-medium leading-snug">Menos no-show</p>
        </div>

      </div>

      <!-- Right: phone mockup -->
      <div class="flex justify-center lg:justify-end">
        <Image
          src="/assets/celulares.png"
          alt="Aplicativo Cuidaty em dispositivos móveis"
          class="w-full max-w-md lg:max-w-lg h-auto"
          width={600}
          height={450}
          loading="lazy"
          format="webp"
          quality={85}
        />
      </div>

    </div>
  </div>
</section>
