---
import { Image } from 'astro:assets';
---

<section id="resultados" class="relative overflow-hidden bg-secondary py-20 md:py-28">
  <!-- Blobs -->
  <div
    class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-white/10 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-cuidaty-primary/20 blur-3xl"
  >
  </div>

  <div class="container relative z-10 mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left: 2×2 icon stat cards -->
      <div class="grid grid-cols-2 gap-5">
        <!-- 500+ Profissionais -->
        <div
          class="flex flex-col items-center rounded-3xl bg-white p-7 text-center shadow-sm transition-shadow hover:shadow-md"
        >
          <svg
            class="mb-4 h-12 w-12 text-cuidaty-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <p class="mb-1 font-serif text-4xl font-bold text-cuidaty-primary">500+</p>
          <p class="text-sm font-medium leading-snug text-cuidaty-primary/70">
            Profissionais ativos
          </p>
        </div>

        <!-- 4.9/5 Avaliação -->
        <div
          class="flex flex-col items-center rounded-3xl bg-white p-7 text-center shadow-sm transition-shadow hover:shadow-md"
        >
          <svg
            class="mb-4 h-12 w-12 text-cuidaty-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
            ></path>
          </svg>
          <p class="mb-1 font-serif text-4xl font-bold text-cuidaty-primary">4.9/5</p>
          <p class="text-sm font-medium leading-snug text-cuidaty-primary/70">Avaliação média</p>
        </div>

        <!-- 8 horas -->
        <div
          class="flex flex-col items-center rounded-3xl bg-white p-7 text-center shadow-sm transition-shadow hover:shadow-md"
        >
          <svg
            class="mb-4 h-12 w-12 text-cuidaty-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="mb-1 font-serif text-4xl font-bold text-cuidaty-primary">8 horas</p>
          <p class="text-sm font-medium leading-snug text-cuidaty-primary/70">
            Economizadas por média na semana
          </p>
        </div>

        <!-- 73% no-show -->
        <div
          class="flex flex-col items-center rounded-3xl bg-white p-7 text-center shadow-sm transition-shadow hover:shadow-md"
        >
          <svg
            class="mb-4 h-12 w-12 text-cuidaty-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
            ></path>
          </svg>
          <p class="mb-1 font-serif text-4xl font-bold text-cuidaty-primary">73%</p>
          <p class="text-sm font-medium leading-snug text-cuidaty-primary/70">Menos no-show</p>
        </div>
      </div>

      <!-- Right: phone mockup -->
      <div class="flex justify-center lg:justify-end">
        <Image
          src="/assets/celulares.png"
          alt="Aplicativo Cuidaty em dispositivos móveis"
          class="h-auto w-full max-w-md lg:max-w-lg"
          width={600}
          height={450}
          loading="lazy"
          format="webp"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
