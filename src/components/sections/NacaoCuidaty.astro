---
const testimonials = [
  {
    img: '/testimonials/huini-prova-social.png',
    name: 'Huini Coelho',
    role: 'Psicóloga e Gestalt-Terapeuta',
    crp: 'CRP 10/06891',
    quote:
      'O Cuidaty trouxe leveza à minha rotina. Antes era um caos responder mensagens no WhatsApp entre sessões.',
  },
  {
    img: '/testimonials/gabriel-prova-social.svg',
    name: 'Gabriel Garcia',
    role: 'Psicólogo, Abordagem Centrada na Pessoa',
    crp: 'CRP 05/83142',
    quote: 'Com o Cuidaty, a gestão da clínica se tornou mais inteligente e fluida.',
  },
  {
    img: '/testimonials/giovana-prova-social.svg',
    name: 'Giovana Dos Santos P Ferreira',
    role: 'Gestora de atividades clínicas, Startuppsi',
    crp: 'CRP 05/86762',
    quote:
      'O Cuidaty trouxe organização para a gestão da nossa clínica, assertividade e agilidade.',
  },
];

const clinics = [
  {
    img: '/clinics/startuppsi.svg',
    name: 'StartupPsi',
    desc: 'Parceiro oficial na transformação digital da psicologia brasileira.',
    href: 'https://startuppsi.com.br/',
    rounded: false,
  },
  {
    img: '/clinics/pro-implante.jpg',
    name: 'Pro-Implante',
    desc: 'Confia na automação de atendimentos com o Cuidaty.',
    href: null,
    rounded: true,
  },
];
---

<section id="sobre" class="bg-white py-24 md:py-32">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-6xl">
      <!-- Cabeçalho -->
      <div class="mb-14 grid gap-10 md:grid-cols-[1.3fr_1fr] md:items-end">
        <div>
          <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
            Quem já cuida com a gente
          </p>
          <h2
            class="font-serif text-4xl font-semibold leading-[1.05] tracking-tight text-cuidaty-dark md:text-5xl lg:text-6xl"
          >
            Você pode cuidar de tudo sozinho,<br />
            <span class="italic text-cuidaty-dark/70">mas não precisa.</span>
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-foreground/70">
          Faça parte da Cuidaty, uma comunidade de profissionais que escolheram focar no que
          realmente importa: o cuidado genuíno com seus pacientes.
        </p>
      </div>

      <!-- Depoimentos em cards -->
      <div class="mb-16 grid gap-6 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl border border-border bg-card p-6 shadow-soft transition-shadow hover:shadow-lifted md:p-7">
              <svg
                class="mb-5 h-6 w-6 text-cuidaty-secondary"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
              </svg>
              <blockquote class="mb-6 text-lg leading-snug text-cuidaty-dark">{t.quote}</blockquote>
              <figcaption class="mt-auto flex items-center gap-3 border-t border-border pt-5">
                <img
                  src={t.img}
                  alt={t.name}
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="h-12 w-12 flex-shrink-0 rounded-full object-cover"
                />
                <div>
                  <div class="font-semibold text-cuidaty-dark">{t.name}</div>
                  <div class="text-xs text-foreground/60">{t.role}</div>
                  <div class="text-xs text-foreground/45">{t.crp}</div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <!-- Clínicas em cards -->
      <p class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
        Clínicas que confiam na gente
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        {
          clinics.map((c) => {
            const Tag = c.href ? 'a' : 'div';
            return (
              <Tag
                href={c.href ?? undefined}
                target={c.href ? '_blank' : undefined}
                rel={c.href ? 'noopener' : undefined}
                class:list={[
                  'group flex items-center gap-5 rounded-2xl border border-border bg-card p-6 shadow-soft md:p-7',
                  c.href && 'transition-shadow hover:shadow-lifted',
                ]}
              >
                <img
                  src={c.img}
                  alt={c.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'h-14 w-14 flex-shrink-0 object-contain',
                    c.rounded && 'rounded-full object-cover',
                  ]}
                />
                <div>
                  <div class="font-serif text-xl font-semibold text-cuidaty-dark">{c.name}</div>
                  <p class="mt-1 text-sm leading-snug text-foreground/60">{c.desc}</p>
                </div>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
