---
const testimonials = [
  {
    img: '/testimonials/huini-prova-social.png',
    name: 'Huini Coelho',
    role: 'Psicóloga e Gestalt-Terapeuta',
    crp: 'CRP 10/06891',
    quote:
      'O Cuidaty trouxe leveza à minha rotina. Antes era um caos responder mensagens no WhatsApp entre sessões.',
  },
  {
    img: '/testimonials/gabriel-prova-social.svg',
    name: 'Gabriel Garcia',
    role: 'Psicólogo — Abordagem Centrada na Pessoa',
    crp: 'CRP 05/83142',
    quote: 'Com o Cuidaty, a gestão da clínica se tornou mais inteligente e fluida.',
  },
  {
    img: '/testimonials/giovana-prova-social.svg',
    name: 'Giovana Dos Santos P Ferreira',
    role: 'Gestora de atividades clínicas — Startuppsi',
    crp: 'CRP 05/86762',
    quote:
      'O Cuidaty trouxe organização para a gestão da nossa clínica, assertividade e agilidade.',
  },
];

const stats = [
  { value: '98%', label: 'taxa média de resposta automática' },
  { value: '−60%', label: 'redução no no-show das consultas' },
  { value: '100+', label: 'atendimentos agendados por dia' },
  { value: '4h', label: 'tempo medio de resposta em dias uteis' },
];
---

<section class="bg-cuidaty-primary py-24 md:py-32">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-6xl">
      <!-- Editorial header, on deep primary -->
      <div class="mb-20 grid gap-10 md:grid-cols-[1.3fr_1fr] md:items-end">
        <div>
          <p
            class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-accent-light"
          >
            Quem já cuida com a gente
          </p>
          <h2
            class="font-serif text-4xl font-semibold leading-[1.05] tracking-tight text-white md:text-5xl lg:text-6xl"
          >
            Você pode cuidar de tudo sozinho,<br />
            <span class="italic text-cuidaty-accent-light">mas não precisa.</span>
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-white/75">
          Faça parte da Cuidaty — uma comunidade de profissionais que escolheram focar no que
          realmente importa: o cuidado genuíno com seus pacientes.
        </p>
      </div>

      <!-- Stats as typographic strip, using accent-light as warm accent -->
      <dl class="mb-20 grid grid-cols-2 gap-px bg-white/10 md:grid-cols-4">
        {
          stats.map((s) => (
            <div class="bg-cuidaty-primary px-6 py-8">
              <dt class="font-serif text-4xl font-semibold leading-none text-cuidaty-accent-light md:text-5xl">
                {s.value}
              </dt>
              <dd class="mt-3 text-sm leading-snug text-white/70">{s.label}</dd>
            </div>
          ))
        }
      </dl>

      <!-- Testimonials as editorial quotes, not uniform cards -->
      <div class="mb-24 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col">
              <svg
                class="mb-5 h-6 w-6 text-cuidaty-secondary"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
              </svg>
              <blockquote class="mb-6 font-serif text-xl leading-snug text-white md:text-2xl">
                {t.quote}
              </blockquote>
              <figcaption class="mt-auto flex items-center gap-3 border-t border-white/15 pt-5">
                <img
                  src={t.img}
                  alt={t.name}
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="h-12 w-12 flex-shrink-0 rounded-full object-cover"
                />
                <div>
                  <div class="font-semibold text-white">{t.name}</div>
                  <div class="text-xs text-white/60">{t.role}</div>
                  <div class="text-xs text-white/45">{t.crp}</div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <!-- Clinics that trust us — minimal horizontal, no shadow cards -->
      <div class="mb-16 border-t border-white/15 pt-12">
        <p class="mb-8 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-accent-light">
          Clínicas que confiam na gente
        </p>

        <div class="grid gap-10 md:grid-cols-2 md:gap-16">
          <a
            href="https://startuppsi.com.br/"
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-5 text-white/85 transition-colors hover:text-white"
          >
            <img
              src="/clinics/startuppsi.svg"
              alt="StartupPsi"
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
              class="h-14 w-14 flex-shrink-0 object-contain opacity-90 brightness-0 invert"
            />
            <div>
              <div class="font-serif text-xl font-semibold">StartupPsi</div>
              <p class="text-sm leading-snug text-white/60 group-hover:text-white/80">
                Parceiro oficial na transformação digital da psicologia brasileira.
              </p>
            </div>
          </a>

          <div class="flex items-center gap-5 text-white/85">
            <img
              src="/clinics/pro-implante.jpg"
              alt="Pro-Implante"
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
              class="h-14 w-14 flex-shrink-0 rounded-full object-cover"
            />
            <div>
              <div class="font-serif text-xl font-semibold">Pro-Implante</div>
              <p class="text-sm leading-snug text-white/60">
                Confia na automação de atendimentos com o Cuidaty.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA in accent tone -->
      <div class="border-t border-white/15 pt-12 text-center">
        <a
          href="https://calendly.com/pedro-thetaharpia/30min"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 rounded-md bg-cuidaty-accent-light px-8 py-4 font-semibold text-cuidaty-dark transition-all hover:bg-white"
        >
          Agendar minha demonstração
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <p class="mt-4 text-sm text-white/55">
          30 minutos · Atendimento com o fundador · Sem compromisso
        </p>
      </div>
    </div>
  </div>
</section>
