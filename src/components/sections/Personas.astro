---
/**
 * Seção de planos (id="planos"). Três planos: Premium (gestão), Plus (gestão +
 * comunicação + IA) e Clínicas e Grupos (escala). Conteúdo do design do Figma.
 */
interface Plan {
  name: string;
  subtitle: string;
  tagline: string;
  price: string;
  cycle: string;
  inherits?: string;
  features: string[];
  exclusions?: string[];
  featuresNote?: string;
  cta: { label: string; href: string };
  dark?: boolean;
  recommended?: boolean;
}

const plans: Plan[] = [
  {
    name: 'Básico',
    subtitle: 'A base para organizar a rotina',
    tagline: 'Gestão completa do consultório para organizar toda a sua rotina.',
    price: 'R$ 59,90',
    cycle: '/mês',
    features: [
      'Agenda inteligente, recorrências e detecção de conflitos',
      'Prontuário eletrônico completo, com imagens e resumo clínico',
      'Gestão de pacientes: cadastro, saúde, convênio e importação',
      'Formulários e relatórios, com exportação em PDF',
      'Financeiro completo: dashboard, caixa, faturas e checkout',
      'Portal de agendamento online + portal do paciente',
    ],
    exclusions: ['Sem comunicação por WhatsApp', 'Sem Cuty AI'],
    featuresNote: '+ 30 funcionalidades incluídas',
    cta: { label: 'Começar agora', href: '#contato' },
  },
  {
    name: 'Premium',
    subtitle: 'Comunicação e inteligência clínica',
    tagline: 'Tudo do Básico, agora com WhatsApp, Cuty AI e geração de documentos.',
    price: 'R$ 89,90',
    cycle: '/mês',
    inherits: 'Tudo do Básico, mais:',
    features: [
      'Cuty AI: assistente clínico baseado no prontuário',
      'Respostas e resumos com a fonte citada dos dados do paciente',
      'Geração de modelos de documentos',
      'Comunicação WhatsApp completa: central, automações e lembretes',
    ],
    featuresNote: '+ 40 funcionalidades incluídas',
    cta: { label: 'Começar agora', href: '#contato' },
  },
  {
    name: 'Plus',
    subtitle: 'Cada palavra da sessão organizada',
    tagline: 'Tudo do Premium, agora com transcrição e resumo automático das sessões.',
    price: 'R$ 159,90',
    cycle: '/mês',
    inherits: 'Tudo do Premium, mais:',
    features: [
      'Transcrição de consultas e teleconsulta, com captura de áudio',
      'Resumo clínico automático a partir do áudio (SOAP e outros formatos)',
    ],
    featuresNote: '+ 45 funcionalidades incluídas',
    cta: { label: 'Começar agora', href: '#contato' },
    recommended: true,
  },
  {
    name: 'Clínicas e Grupos',
    subtitle: 'Escala, controle e inteligência de negócio',
    tagline: 'Para clínicas, redes e grupos que precisam crescer com gestão.',
    price: 'Sob consulta',
    cycle: '',
    inherits: 'Tudo do Plus, mais:',
    features: [
      'Multiunidade: várias filiais e grupos em uma conta',
      'Equipes e permissões avançadas por cargo e prontuário',
      'Analytics avançado: portal, comunicação e operação',
      'Migração de dados de outras plataformas',
      'Diretórios de profissionais e importação de usuários em massa',
      'Limites de usuários e módulos customizáveis',
    ],
    featuresNote: 'Tudo da Cuidaty, sem limites',
    cta: { label: 'Solicitar proposta', href: 'https://calendly.com/pedro-thetaharpia/30min' },
    dark: true,
  },
];
---

<section id="planos" class="bg-white py-24 md:py-32">
  <div class="container mx-auto px-5 md:px-8">
    <!-- Cabeçalho editorial -->
    <div class="mx-auto mb-14 grid max-w-7xl gap-8 md:mb-16 md:grid-cols-[1.2fr_1fr] md:items-end md:gap-16">
      <div>
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
          Planos
        </p>
        <h2
          class="font-serif text-4xl font-semibold leading-[1.03] tracking-tight text-cuidaty-dark md:text-5xl lg:text-6xl"
        >
          Um plano que<br />
          <span class="italic text-cuidaty-dark/70">acompanha seu ritmo.</span>
        </h2>
      </div>
      <p class="text-lg leading-relaxed text-foreground/70">
        Comece organizando a rotina e evolua para comunicação e inteligência conforme o consultório
        cresce.
      </p>
    </div>

    <!-- Grade de planos -->
    <div class="mx-auto grid max-w-7xl items-stretch gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        plans.map((plan) => (
          <article
            class:list={[
              'relative flex h-full flex-col rounded-xl border p-6 transition-shadow md:p-7',
              plan.dark
                ? 'border-cuidaty-dark bg-cuidaty-dark text-white shadow-lifted'
                : plan.recommended
                  ? 'border-cuidaty-primary bg-card shadow-lifted ring-1 ring-cuidaty-primary'
                  : 'border-border bg-card shadow-soft hover:shadow-lifted',
            ]}
          >
            {plan.recommended && (
              <span class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-cuidaty-primary px-3 py-1 text-xs font-semibold text-white shadow-soft">
                Recomendado
              </span>
            )}

            <header>
              <h3
                class:list={[
                  'font-serif text-2xl font-semibold leading-tight',
                  plan.dark ? 'text-white' : 'text-cuidaty-dark',
                ]}
              >
                {plan.name}
              </h3>
              <p
                class:list={[
                  'mt-1 text-sm font-medium',
                  plan.dark ? 'text-white/75' : 'text-cuidaty-primary',
                ]}
              >
                {plan.subtitle}
              </p>
              <p
                class:list={[
                  'mt-3 min-h-[2.75rem] text-sm leading-snug',
                  plan.dark ? 'text-white/65' : 'text-foreground/65',
                ]}
              >
                {plan.tagline}
              </p>

              <div class="mt-6 flex items-baseline gap-1.5">
                <span
                  class:list={[
                    'font-serif text-4xl font-semibold',
                    plan.dark ? 'text-white' : 'text-cuidaty-dark',
                  ]}
                >
                  {plan.price}
                </span>
                {plan.cycle && (
                  <span class:list={['text-sm', plan.dark ? 'text-white/60' : 'text-foreground/60']}>
                    {plan.cycle}
                  </span>
                )}
              </div>
            </header>

            <div
              class:list={[
                'mt-6 border-t pt-6',
                plan.dark ? 'border-white/15' : 'border-border',
              ]}
            >
              {plan.inherits && (
                <p
                  class:list={[
                    'mb-4 text-xs font-semibold uppercase tracking-[0.1em]',
                    plan.dark ? 'text-cuidaty-accent' : 'text-cuidaty-primary',
                  ]}
                >
                  {plan.inherits}
                </p>
              )}

              <ul class:list={['space-y-3 text-sm', plan.dark ? 'text-white/80' : 'text-foreground/75']}>
                {plan.features.map((feature) => (
                  <li class="flex gap-2.5">
                    <svg
                      class:list={[
                        'mt-0.5 h-4 w-4 flex-shrink-0',
                        plan.dark ? 'text-cuidaty-accent' : 'text-cuidaty-secondary',
                      ]}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span class="leading-snug">{feature}</span>
                  </li>
                ))}
              </ul>

              {plan.exclusions && (
                <ul class="mt-3 space-y-3 text-sm text-foreground/45">
                  {plan.exclusions.map((exclusion) => (
                    <li class="flex gap-2.5">
                      <svg
                        class="mt-0.5 h-4 w-4 flex-shrink-0 text-foreground/30"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M18 6 6 18" />
                        <path d="M6 6l12 12" />
                      </svg>
                      <span class="leading-snug">{exclusion}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="mt-auto pt-8">
              {plan.featuresNote &&
                (plan.dark ? (
                  <p class="mb-4 text-sm font-medium text-white/75">{plan.featuresNote}</p>
                ) : (
                  <a
                    href="/#funcionalidades"
                    class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-cuidaty-primary transition-colors hover:text-cuidaty-dark"
                  >
                    {plan.featuresNote}
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                ))}
              <a
                href={plan.cta.href}
                target={plan.cta.href.startsWith('http') ? '_blank' : undefined}
                rel={plan.cta.href.startsWith('http') ? 'noopener' : undefined}
                class:list={[
                  'flex w-full items-center justify-center gap-2 rounded-md px-5 py-3 text-sm font-semibold transition-all',
                  plan.dark
                    ? 'bg-white text-cuidaty-dark hover:bg-beige'
                    : 'bg-cuidaty-primary text-white hover:bg-cuidaty-primary-hover',
                ]}
              >
                {plan.cta.label}
                <svg
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
