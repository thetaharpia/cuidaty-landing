---
const plans = [
  {
    tag: 'Profissional + assistente',
    title: 'Organize sua prática com apoio',
    price: 'R$ 59,90',
    cycle: '/mês',
    note: 'Plano Solo — 1 profissional + 1 assistente',
    features: [
      'Até 2 usuários: 1 profissional e 1 assistente',
      'Todos os módulos habilitados',
      'Gestão compartilhada de agenda e confirmações',
      'Controle financeiro com visibilidade personalizada',
      'Portal de agendamento profissional',
    ],
    cta: { label: 'Começar agora', href: 'https://calendly.com/pedro-thetaharpia/30min' },
    emphasized: false,
  },
  {
    tag: 'Clínicas e grupos',
    title: 'Gerencie múltiplos profissionais',
    price: 'Sob consulta',
    cycle: '',
    note: 'Ideal para até 3 unidades',
    features: [
      'Equipe completa em uma plataforma única',
      'Gestão de repasses e divisão automática',
      'Dashboard consolidado de todas as agendas',
      'Relatórios gerenciais e métricas operacionais',
    ],
    cta: { label: 'Solicitar proposta', href: '#contato' },
    emphasized: true,
  },
  {
    tag: 'Hospitais e grandes operações',
    title: 'Escale sua operação de saúde',
    price: 'Enterprise',
    cycle: '',
    note: '+3 unidades ou +50 usuários',
    features: [
      'Gestão centralizada de múltiplas unidades',
      'Hierarquia de permissões e controles',
      'API para integração com sistemas existentes',
      'Analytics avançado e Business Intelligence',
    ],
    cta: { label: 'Entre em contato', href: '#contato' },
    emphasized: false,
  },
];
---

<section id="planos" class="bg-background py-24 md:py-32">
  <div class="container mx-auto px-5 md:px-8">

    <!-- Editorial header, left-aligned -->
    <div class="mx-auto mb-16 max-w-4xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
        Para quem é
      </p>
      <h2 class="font-serif text-4xl font-semibold leading-[1.05] tracking-tight text-cuidaty-dark md:text-5xl lg:text-6xl">
        Um plano que<br/>
        <span class="italic text-cuidaty-dark/70">acompanha seu ritmo.</span>
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-foreground/70">
        Do consultório individual até a rede hospitalar — você começa pequeno e cresce com a gente.
      </p>
    </div>

    <!-- Plans as editorial list, not identical cards -->
    <div class="mx-auto max-w-6xl divide-y divide-border border-y border-border">
      {plans.map((plan) => (
        <article class={`grid gap-8 py-10 md:grid-cols-[1.2fr_1.5fr_auto] md:gap-12 md:py-12 ${plan.emphasized ? 'bg-accent -mx-5 px-5 md:-mx-8 md:px-8' : ''}`}>
          <!-- Title + pricing -->
          <header>
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-cuidaty-primary/80">
              {plan.tag}
            </p>
            <h3 class="mb-5 font-serif text-2xl font-semibold leading-tight text-cuidaty-dark md:text-3xl">
              {plan.title}
            </h3>
            <div class="flex items-baseline gap-2">
              <span class="font-serif text-3xl font-semibold text-cuidaty-dark md:text-4xl">{plan.price}</span>
              {plan.cycle && <span class="text-base text-foreground/60">{plan.cycle}</span>}
            </div>
            <p class="mt-1 text-xs text-foreground/50">{plan.note}</p>
          </header>

          <!-- Features as clean typographic list -->
          <ul class="space-y-2.5 text-foreground/75">
            {plan.features.map((f) => (
              <li class="flex gap-3">
                <span class="mt-3 h-px w-4 flex-shrink-0 bg-cuidaty-primary/60" aria-hidden="true"></span>
                <span class="text-[0.95rem] leading-relaxed">{f}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <div class="flex items-start md:items-end">
            <a
              href={plan.cta.href}
              target={plan.cta.href.startsWith('http') ? '_blank' : undefined}
              rel={plan.cta.href.startsWith('http') ? 'noopener' : undefined}
              class={`inline-flex items-center gap-2 whitespace-nowrap rounded-md px-5 py-3 text-sm font-semibold transition-all ${
                plan.emphasized
                  ? 'bg-cuidaty-primary text-white hover:bg-cuidaty-primary-hover'
                  : 'border border-cuidaty-dark/20 bg-transparent text-cuidaty-dark hover:border-cuidaty-dark/40 hover:bg-cuidaty-dark/[0.03]'
              }`}
            >
              {plan.cta.label}
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
