---
const badges = [
  { label: 'LGPD', note: 'Em conformidade' },
  { label: 'SSL', note: 'Criptografia de ponta' },
  { label: 'Backup', note: 'Diário e redundante' },
  { label: 'Suporte', note: 'Humano, em horário comercial' },
];
---

<section id="seguranca" class="bg-beige py-20 md:py-24">
  <div class="container mx-auto px-5 md:px-8">
    <div class="mx-auto max-w-5xl">

      <div class="mb-12 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-primary">
            Confiança e segurança
          </p>
          <h2 class="font-serif text-3xl font-semibold leading-tight tracking-tight text-cuidaty-dark md:text-4xl">
            Protegendo seus dados — <span class="italic text-cuidaty-dark/70">e os dos seus pacientes.</span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-foreground/65">
          Hospedagem 100% brasileira, auditoria de segurança semestral
          e criptografia AES-256 em trânsito e em repouso.
        </p>
      </div>

      <dl class="grid grid-cols-2 gap-px bg-border md:grid-cols-4">
        {badges.map((b) => (
          <div class="bg-beige px-6 py-8 text-center">
            <dt class="font-serif text-2xl font-semibold text-cuidaty-dark md:text-3xl">{b.label}</dt>
            <dd class="mt-2 text-xs text-foreground/60">{b.note}</dd>
          </div>
        ))}
      </dl>

    </div>
  </div>
</section>
