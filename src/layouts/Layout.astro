---
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string;
}

const {
  title = 'Cuidaty - Software para Consultórios e Clínicas | Agenda, Prontuário e WhatsApp',
  description = 'Sistema completo de gestão para consultórios, clínicas de saúde mental, hospitais e centros multidisciplinares. Prontuário eletrônico, agenda online com confirmação via WhatsApp, gestão financeira, controle de equipes e conformidade com LGPD, CFM, CFP e padrão TISS. Mais de 500 profissionais economizam 8h por semana. A partir de R$80/mês.',
  image = '/screenshot.png',
  noindex = false,
  keywords = 'software para psicólogos, sistema para consultório de psicologia, agenda online psicólogo, prontuário eletrônico psicologia, automação whatsapp consultório, gestão de consultório, sistema para clínicas, agendamento online pacientes, controle financeiro consultório, software para terapeutas, sistema para nutricionistas, gestão de clínica de saúde, prontuário SOAP, lembrete de consulta whatsapp, confirmação de consulta automática, redução de faltas consultório, portal de agendamento online, software LGPD saúde, gestão de pacientes, sistema para fisioterapeutas, plataforma para profissionais de saúde, software consultório online, teleconsulta, gestão clínica integrada, repasse financeiro clínica, conformidade CFM, conformidade CFP, padrão TISS, anamnese digital, prescrição eletrônica, sistema multi-unidade saúde, gestão de filiais clínica, software saúde Brasil, cuidaty',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImageURL = new URL(image, Astro.site).toString();
const siteUrl = Astro.site?.toString() || 'https://cuidaty.com';

// Organization structured data
const organizationData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: 'Cuidaty',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/logo.svg', siteUrl).toString(),
    width: 120,
    height: 40,
  },
  image: fullImageURL,
  slogan: 'Mais que um software, um suporte invisível',
  description: 'Tecnologia que devolve o respiro à rotina clínica de profissionais da saúde.',
  email: 'contato@thetaharpia.com',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'contato@thetaharpia.com',
      availableLanguage: 'Portuguese',
      areaServed: 'BR',
    },
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'contato@thetaharpia.com',
      availableLanguage: 'Portuguese',
      areaServed: 'BR',
    },
  ],
  areaServed: {
    '@type': 'Country',
    name: 'Brazil',
  },
  knowsLanguage: 'pt-BR',
  foundingDate: '2024',
  sameAs: [
    'https://www.instagram.com/thetaharpia',
    'https://www.linkedin.com/company/thetaharpia',
    'https://x.com/thetaharpia',
    'https://www.youtube.com/channel/UCBoprCxMDUrZdcvNDwiOBzg',
    'https://thetaharpia.com',
  ],
  parentOrganization: {
    '@type': 'Organization',
    name: 'ThetaHarpia',
    url: 'https://thetaharpia.com',
  },
};

// SoftwareApplication structured data
const softwareData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cuidaty',
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'Gestão de Consultórios e Clínicas',
  operatingSystem: 'Web',
  offers: [
    {
      '@type': 'Offer',
      name: 'Plano Individual',
      price: '80',
      priceCurrency: 'BRL',
      priceValidUntil: '2026-12-31',
      availability: 'https://schema.org/InStock',
      description: 'Para profissionais individuais com assistente. Inclui agenda compartilhada, portal de agendamento e controle financeiro.',
    },
    {
      '@type': 'Offer',
      name: 'Plano Profissional',
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
      description: 'Para clínicas e grupos com até 3 unidades. Gestão de repasses, dashboard consolidado e relatórios gerenciais.',
    },
    {
      '@type': 'Offer',
      name: 'Plano Empresarial',
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
      description: 'Para hospitais e grandes operações com +3 unidades ou +50 usuários. API para integração, analytics avançado e Business Intelligence.',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    bestRating: '5',
    worstRating: '1',
    ratingCount: '500',
  },
  description: description,
  url: siteUrl,
  featureList: [
    'Prontuário eletrônico com anamnese, evolução, prescrição e observação',
    'Agenda online com agendamentos recorrentes e fluxo de status',
    'Automação de confirmações e lembretes via WhatsApp',
    'Importação de pacientes a partir de contatos do WhatsApp',
    'Cadastro completo de pacientes com dados demográficos, alergias e convênio',
    'Gestão financeira com contas a receber, fluxo de caixa e faturas com boleto',
    'Relatórios clínicos com anexos PDF e comentários de equipe',
    'Controle de equipes com 5 níveis de permissão',
    'Estrutura multi-unidade: organização, filiais, departamentos e setores',
    'Conformidade com LGPD, CFM, CFP, ANS e padrão TISS',
    'Criptografia AES-256 e hospedagem 100% brasileira',
    'Portal de agendamento profissional para pacientes',
  ],
  screenshot: fullImageURL,
  softwareVersion: '2.0',
  softwareHelp: {
    '@type': 'CreativeWork',
    url: `${siteUrl}#funcionalidades`,
  },
  provider: {
    '@id': `${siteUrl}#organization`,
  },
  audience: {
    '@type': 'HealthAndBeautyBusiness',
    audienceType: 'Profissionais da saúde, psicólogos, médicos, enfermeiros, terapeutas, gestores de clínicas e hospitais',
  },
};

// WebSite structured data (enables sitelinks search box)
const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'Cuidaty',
  url: siteUrl,
  description: description,
  publisher: {
    '@id': `${siteUrl}#organization`,
  },
  inLanguage: 'pt-BR',
};

// WebPage structured data
const webPageData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalURL.toString(),
  name: title,
  description: description,
  url: canonicalURL.toString(),
  isPartOf: {
    '@id': `${siteUrl}#website`,
  },
  about: {
    '@id': `${siteUrl}#organization`,
  },
  inLanguage: 'pt-BR',
};

// BreadcrumbList structured data
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
  ],
};

// FAQ structured data
const faqData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'O que é o Cuidaty?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O Cuidaty é um sistema completo de gestão para consultórios, clínicas de saúde mental, hospitais, laboratórios e centros multidisciplinares. Inclui prontuário eletrônico, agenda online com confirmação via WhatsApp, gestão financeira, controle de equipes e conformidade com LGPD, CFM, CFP e padrão TISS.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quanto custa o Cuidaty?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O plano Individual para profissionais com assistente custa R$ 80/mês. Para clínicas e grupos, oferecemos o plano Profissional com proposta personalizada. Hospitais e grandes operações contam com o plano Empresarial sob consulta.',
      },
    },
    {
      '@type': 'Question',
      name: 'O Cuidaty é seguro e está em conformidade com a LGPD?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim. O Cuidaty atende às exigências da LGPD, Resolução CFM 1.821/2007, CFP, ANS e padrão TISS. Utilizamos criptografia AES-256, hospedagem 100% brasileira com backup redundante e auditoria de segurança semestral.',
      },
    },
    {
      '@type': 'Question',
      name: 'O Cuidaty integra com WhatsApp?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim. O Cuidaty possui integração nativa com WhatsApp para automação de confirmações e lembretes de consultas, gerenciamento de contatos e importação de pacientes diretamente dos contatos do WhatsApp.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quais tipos de prontuário o sistema oferece?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O prontuário eletrônico do Cuidaty suporta 4 tipos de registro: Anamnese, Evolução, Prescrição e Observação. Conta com editor rich text, controle de privacidade (privado ou público para equipe), finalização com trava e trilha completa de auditoria.',
      },
    },
    {
      '@type': 'Question',
      name: 'O Cuidaty funciona para clínicas com múltiplas unidades?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim. O Cuidaty possui estrutura hierárquica que suporta múltiplas unidades: Organização → Sub-Organização (filial, departamento, setor, ala). O plano Empresarial é ideal para operações com mais de 3 unidades ou 50 usuários, com API para integração e analytics avançado.',
      },
    },
  ],
};

// Combine all structured data
const structuredData = [organizationData, softwareData, websiteData, webPageData, breadcrumbData, faqData];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- DNS Prefetch and Preconnect for Performance -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload Critical Resources -->
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    
    <!-- Critical font loading - synchronous for consistency -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Arapey:ital@0;1&family=Poppins:wght@300;400;500;600;700&display=swap"
    />
    
    <!-- Preload key font files for faster rendering -->
    <link rel="preload" href="https://fonts.gstatic.com/s/poppins/v21/pxiEyp8kv8JHgFVrJJfecg.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/lora/v33/0QIvMX1D_JOuMwf7I_FMl_GW8g.woff2" as="font" type="font/woff2" crossorigin />



    <!-- OpenSearch -->
    <link rel="search" type="application/opensearchdescription+xml" title="Cuidaty" href="/opensearch.xml" />

    <!-- Favicons and Icons -->
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#356588" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cuidaty" />

    <!-- Additional Meta Tags -->
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Cuidaty" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <meta name="language" content="Portuguese" />
    <meta name="revisit-after" content="7 days" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="classification" content="Healthcare Software, Medical Practice Management" />
    <meta name="category" content="Health" />
    <meta name="coverage" content="Brasil" />
    <meta name="target" content="Profissionais da saúde, psicólogos, médicos, terapeutas, gestores de clínicas" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />

    <!-- Search Engine Verification (replace with actual values) -->
    <!-- <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" /> -->
    <!-- <meta name="msvalidate.01" content="YOUR_BING_VERIFICATION_CODE" /> -->

    <!-- OpenSearch -->
    <link rel="search" type="application/opensearchdescription+xml" title="Cuidaty" href="/opensearch.xml" />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Language alternates -->
    <link rel="alternate" hreflang="pt-BR" href={canonicalURL.toString()} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.toString()} />

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      noindex={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: fullImageURL,
          url: canonicalURL.toString(),
        },
        optional: {
          description: description,
          siteName: 'Cuidaty',
          locale: 'pt_BR',
        },
        image: {
          url: fullImageURL,
          secureUrl: fullImageURL,
          type: 'image/png',
          width: 1200,
          height: 630,
          alt: 'Cuidaty - Sistema de gestão completa para consultórios, clínicas e hospitais com prontuário eletrônico, agenda online e automação via WhatsApp',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@thetaharpia',
        creator: '@thetaharpia',
        title: title,
        description: description,
        image: fullImageURL,
        imageAlt: 'Cuidaty - Sistema de gestão completa para consultórios, clínicas e hospitais com prontuário eletrônico, agenda online e automação via WhatsApp',
      }}
    />

    <!-- Structured Data (JSON-LD) -->
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Inline critical CSS for font loading -->
    <style>
      /* Font loading optimization with fallbacks */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 400;
        font-display: block;
        src: local('Poppins');
      }
      @font-face {
        font-family: 'Lora';
        font-style: normal;
        font-weight: 400;
        font-display: block;
        src: local('Lora');
      }

      /* Prevent layout shift for images */
      img {
        content-visibility: auto;
      }

      /* Smooth scroll behavior */
      html {
        scroll-behavior: smooth;
      }

      /* Critical above-the-fold styles */
      body {
        margin: 0;
        padding: 0;
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Prevent FOUC (Flash of Unstyled Content) */
      .astro-route-announcer {
        position: absolute;
        left: -10000px;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }

      /* Header height reservation to prevent CLS */
      header {
        min-height: 72px;
      }
    </style>

    <!-- Performance optimization script -->
    <script is:inline>
      // Prefetch links on hover for faster navigation
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const link = entry.target;
              const href = link.getAttribute('href');
              if (href && href.startsWith('#')) {
                // Internal anchor, no prefetch needed
                return;
              }
            }
          });
        });

        // Observe all links on the page after DOM loads
        window.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('a[href]').forEach((link) => {
            link.addEventListener('mouseenter', () => {
              const href = link.getAttribute('href');
              if (href && !href.startsWith('#') && !href.startsWith('javascript:')) {
                const linkElem = document.createElement('link');
                linkElem.rel = 'prefetch';
                linkElem.href = href;
                document.head.appendChild(linkElem);
              }
            });
          });
        });
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
