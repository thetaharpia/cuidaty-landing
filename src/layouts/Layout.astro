---
import { SEO } from 'astro-seo';
import '../styles/global.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { healthFeatureList, homeDescription, homeFaqs, homeKeywords, homeTitle } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string;
  canonical?: string;
}

const {
  title = homeTitle,
  description = homeDescription,
  image = '/screenshot.png',
  noindex = false,
  keywords = homeKeywords,
  canonical,
} = Astro.props;

const googleSiteVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? 'CuQ7uBwOoGiZimHGFB_WF-rWulUEtnNMyjfq_Vs6VqQ';
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const effectiveKeywords = keywords;

const canonicalURL = canonical ? new URL(canonical) : new URL(Astro.url.pathname, Astro.site);
const fullImageURL = new URL(image, Astro.site).toString();
const siteUrl = Astro.site?.toString() || 'https://cuidaty.com';
const pathname = Astro.url.pathname;
const isHomePage = pathname === '/';
const pathSegments = pathname.split('/').filter(Boolean);
const pageLabel =
  pathSegments.length === 0
    ? 'Home'
    : pathSegments[pathSegments.length - 1]
        .split('-')
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(' ');

const helpCenterUrl = 'https://ajuda.cuidaty.com';

// Categorias da Central de Ajuda (usadas no JSON-LD e no link rel="help")
const helpCenterSections = [
  { name: 'Agenda online', path: '/agenda' },
  { name: 'Prontuário eletrônico', path: '/prontuario' },
  { name: 'Pacientes', path: '/pacientes' },
  { name: 'WhatsApp e comunicação', path: '/comunicacao' },
  { name: 'Transcrição de consultas', path: '/transcricao' },
  { name: 'Cuty AI', path: '/cuty-ia' },
  { name: 'Financeiro', path: '/financeiro' },
  { name: 'Portal de agendamento', path: '/portal' },
  { name: 'Equipe e permissões', path: '/permissoes' },
  { name: 'Conta e assinatura', path: '/conta' },
];

// Organization structured data
const organizationData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: 'Cuidaty',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/logo.svg', siteUrl).toString(),
    width: 120,
    height: 40,
  },
  image: fullImageURL,
  slogan: 'Menos burocracia. Mais escuta.',
  description: 'Tecnologia que devolve o respiro à rotina clínica de profissionais da saúde.',
  email: 'contato@thetaharpia.com',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'contato@thetaharpia.com',
      telephone: '+55-96-9100-3520',
      availableLanguage: 'Portuguese',
      areaServed: 'BR',
    },
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'contato@thetaharpia.com',
      availableLanguage: 'Portuguese',
      areaServed: 'BR',
    },
  ],
  areaServed: {
    '@type': 'Country',
    name: 'Brazil',
  },
  knowsLanguage: 'pt-BR',
  foundingDate: '2024',
  sameAs: [
    'https://www.instagram.com/cuidaty_com/',
    'https://www.linkedin.com/company/cuidaty',
    'https://www.youtube.com/channel/UCU2CVCFOvYGE1XqTGKsX4wQ',
    'https://thetaharpia.com',
  ],
  parentOrganization: {
    '@type': 'Organization',
    name: 'ThetaHarpia',
    url: 'https://thetaharpia.com',
  },
};

// SoftwareApplication structured data
const softwareData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cuidaty',
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'Gestão de Consultórios e Clínicas',
  operatingSystem: 'Web',
  offers: [
    {
      '@type': 'Offer',
      name: 'Plano Básico',
      price: '69.90',
      priceCurrency: 'BRL',
      priceValidUntil: '2026-12-31',
      availability: 'https://schema.org/InStock',
      description:
        'Gestão completa do consultório: agenda inteligente, prontuário eletrônico, gestão de pacientes, formulários, relatórios, financeiro e portal de agendamento.',
    },
    {
      '@type': 'Offer',
      name: 'Plano Premium',
      price: '89.90',
      priceCurrency: 'BRL',
      priceValidUntil: '2026-12-31',
      availability: 'https://schema.org/InStock',
      description:
        'Tudo do Básico com comunicação por WhatsApp, Cuty AI (assistente clínico baseado no prontuário) e geração de documentos.',
    },
    {
      '@type': 'Offer',
      name: 'Plano Plus',
      price: '159.90',
      priceCurrency: 'BRL',
      priceValidUntil: '2026-12-31',
      availability: 'https://schema.org/InStock',
      description:
        'Tudo do Premium com transcrição de consultas e teleconsultas e resumo clínico automático em SOAP e outros formatos.',
    },
    {
      '@type': 'Offer',
      name: 'Plano Clínicas e Grupos',
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
      description:
        'Para clínicas, redes e grupos: multiunidade, equipes e permissões avançadas, analytics, migração de dados e limites customizáveis. Preço sob consulta.',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    bestRating: '5',
    worstRating: '1',
    ratingCount: '500',
  },
  description: description,
  url: siteUrl,
  featureList: healthFeatureList,
  screenshot: fullImageURL,
  softwareVersion: '2.0',
  softwareHelp: {
    '@id': `${helpCenterUrl}#website`,
  },
  provider: {
    '@id': `${siteUrl}#organization`,
  },
  audience: {
    '@type': 'HealthAndBeautyBusiness',
    audienceType:
      'Profissionais da saúde, psicólogos, médicos, enfermeiros, terapeutas, gestores de clínicas e hospitais',
  },
  inLanguage: 'pt-BR',
  keywords: effectiveKeywords,
};

// WebSite structured data (enables sitelinks search box)
const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'Cuidaty',
  url: siteUrl,
  description: description,
  publisher: {
    '@id': `${siteUrl}#organization`,
  },
  inLanguage: 'pt-BR',
};

// Central de Ajuda (subdomínio) — declara a relação com o site principal
const helpCenterData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${helpCenterUrl}#website`,
  name: 'Central de Ajuda Cuidaty',
  alternateName: 'Ajuda Cuidaty',
  url: helpCenterUrl,
  description:
    'Tutoriais e passo a passo da Cuidaty: agenda online, prontuário eletrônico, WhatsApp, transcrição de consultas, financeiro e portal de agendamento.',
  inLanguage: 'pt-BR',
  publisher: {
    '@id': `${siteUrl}#organization`,
  },
  isPartOf: {
    '@id': `${siteUrl}#website`,
  },
  hasPart: helpCenterSections.map((section) => ({
    '@type': 'WebPage',
    name: `${section.name} — Central de Ajuda Cuidaty`,
    url: `${helpCenterUrl}${section.path}`,
    inLanguage: 'pt-BR',
  })),
};

// WebPage structured data
const webPageData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalURL.toString(),
  name: title,
  description: description,
  url: canonicalURL.toString(),
  isPartOf: {
    '@id': `${siteUrl}#website`,
  },
  about: {
    '@id': `${siteUrl}#organization`,
  },
  inLanguage: 'pt-BR',
};

// BreadcrumbList structured data
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    ...(isHomePage
      ? []
      : [
          {
            '@type': 'ListItem',
            position: 2,
            name: pageLabel,
            item: canonicalURL.toString(),
          },
        ]),
  ],
};

// FAQ structured data
const faqData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

// Combine all structured data
const structuredData = [
  organizationData,
  websiteData,
  webPageData,
  breadcrumbData,
  ...(isHomePage ? [softwareData, faqData, helpCenterData] : []),
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- DNS Prefetch and Preconnect for Performance -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload Critical Resources -->
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" fetchpriority="high" />

    <!-- Critical font loading - synchronous for consistency -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Besley:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Figtree:wght@400;500;600;700&display=swap"
    />

    <!-- Central de Ajuda (subdomínio) -->
    <link rel="help" href={helpCenterUrl} title="Central de Ajuda Cuidaty" />
    <link rel="dns-prefetch" href={helpCenterUrl} />

    <!-- OpenSearch -->
    <link
      rel="search"
      type="application/opensearchdescription+xml"
      title="Cuidaty"
      href="/opensearch.xml"
    />

    <!-- Favicons and Icons -->
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#356588" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cuidaty" />

    <!-- Additional Meta Tags -->
    <meta name="keywords" content={effectiveKeywords} />
    <meta name="author" content="Cuidaty" />
    <!-- Robots directive is emitted once by astro-seo (<SEO noindex>) below.
         This googlebot tag adds rich-result preview hints without duplicating name="robots". -->
    {
      !noindex && (
        <meta
          name="googlebot"
          content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
        />
      )
    }
    <meta name="language" content="Portuguese" />
    <meta name="revisit-after" content="7 days" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="classification" content="Healthcare Software, Medical Practice Management" />
    <meta name="category" content="Health" />
    <meta name="coverage" content="Brasil" />
    <meta
      name="target"
      content="Profissionais da saúde, psicólogos, médicos, terapeutas, gestores de clínicas"
    />

    <!-- Geo Tags -->
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />

    <!-- Search Engine Verification (códigos via .env; Google tem fallback) -->
    {
      googleSiteVerification && (
        <meta name="google-site-verification" content={googleSiteVerification} />
      )
    }
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog Cuidaty"
      href="/blog/rss.xml"
    />

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      noindex={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: fullImageURL,
          url: canonicalURL.toString(),
        },
        optional: {
          description: description,
          siteName: 'Cuidaty',
          locale: 'pt_BR',
        },
        image: {
          url: fullImageURL,
          secureUrl: fullImageURL,
          type: 'image/png',
          width: 1200,
          height: 630,
          alt: 'Cuidaty: sistema de gestão completa para consultórios, clínicas e hospitais com prontuário eletrônico, agenda online e automação via WhatsApp',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@thetaharpia',
        creator: '@thetaharpia',
        title: title,
        description: description,
        image: fullImageURL,
        imageAlt:
          'Cuidaty: sistema de gestão completa para consultórios, clínicas e hospitais com prontuário eletrônico, agenda online e automação via WhatsApp',
      }}
    />

    <!-- Structured Data (JSON-LD) -->
    {
      structuredData.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <!-- Inline critical CSS for font loading -->
    <style>
      /* Prevent layout shift for images */
      img {
        content-visibility: auto;
      }

      /* Smooth scroll behavior */
      html {
        scroll-behavior: smooth;
      }

      /* Critical above-the-fold styles */
      body {
        margin: 0;
        padding: 0;
        font-family:
          'Figtree',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Prevent FOUC (Flash of Unstyled Content) */
      .astro-route-announcer {
        position: absolute;
        left: -10000px;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }

      /* Header height reservation to prevent CLS */
      header {
        min-height: 72px;
      }

      /* Reveal on scroll — pré-oculta o conteúdo das seções (exceto o Hero)
         só quando há JS, evitando flash. Anima os blocos internos em cascata. */
      .reveal-ready main > section:not(#hero) > div:first-child > * {
        opacity: 0;
        transform: translateY(32px);
        transition:
          opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: opacity, transform;
      }
      .reveal-ready main > section:not(#hero) > div:first-child.is-in > * {
        opacity: 1;
        transform: none;
      }
      /* Stagger: cada bloco surge logo após o anterior */
      .reveal-ready main > section:not(#hero) > div:first-child.is-in > *:nth-child(2) {
        transition-delay: 0.1s;
      }
      .reveal-ready main > section:not(#hero) > div:first-child.is-in > *:nth-child(3) {
        transition-delay: 0.2s;
      }
      .reveal-ready main > section:not(#hero) > div:first-child.is-in > *:nth-child(4) {
        transition-delay: 0.3s;
      }
      .reveal-ready main > section:not(#hero) > div:first-child.is-in > *:nth-child(n + 5) {
        transition-delay: 0.4s;
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal-ready main > section:not(#hero) > div:first-child > * {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }
    </style>

    <!-- Marca que há JS para o reveal pré-ocultar antes do paint -->
    <script is:inline>
      document.documentElement.classList.add('reveal-ready');
    </script>

    <!-- Performance optimization script -->
    <script is:inline>
      // Prefetch links on hover for faster navigation
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const link = entry.target;
              const href = link.getAttribute('href');
              if (href && href.startsWith('#')) {
                // Internal anchor, no prefetch needed
                return;
              }
            }
          });
        });

        // Observe all links on the page after DOM loads
        window.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('a[href]').forEach((link) => {
            link.addEventListener('mouseenter', () => {
              const href = link.getAttribute('href');
              if (href && !href.startsWith('#') && !href.startsWith('javascript:')) {
                const linkElem = document.createElement('link');
                linkElem.rel = 'prefetch';
                linkElem.href = href;
                document.head.appendChild(linkElem);
              }
            });
          });
        });
      }
    </script>
    <slot name="head" />
  </head>
  <body class="pb-[92px] lg:pb-0">
    <slot />
    <FloatingWhatsApp />
    <MobileCTABar />
    <CookieConsent />

    <script is:inline>
      // Tracking de CTAs: delega o clique de qualquer link com data-ga-event
      // para o GA4 (window.gtag já é exposto pelo CookieConsent, e o Consent
      // Mode v2 cuida de não enviar nada se o usuário recusar cookies).
      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-ga-event]') : null;
        if (!el || typeof window.gtag !== 'function') return;
        window.gtag('event', el.getAttribute('data-ga-event'), {
          cta_location: el.getAttribute('data-ga-location') || undefined,
          link_url: el.getAttribute('href') || undefined,
          plan: el.getAttribute('data-ga-plan') || undefined,
        });
      });
    </script>

    <script>
      // Reveal on scroll: anima o conteúdo de cada seção ao entrar na viewport
      const targets = Array.from(
        document.querySelectorAll<HTMLElement>('main > section:not(#hero) > div:first-child')
      );
      if (targets.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
