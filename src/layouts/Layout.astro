---
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string;
}

const {
  title = 'Cuidaty - Software para Consultórios e Clínicas | Agenda, Prontuário e WhatsApp',
  description = 'Sistema de gestão para psicólogos, terapeutas e clínicas de saúde. Agenda online, prontuário eletrônico SOAP, automação WhatsApp, controle financeiro e portal de agendamento. Reduza 73% das faltas e economize 8h por semana. Conforme LGPD. A partir de R$80/mês.',
  image = '/screenshot.png',
  noindex = false,
  keywords = 'software para psicólogos, sistema para consultório de psicologia, agenda online psicólogo, prontuário eletrônico psicologia, automação whatsapp consultório, gestão de consultório, sistema para clínicas, agendamento online pacientes, controle financeiro consultório, software para terapeutas, sistema para nutricionistas, gestão de clínica de saúde, prontuário SOAP, lembrete de consulta whatsapp, confirmação de consulta automática, redução de faltas consultório, portal de agendamento online, software LGPD saúde, gestão de pacientes, sistema para fisioterapeutas, plataforma para profissionais de saúde, software consultório online, teleconsulta, gestão clínica integrada, repasse financeiro clínica',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImageURL = new URL(image, Astro.site).toString();

// Structured data: SoftwareApplication
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cuidaty',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '80',
    priceCurrency: 'BRL',
    priceValidUntil: '2026-12-31',
    availability: 'https://schema.org/InStock',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '500',
    bestRating: '5',
    worstRating: '1',
  },
  description: description,
  url: Astro.site,
  featureList: [
    'Automação via WhatsApp',
    'Agenda online personalizada',
    'Prontuário eletrônico completo',
    'Gestão financeira integrada',
    'Redução de 73% em faltas',
    'Economia de 8 horas por semana',
  ],
  screenshot: fullImageURL,
  softwareVersion: '2.0',
  applicationSubCategory: 'HealthcareApplication',
  provider: {
    '@type': 'Organization',
    name: 'Cuidaty',
    url: Astro.site,
    logo: new URL('/logo.svg', Astro.site).toString(),
    slogan: 'Mais que um software, um suporte invisível',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Customer Support',
      availableLanguage: ['Portuguese'],
    },
  },
};

// Structured data: Organization
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Cuidaty',
  url: Astro.site?.toString(),
  logo: new URL('/logo.svg', Astro.site).toString(),
  image: fullImageURL,
  description: 'Sistema de gestão completa para consultórios e clínicas de saúde mental e bem-estar.',
  slogan: 'Mais que um software, um suporte invisível',
  foundingDate: '2024',
  areaServed: {
    '@type': 'Country',
    name: 'Brazil',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Customer Support',
    availableLanguage: ['Portuguese'],
    url: new URL('/#contato', Astro.site).toString(),
  },
  sameAs: [
    'https://www.instagram.com/thetaharpia',
    'https://www.linkedin.com/company/thetaharpia',
    'https://x.com/thetaharpia',
    'https://www.youtube.com/channel/UCBoprCxMDUrZdcvNDwiOBzg',
    'https://thetaharpia.com',
  ],
  parentOrganization: {
    '@type': 'Organization',
    name: 'ThetaHarpia',
    url: 'https://thetaharpia.com',
  },
};

// Structured data: WebSite with SearchAction
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cuidaty',
  url: Astro.site?.toString(),
  description: description,
  inLanguage: 'pt-BR',
  publisher: {
    '@type': 'Organization',
    name: 'Cuidaty',
    logo: new URL('/logo.svg', Astro.site).toString(),
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL('/?q={search_term_string}', Astro.site).toString(),
    },
    'query-input': 'required name=search_term_string',
  },
};

// Structured data: FAQ
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'O que é o Cuidaty?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O Cuidaty é um sistema de gestão completa para consultórios e clínicas de saúde. Oferece automação via WhatsApp, agenda online, prontuário eletrônico e gestão financeira integrada, permitindo que profissionais foquem no que realmente importa: cuidar dos pacientes.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quanto custa o Cuidaty?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O plano individual do Cuidaty custa a partir de R$ 80/mês, incluindo todas as funcionalidades como automação via WhatsApp, agenda online, prontuário eletrônico e gestão financeira. Também oferecemos planos para clínicas e hospitais sob consulta.',
      },
    },
    {
      '@type': 'Question',
      name: 'O Cuidaty ajuda a reduzir faltas de pacientes?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim! Com o sistema de confirmações e lembretes automáticos via WhatsApp, o Cuidaty reduz em até 73% as faltas dos pacientes, economizando tempo e maximizando a receita do consultório.',
      },
    },
    {
      '@type': 'Question',
      name: 'O Cuidaty é seguro e está em conformidade com a LGPD?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim. O Cuidaty segue todas as regulamentações da LGPD e demais normas profissionais de saúde. Seus dados e de seus pacientes são protegidos com criptografia e práticas de segurança de nível empresarial.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quais profissionais podem usar o Cuidaty?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O Cuidaty é ideal para psicólogos, terapeutas, nutricionistas, fisioterapeutas, médicos e outros profissionais de saúde que trabalham em consultório individual, clínicas com múltiplos profissionais ou grandes operações hospitalares.',
      },
    },
  ],
};

// Combine all structured data
const structuredData = [softwareSchema, organizationSchema, websiteSchema, faqSchema];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- DNS Prefetch and Preconnect for Performance -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload Critical Resources -->
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Arapey:ital@0;1&family=Poppins:wght@300;400;500;600;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
      fetchpriority="high"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Arapey:ital@0;1&family=Poppins:wght@300;400;500;600;700&display=swap"
      />
    </noscript>



    <!-- Favicons and Icons -->
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#356588" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cuidaty" />

    <!-- Additional Meta Tags -->
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Cuidaty" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <meta name="language" content="Portuguese" />
    <meta name="revisit-after" content="7 days" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />

    <!-- Search Engine Verification (replace with actual values) -->
    <!-- <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" /> -->
    <!-- <meta name="msvalidate.01" content="YOUR_BING_VERIFICATION_CODE" /> -->

    <!-- OpenSearch -->
    <link rel="search" type="application/opensearchdescription+xml" title="Cuidaty" href="/opensearch.xml" />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Alternate / hreflang -->
    <link rel="alternate" hreflang="pt-BR" href={canonicalURL.toString()} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.toString()} />

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      noindex={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: fullImageURL,
          url: canonicalURL.toString(),
        },
        optional: {
          description: description,
          siteName: 'Cuidaty',
          locale: 'pt_BR',
        },
        image: {
          url: fullImageURL,
          secureUrl: fullImageURL,
          type: 'image/png',
          width: 1200,
          height: 630,
          alt: 'Cuidaty - Software para psicólogos e clínicas com agenda online, prontuário eletrônico e automação WhatsApp',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@thetaharpia',
        creator: '@thetaharpia',
        title: title,
        description: description,
        image: fullImageURL,
        imageAlt: 'Cuidaty - Software para psicólogos e clínicas com agenda online, prontuário eletrônico e automação WhatsApp',
      }}
    />

    <!-- Structured Data (JSON-LD) -->
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Inline critical CSS for font loading -->
    <style>
      /* Font loading optimization */
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: local('Poppins');
      }
      @font-face {
        font-family: 'Lora';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: local('Lora');
      }

      /* Prevent layout shift for images */
      img {
        content-visibility: auto;
      }

      /* Smooth scroll behavior */
      html {
        scroll-behavior: smooth;
      }

      /* Critical above-the-fold styles */
      body {
        margin: 0;
        padding: 0;
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Prevent FOUC (Flash of Unstyled Content) */
      .astro-route-announcer {
        position: absolute;
        left: -10000px;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }

      /* Header height reservation to prevent CLS */
      header {
        min-height: 72px;
      }
    </style>

    <!-- Performance optimization script -->
    <script is:inline>
      // Prefetch links on hover for faster navigation
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const link = entry.target;
              const href = link.getAttribute('href');
              if (href && href.startsWith('#')) {
                // Internal anchor, no prefetch needed
                return;
              }
            }
          });
        });

        // Observe all links on the page after DOM loads
        window.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('a[href]').forEach((link) => {
            link.addEventListener('mouseenter', () => {
              const href = link.getAttribute('href');
              if (href && !href.startsWith('#') && !href.startsWith('javascript:')) {
                const linkElem = document.createElement('link');
                linkElem.rel = 'prefetch';
                linkElem.href = href;
                document.head.appendChild(linkElem);
              }
            });
          });
        });
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
