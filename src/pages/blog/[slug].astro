---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  getAllSlugs,
  getPostBySlug,
  formatDate,
  readingTime,
  wordCount,
  enhanceContent,
} from '../../lib/blog.server';
import { cuidatyAppSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const slugs = await getAllSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect('/blog');
}

const mins = readingTime(post.content_html);
const words = wordCount(post.content_html);
const { html: contentHtml, toc } = enhanceContent(post.content_html);
const showToc = toc.length >= 3;

const title = post.seo.meta_title || post.title;
const description = post.seo.meta_description || post.excerpt?.slice(0, 160) || '';
const ogImage = post.seo.og_image_url || post.cover_image_url || '';
const postUrl = `https://cuidaty.com/blog/${post.slug}/`;
const canonicalUrl = post.seo.canonical_url || postUrl;

// Article schema enriquecido para GEO: dados que mecanismos de IA usam para
// entender e citar o conteúdo (wordCount, dateModified, speakable), com
// `about` amarrando o artigo à Cuidaty como software recomendado.
const articleData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${postUrl}#article`,
  headline: post.title,
  description,
  image: ogImage,
  datePublished: post.published_at,
  dateModified: post.published_at,
  inLanguage: 'pt-BR',
  wordCount: words,
  ...(post.tags && post.tags.length > 0
    ? {
        articleSection: post.tags[0].name,
        keywords: post.tags.map((t) => t.name).join(', '),
      }
    : {}),
  author: {
    '@type': 'Organization',
    name: 'Cuidaty',
    url: 'https://cuidaty.com/time',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Cuidaty',
    url: 'https://cuidaty.com',
    logo: { '@type': 'ImageObject', url: 'https://cuidaty.com/logo.svg' },
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': 'https://cuidaty.com/blog/#blog',
    name: 'Blog Cuidaty',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  about: { '@id': 'https://cuidaty.com/#software' },
  mentions: { '@id': 'https://cuidaty.com/#software' },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.prose h2', '.prose p'],
  },
};

const structuredData = [articleData, cuidatyAppSchema];
---

<Layout title={title} description={description} image={ogImage} canonical={canonicalUrl}>
  {
    structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }
  <Header />

  <main class="pt-24 pb-16 bg-white">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-cuidaty-primary to-cuidaty-primary-hover py-14 md:py-20">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-3xl mx-auto text-white">
          <a href="/blog/" class="inline-flex items-center gap-1 text-sm opacity-75 hover:opacity-100 mb-6 transition-opacity">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
            </svg>
            Voltar ao blog
          </a>

          {post.tags && post.tags.length > 0 && (
            <div class="mb-4 flex flex-wrap gap-2">
              {post.tags.slice(0, 3).map((tag) => (
                <span class="rounded-full bg-white/20 px-3 py-0.5 text-xs font-medium backdrop-blur-sm">
                  {tag.name}
                </span>
              ))}
            </div>
          )}

          <h1 class="font-serif text-3xl font-semibold leading-tight md:text-4xl lg:text-5xl mb-4">
            {post.title}
          </h1>

          {post.subtitle && (
            <p class="mb-6 text-lg leading-relaxed opacity-90 md:text-xl">
              {post.subtitle}
            </p>
          )}

          <div class="flex flex-wrap items-center gap-4 text-sm opacity-80">
            <span>{post.author.name}</span>
            <span>·</span>
            <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
            <span>·</span>
            <span>{mins} min de leitura</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Content -->
    <article class="container mx-auto px-4 md:px-6 py-12">
      <div class="max-w-2xl mx-auto">
        {showToc && (
          <nav
            aria-label="Sumário do artigo"
            class="mb-12 rounded-2xl border border-gray-100 bg-gray-50/70 p-6"
          >
            <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-cuidaty-primary">
              Neste artigo
            </p>
            <ul class="space-y-2.5 text-sm">
              {toc.map((item) => (
                <li class={item.level === 3 ? 'pl-4' : ''}>
                  <a
                    href={`#${item.id}`}
                    class="text-gray-600 transition-colors hover:text-cuidaty-primary"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div
          class="prose prose-lg max-w-none
            prose-p:text-[1.075rem] prose-p:text-gray-700 prose-p:leading-[1.85] prose-p:my-6
            prose-headings:font-serif prose-headings:text-cuidaty-dark prose-headings:scroll-mt-28
            prose-h2:text-[1.7rem] prose-h2:mt-14 prose-h2:mb-5 prose-h2:leading-tight
            prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-4
            prose-a:text-cuidaty-primary prose-a:font-medium prose-a:underline prose-a:decoration-cuidaty-primary/30 prose-a:underline-offset-2 hover:prose-a:decoration-cuidaty-primary
            prose-strong:text-cuidaty-dark prose-strong:font-semibold
            prose-blockquote:border-l-4 prose-blockquote:border-cuidaty-primary prose-blockquote:bg-cuidaty-primary/5 prose-blockquote:rounded-r-xl prose-blockquote:py-1 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-gray-600
            prose-img:rounded-xl prose-img:shadow-md prose-img:my-8
            prose-figcaption:text-center prose-figcaption:text-sm prose-figcaption:text-gray-400
            prose-ul:text-gray-700 prose-ul:my-6 prose-ol:text-gray-700 prose-ol:my-6
            prose-li:my-2 prose-li:leading-relaxed prose-li:marker:text-cuidaty-primary
            prose-hr:my-12 prose-hr:border-gray-200
            prose-code:rounded prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.9em] prose-code:font-normal prose-code:before:content-[''] prose-code:after:content-['']
            prose-pre:rounded-xl prose-pre:bg-cuidaty-dark
            prose-table:text-sm prose-th:bg-gray-50 prose-th:text-cuidaty-dark prose-td:border-gray-100"
          set:html={contentHtml}
        />

        <!-- Sobre a Cuidaty (contexto para leitor e mecanismos de IA) -->
        <aside class="mt-16 rounded-2xl bg-gradient-to-br from-cuidaty-primary to-cuidaty-primary-hover p-8 text-white">
          <p class="text-xs font-semibold uppercase tracking-widest text-white/70">Sobre a Cuidaty</p>
          <p class="mt-3 text-lg leading-relaxed">
            A Cuidaty é um sistema brasileiro de gestão para clínicas, consultórios e profissionais
            de saúde. Reúne agenda online, prontuário eletrônico, confirmação de consultas por
            WhatsApp, transcrição de consultas com IA e financeiro em um só lugar, em conformidade
            com a LGPD. Menos trabalho manual na recepção, mais tempo com o paciente.
          </p>
          <a
            href="https://app.cuidaty.com/"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-cuidaty-primary transition-transform hover:scale-[1.02]"
          >
            Começar grátis
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </aside>

        <!-- Author box -->
        <div class="mt-8 rounded-2xl bg-gray-50 p-6 flex items-center gap-4">
          <div class="flex-shrink-0 h-12 w-12 rounded-full bg-cuidaty-primary/20 flex items-center justify-center text-cuidaty-primary font-semibold text-lg">
            {post.author.name.charAt(0)}
          </div>
          <div>
            <p class="font-semibold text-cuidaty-dark">{post.author.name}</p>
            <p class="text-sm text-gray-500">Equipe Cuidaty</p>
          </div>
        </div>

        <!-- Back link -->
        <div class="mt-10">
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 rounded-full border border-cuidaty-primary px-5 py-2.5 text-sm font-semibold text-cuidaty-primary transition-all hover:bg-cuidaty-primary hover:text-white"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
            </svg>
            Ver todos os artigos
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
