---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  getAllSlugs,
  getPostBySlug,
  formatDate,
  readingTime,
  wordCount,
  enhanceContent,
  isNewsPost,
  isOrganizationAuthor,
} from '../../lib/blog.server';
import { cuidatyAppSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const slugs = await getAllSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect('/blog');
}

const mins = readingTime(post.content_html);
const words = wordCount(post.content_html);
const { html: contentHtml, toc } = enhanceContent(post.content_html);
const showToc = toc.length >= 3;

const title = post.seo.meta_title || post.title;
const description = post.seo.meta_description || post.excerpt?.slice(0, 160) || '';
const ogImage = post.seo.og_image_url || post.cover_image_url || '';
// Alt específico do post: o preview social e os leitores de tela recebem o
// assunto do artigo em vez da descrição genérica do produto.
const ogImageAlt = post.subtitle
  ? `Capa do artigo ${post.title}. ${post.subtitle}. Blog da Cuidaty.`
  : `Capa do artigo ${post.title}. Blog da Cuidaty.`;
const postUrl = `https://cuidaty.com/blog/${post.slug}/`;
const canonicalUrl = post.seo.canonical_url || postUrl;

// Article schema enriquecido para GEO: dados que mecanismos de IA usam para
// entender e citar o conteúdo (wordCount, dateModified, speakable), com
// `about` amarrando o artigo à Cuidaty como software recomendado.
// `NewsArticle` só para posts factuais e datados (marcados por tag de
// notícia). Conteúdo perene continua como `Article`: declarar tudo como
// notícia é o sinal que derruba a confiança do publisher no Google News.
const isNews = isNewsPost(post);

// Byline com pessoa real quando existe. O Google trata autoria identificada
// como sinal de qualidade, e no News ela é praticamente pré-requisito.
const authorData = isOrganizationAuthor(post.author?.name)
  ? {
      '@type': 'Organization',
      name: 'Cuidaty',
      url: 'https://cuidaty.com/time',
    }
  : {
      '@type': 'Person',
      name: post.author.name,
      url: 'https://cuidaty.com/time',
    };

const articleData = {
  '@context': 'https://schema.org',
  '@type': isNews ? 'NewsArticle' : 'Article',
  '@id': `${postUrl}#article`,
  headline: post.title,
  description,
  image: ogImage,
  datePublished: post.published_at,
  dateModified: post.published_at,
  inLanguage: 'pt-BR',
  wordCount: words,
  ...(post.tags && post.tags.length > 0
    ? {
        articleSection: post.tags[0].name,
        keywords: post.tags.map((t) => t.name).join(', '),
      }
    : {}),
  author: authorData,
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: 'Cuidaty',
    url: 'https://cuidaty.com',
    logo: { '@type': 'ImageObject', url: 'https://cuidaty.com/logo.svg' },
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': 'https://cuidaty.com/blog/#blog',
    name: 'Blog Cuidaty',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  about: { '@id': 'https://cuidaty.com/#software' },
  mentions: { '@id': 'https://cuidaty.com/#software' },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.prose h2', '.prose p'],
  },
};

const structuredData = [articleData, cuidatyAppSchema];
---

<Layout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={ogImageAlt}
  canonical={canonicalUrl}
>
  {
    structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }
  <Header />

  <main class="bg-white pb-16 pt-24">
    <!-- Hero -->
    <section class="bg-cuidaty-accent-light py-14 md:py-20">
      <div class="container mx-auto px-4 md:px-6">
        <div class="mx-auto max-w-3xl text-cuidaty-dark">
          <a
            href="/blog/"
            class="focus-ring group mb-8 inline-flex items-center gap-2 rounded-sm text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-dark/55 transition-colors hover:text-cuidaty-dark"
          >
            <svg
              class="h-4 w-4 transition-transform duration-300 ease-out group-hover:-translate-x-1"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 10H4.5M9 5.5 4.5 10 9 14.5"></path>
            </svg>
            Voltar ao blog
          </a>

          {
            post.tags && post.tags.length > 0 && (
              <p class="mb-5 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-dark/50">
                {post.tags
                  .slice(0, 3)
                  .map((tag) => tag.name)
                  .join(' · ')}
              </p>
            )
          }

          <h1
            class="mb-5 font-serif text-3xl font-semibold leading-[1.25] md:text-4xl md:leading-[1.2] lg:text-[2.7rem]"
          >
            {post.title}
          </h1>

          {
            post.subtitle && (
              <p class="mb-8 text-lg leading-relaxed text-cuidaty-dark/70 md:text-xl">
                {post.subtitle}
              </p>
            )
          }

          <div
            class="flex flex-wrap items-center gap-3 border-t border-cuidaty-dark/10 pt-5 text-sm text-cuidaty-dark/55"
          >
            <span class="font-medium text-cuidaty-dark/80">{post.author.name}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
            <span aria-hidden="true">·</span>
            <span>{mins} min de leitura</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Content -->
    <article class="container mx-auto px-4 py-12 md:px-6">
      <div class="mx-auto max-w-2xl">
        {
          showToc && (
            <nav
              aria-label="Sumário do artigo"
              class="mb-14 rounded-2xl bg-cuidaty-accent-light/60 p-7"
            >
              <p class="mb-4 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-dark/55">
                Neste artigo
              </p>
              <ul class="space-y-3 text-[0.95rem]">
                {toc.map((item) => (
                  <li class={item.level === 3 ? 'pl-4' : ''}>
                    <a
                      href={`#${item.id}`}
                      class="text-cuidaty-dark/75 underline decoration-cuidaty-dark/15 underline-offset-4 transition-colors hover:text-cuidaty-dark hover:decoration-cuidaty-secondary"
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div
          class="prose prose-lg max-w-none prose-headings:scroll-mt-28 prose-headings:font-serif prose-headings:font-semibold prose-headings:text-cuidaty-dark prose-h2:mb-5 prose-h2:mt-16 prose-h2:text-[1.75rem] prose-h2:leading-tight prose-h3:mb-4 prose-h3:mt-10 prose-h3:text-xl prose-p:my-6 prose-p:text-[1.1rem] prose-p:leading-[1.9] prose-p:text-cuidaty-dark/80 prose-a:font-medium prose-a:text-cuidaty-dark prose-a:underline prose-a:decoration-cuidaty-secondary prose-a:decoration-2 prose-a:underline-offset-4 hover:prose-a:bg-cuidaty-accent-light prose-blockquote:rounded-r-xl prose-blockquote:border-l-4 prose-blockquote:border-cuidaty-secondary prose-blockquote:bg-cuidaty-accent-light/50 prose-blockquote:px-7 prose-blockquote:py-1 prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-cuidaty-dark/75 prose-figcaption:mt-3 prose-figcaption:text-center prose-figcaption:text-sm prose-figcaption:leading-relaxed prose-figcaption:text-cuidaty-dark/45 prose-strong:font-semibold prose-strong:text-cuidaty-dark prose-code:rounded prose-code:bg-cuidaty-accent-light prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.9em] prose-code:font-normal prose-code:before:content-[''] prose-code:after:content-[''] prose-pre:rounded-xl prose-pre:bg-cuidaty-dark prose-ol:my-6 prose-ol:text-cuidaty-dark/80 prose-ul:my-6 prose-ul:text-cuidaty-dark/80 prose-li:my-2 prose-li:leading-[1.8] prose-li:marker:text-cuidaty-secondary prose-table:text-sm prose-th:bg-cuidaty-accent-light/60 prose-th:text-cuidaty-dark prose-td:border-cuidaty-dark/10 prose-img:my-8 prose-img:rounded-xl prose-hr:my-14 prose-hr:border-cuidaty-dark/10"
          set:html={contentHtml}
        />

        <!-- Sobre a Cuidaty (contexto para leitor e mecanismos de IA) -->
        <aside class="mt-20 rounded-2xl bg-cuidaty-dark p-8 text-white md:p-10">
          <p
            class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-accent-light"
          >
            Sobre a Cuidaty
          </p>
          <p class="mt-3 text-lg leading-relaxed">
            A Cuidaty é um sistema brasileiro de gestão para clínicas, consultórios e profissionais
            de saúde. Reúne agenda online, prontuário eletrônico, confirmação de consultas por
            WhatsApp, transcrição de consultas com IA e financeiro em um só lugar, em conformidade
            com a LGPD. Menos trabalho manual na recepção, mais tempo com o paciente.
          </p>
          <a
            href="https://app.cuidaty.com/register"
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="generate_lead"
            data-ga-location="blog_post"
            class="group mt-7 inline-flex items-center gap-2 rounded-full bg-cuidaty-accent-light px-6 py-3 text-sm font-semibold text-cuidaty-dark transition-transform hover:scale-[1.02]"
          >
            Começar grátis
            <svg
              class="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 10h11.5M11 5.5 15.5 10 11 14.5"></path>
            </svg>
          </a>
          <p class="mt-5 text-sm text-white/80">
            Já usa a plataforma? Os tutoriais de cada recurso estão na
            <a
              href="https://ajuda.cuidaty.com"
              target="_blank"
              rel="noopener"
              class="font-semibold text-white underline underline-offset-4"
            >
              Central de Ajuda da Cuidaty
            </a>.
          </p>
        </aside>

        <!-- Author box -->
        <div class="mt-8 flex items-center gap-4 rounded-2xl border border-cuidaty-dark/[0.08] p-6">
          <div
            class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-cuidaty-accent-light font-serif text-lg font-semibold text-cuidaty-dark"
          >
            {post.author.name.charAt(0)}
          </div>
          <div>
            <p class="font-semibold text-cuidaty-dark">{post.author.name}</p>
            <p class="text-sm text-cuidaty-dark/50">Equipe Cuidaty</p>
          </div>
        </div>

        <!-- Back link -->
        <div class="mt-10">
          <a
            href="/blog/"
            class="group inline-flex items-center gap-2 rounded-full border border-cuidaty-dark/15 px-5 py-2.5 text-sm font-semibold text-cuidaty-dark transition-colors hover:bg-cuidaty-accent-light"
          >
            <svg
              class="h-4 w-4 transition-transform duration-300 ease-out group-hover:-translate-x-1"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 10H4.5M9 5.5 4.5 10 9 14.5"></path>
            </svg>
            Ver todos os artigos
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
