---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogPostsGrid from '../../components/BlogPostsGrid.astro';
import { getAllPosts } from '../../lib/blog.server';
import type { BlogPost, BlogMeta } from '../../lib/blog.server';

let posts: BlogPost[] = [];
let meta: BlogMeta | null = null;

try {
  const result = await getAllPosts(1);
  posts = result.posts;
  meta = result.meta;
} catch {
  posts = [];
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Cuidaty',
  description: 'Conteúdo sobre psicologia, gestão clínica e cuidado com quem cuida.',
  url: 'https://cuidaty.com/blog/',
  publisher: {
    '@type': 'Organization',
    name: 'Cuidaty',
    url: 'https://cuidaty.com',
    logo: { '@type': 'ImageObject', url: 'https://cuidaty.com/logo.svg' },
  },
};
---

<Layout
  title="Blog Cuidaty | Psicologia, Gestão Clínica e Saúde Mental"
  description="Artigos sobre psicologia, gestão de consultório, saúde mental e cuidado com profissionais da saúde. Conteúdo produzido pela equipe Cuidaty."
  keywords="blog psicologia, gestão clínica, saúde mental, profissionais de saúde, consultório, cuidaty"
>
  <Fragment slot="head">
    {meta && meta.last_page > 1 && <link rel="next" href="/blog/page/2/" />}
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Header />

  <main class="bg-white pb-8 pt-20">
    <section class="bg-cuidaty-accent-light">
      <div class="container mx-auto px-4 md:px-6">
        <div
          class="mx-auto grid max-w-6xl gap-6 py-16 md:grid-cols-[1.35fr_1fr] md:items-start md:gap-16 md:py-24"
        >
          <div>
            <p
              class="mb-6 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-cuidaty-dark/50"
            >
              Blog Cuidaty
            </p>
            <h1
              class="max-w-2xl font-serif text-[2rem] font-normal leading-[1.18] text-cuidaty-dark md:text-[2.75rem] lg:text-5xl"
            >
              Informação, inovação e reflexão para profissionais e gestores da saúde
            </h1>
            <a
              href="#artigos"
              class="focus-ring group mt-10 inline-flex items-center gap-3 rounded-sm text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-dark"
            >
              <svg
                class="h-5 w-5 transition-transform duration-300 ease-out group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 10h13M11.5 5 16.5 10 11.5 15"></path>
              </svg>
              Ver todos os artigos
            </a>
          </div>

          <p
            class="text-lg leading-relaxed text-cuidaty-dark/70 md:pt-14 md:text-xl md:leading-relaxed"
          >
            <span class="sr-only">Conteúdo selecionado para quem tem fome de conhecer.</span>
            <span id="blog-typewriter" aria-hidden="true"
              >Conteúdo selecionado para quem tem fome de conhecer.</span
            ><span
              aria-hidden="true"
              class="ml-0.5 inline-block h-[1.05em] w-[2px] animate-pulse bg-cuidaty-dark/40 align-middle"
            ></span>
          </p>
        </div>
      </div>
    </section>

    <div id="artigos" class="scroll-mt-24"></div>
    <BlogPostsGrid posts={posts} meta={meta} />
  </main>

  <Footer />

  <script>
    const el = document.getElementById('blog-typewriter');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (el && !prefersReducedMotion) {
      const text = el.textContent || '';
      el.textContent = '';
      let i = 0;
      const type = () => {
        el.textContent = text.slice(0, i);
        i++;
        if (i <= text.length) setTimeout(type, 32);
      };
      setTimeout(type, 500);
    }
  </script>
</Layout>
