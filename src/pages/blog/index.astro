---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getAllPosts, BLOG_URL } from '../../lib/blog.server';
import type { BlogPost, BlogMeta } from '../../lib/blog.server';

let posts: BlogPost[] = [];
let meta: BlogMeta | null = null;

try {
  const result = await getAllPosts(1);
  posts = result.posts;
  meta = result.meta;
} catch {
  posts = [];
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Cuidaty',
  description: 'Conteúdo sobre psicologia, gestão clínica e cuidado com quem cuida.',
  url: `${BLOG_URL}/`,
  publisher: {
    '@type': 'Organization',
    name: 'Cuidaty',
    url: 'https://cuidaty.com',
    logo: { '@type': 'ImageObject', url: 'https://cuidaty.com/logo.svg' },
  },
};
---

<Layout
  title="Blog Cuidaty | Psicologia, Gestão Clínica e Saúde Mental"
  description="Artigos sobre psicologia, gestão de consultório, saúde mental e cuidado com profissionais da saúde. Conteúdo produzido pela equipe Cuidaty."
  keywords="blog psicologia, gestão clínica, saúde mental, profissionais de saúde, consultório, cuidaty"
  canonicalURL={`${BLOG_URL}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Header />

  <main class="pt-24 pb-16 bg-white">
    <section class="overflow-hidden bg-gradient-to-br from-cuidaty-primary to-cuidaty-primary-hover">
      <div class="container mx-auto px-4 md:px-6">
        <div class="mx-auto grid max-w-5xl items-center gap-10 py-16 md:grid-cols-[1.1fr_0.9fr] md:py-20 lg:gap-16">
          <div class="text-center text-white md:text-left">
            <p class="mb-3 text-sm font-semibold uppercase tracking-widest opacity-80">Conteúdo que cuida</p>
            <h1 class="mb-4 font-serif text-4xl font-semibold md:text-5xl">Blog Cuidaty</h1>
            <p class="min-h-[3.5rem] text-lg leading-relaxed opacity-90 md:max-w-md md:min-h-[4rem]">
              <span class="sr-only">Aqui você encontra informação que cuida de quem cuida.</span>
              <span id="blog-typewriter" aria-hidden="true">Aqui você encontra informação que cuida de quem cuida.</span><span
                aria-hidden="true"
                class="ml-0.5 inline-block h-[1.1em] w-[2px] animate-pulse bg-white/70 align-middle"
              ></span>
            </p>
          </div>
          <div class="relative mx-auto h-64 w-full max-w-md md:h-80 md:max-w-none">
            <div class="absolute right-0 top-0 w-[64%] max-w-sm -rotate-2 rounded-2xl bg-white p-2.5 shadow-lifted transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:hover:rotate-0">
              <img
                src="/doctor-desk.png"
                alt=""
                width="864"
                height="576"
                class="aspect-[3/2] w-full rounded-xl object-contain"
              />
            </div>
            <div class="absolute bottom-0 left-0 w-[52%] max-w-xs rotate-3 rounded-2xl bg-white p-2.5 shadow-lifted transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:hover:rotate-0">
              <img
                src="/therapist-session.png"
                alt=""
                width="864"
                height="576"
                class="aspect-[3/2] w-full rounded-xl object-contain"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container mx-auto px-4 md:px-6 py-16">
      <div class="max-w-6xl mx-auto">
        {meta && (
          <p class="text-sm text-gray-400 mb-10">
            {meta.total} {meta.total === 1 ? 'artigo' : 'artigos'} publicados
          </p>
        )}

        {posts.length > 0 ? (
          <div class="stagger-cards grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogCard post={post} headingLevel="h2" />
            ))}
          </div>
        ) : (
          <div class="text-center py-20 text-gray-500">
            <p class="text-lg">Nenhum artigo publicado ainda.</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const el = document.getElementById('blog-typewriter');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (el && !prefersReducedMotion) {
      const text = el.textContent || '';
      el.textContent = '';
      let i = 0;
      const type = () => {
        el.textContent = text.slice(0, i);
        i++;
        if (i <= text.length) setTimeout(type, 32);
      };
      setTimeout(type, 500);
    }
  </script>
</Layout>
