---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDirectoryClinics, groupByState } from '../lib/clinics.server';

/**
 * Clínicas que usam o Cuidaty e escolheram aparecer aqui. A lista vem da API do
 * app, então muda sem novo deploy. Lista vazia não é indexada: página fina só
 * atrapalha o resto do site no Google.
 */
const clinics = await getDirectoryClinics();
const groups = groupByState(clinics);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=600, stale-while-revalidate=3600');

const pageUrl = new URL('/clinicas', Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Clínicas que usam o Cuidaty',
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: 'Cuidaty', url: Astro.site?.toString() },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: clinics.length,
    itemListElement: clinics.map((clinic, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'MedicalClinic',
        name: clinic.name,
        url: clinic.url,
        ...(clinic.city || clinic.state
          ? {
              address: {
                '@type': 'PostalAddress',
                ...(clinic.city ? { addressLocality: clinic.city } : {}),
                ...(clinic.state ? { addressRegion: clinic.state } : {}),
                addressCountry: 'BR',
              },
            }
          : {}),
      },
    })),
  },
};
---

<Layout
  title="Clínicas que usam o Cuidaty | Cuidaty"
  description="Conheça clínicas e consultórios que usam o Cuidaty para agendar online e cuidar dos pacientes. Encontre o site da clínica na sua cidade."
  keywords="clínicas que usam Cuidaty, clínicas com agendamento online, consultórios com agenda online"
  noindex={clinics.length === 0}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />

  <Header />
  <main class="bg-white">
    <header class="border-b border-border">
      <div class="container mx-auto px-5 md:px-8">
        <div class="mx-auto max-w-3xl pb-12 pt-32 md:pb-16 md:pt-40">
          <p class="mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-cuidaty-primary">
            Quem usa a Cuidaty
          </p>
          <h1
            class="font-serif text-5xl font-semibold leading-[1.02] tracking-tight text-cuidaty-dark md:text-7xl"
          >
            Clínicas
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-foreground/70">
            Consultórios e clínicas que agendam online pelo próprio site, feito na Cuidaty. Escolha
            a sua cidade e abra o site da clínica.
          </p>
        </div>
      </div>
    </header>

    <section class="bg-white">
      <div class="container mx-auto px-5 py-16 md:px-8 md:py-24">
        <div class="mx-auto max-w-3xl">
          {
            groups.length === 0 ? (
              <p class="text-lg leading-relaxed text-foreground/70">
                As primeiras clínicas aparecem aqui em breve.
              </p>
            ) : (
              groups.map((group) => (
                <section class="mb-14 last:mb-0" aria-labelledby={`uf-${group.state}`}>
                  <h2
                    id={`uf-${group.state}`}
                    class="border-b border-border pb-3 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-secondary"
                  >
                    {group.state}
                  </h2>
                  <ul class="divide-y divide-border">
                    {group.clinics.map((clinic) => (
                      <li>
                        <a
                          href={clinic.url}
                          rel="noopener"
                          class="group flex items-center gap-4 py-5 transition-colors hover:bg-beige/50"
                        >
                          {clinic.logoUrl ? (
                            <img
                              src={clinic.logoUrl}
                              alt=""
                              width="40"
                              height="40"
                              loading="lazy"
                              decoding="async"
                              class="size-10 shrink-0 object-contain"
                            />
                          ) : (
                            <span class="size-10 shrink-0" aria-hidden="true" />
                          )}
                          <span class="min-w-0 flex-1">
                            <span class="block truncate font-serif text-xl font-semibold text-cuidaty-dark">
                              {clinic.name}
                            </span>
                            {clinic.city && (
                              <span class="block text-sm text-foreground/60">{clinic.city}</span>
                            )}
                          </span>
                          <span
                            class="text-sm font-medium text-cuidaty-primary transition-transform group-hover:translate-x-0.5"
                            aria-hidden="true"
                          >
                            Abrir site
                          </span>
                          <span class="sr-only">{`Abrir o site de ${clinic.name}`}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            )
          }
        </div>
      </div>
    </section>

    <section class="bg-cuidaty-dark py-16 md:py-24">
      <div class="container mx-auto px-5 md:px-8">
        <div class="mx-auto max-w-3xl">
          <h2 class="font-serif text-3xl font-semibold leading-tight text-white md:text-4xl">
            Quer o site da sua clínica aqui?
          </h2>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/75">
            Crie o site da clínica com a Cuidaty, com agendamento online, e escolha aparecer nesta
            lista nas configurações do portal.
          </p>
          <a
            href="https://app.cuidaty.com"
            class="mt-8 inline-flex rounded-lg bg-white px-6 py-3 text-sm font-semibold text-cuidaty-dark transition-opacity hover:opacity-90"
          >
            Começar grátis
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
