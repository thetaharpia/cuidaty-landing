---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MidasLogo from '../components/MidasLogo.astro';
import logoWritten from '../assets/logo-written.webp';
import { MIDAS_URL, whatsappUrl } from '../lib/contact';
import { PROPOSAL_URL, REGISTER_URL } from '../lib/plans';

/**
 * Os dois produtos da casa lado a lado: a Cuidaty (sistema de gestão) e o
 * MIDAS (gestão comercial). Página estática e indexável para quem pesquisa
 * pelos dois nomes ou quer entender a diferença entre eles. O detalhe de cada
 * um continua na home da Cuidaty e em midas.cuidaty.com.
 */
const MIDAS_WA_URL = whatsappUrl(
  'Olá! Quero entender como o MIDAS pode aumentar o faturamento da minha clínica.'
);

const cuidaty = {
  does: [
    'Agenda online com confirmação e lembrete automáticos no WhatsApp',
    'Prontuário eletrônico com anamnese, evolução e anexos',
    'Transcrição da consulta com IA e resumo clínico pronto',
    'Financeiro e guias de convênio no plano Clínicas e Grupos',
  ],
  audience: 'Psicólogos, consultórios e clínicas de saúde.',
  pricing:
    'Plano gratuito para até 10 pacientes. Planos pagos a partir de R$ 69,90 por mês. Clínicas e Grupos sob consulta.',
};

const midas = {
  does: [
    'Roteiros de WhatsApp e telefone para a recepção',
    'Orçamentos em aberto com responsável e prazo de retorno',
    'Anúncios no Meta e no Google medidos pela venda que trazem',
    'MIDAS Vision: CRM e funil da clínica',
  ],
  audience: 'Clínicas e consultórios de qualquer área da saúde que querem vender mais.',
  pricing:
    'Mensalidade e comissão sobre as vendas novas. Não há tabela pública: os valores saem depois do diagnóstico.',
};

// Caminho do paciente, do anúncio ao financeiro. Cada grupo é um produto e
// `at` é a posição da etapa na linha (0 a 5), usada para sincronizar a animação.
const journey = [
  {
    product: 'MIDAS',
    caption: 'até o paciente fechar',
    stages: [
      {
        at: 0,
        stage: 'Anúncio',
        text: 'Campanhas no Meta e no Google, avaliadas pela venda que trazem.',
        icon: 'M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1zM15 9a3 3 0 0 1 0 6M18 6a7 7 0 0 1 0 12',
      },
      {
        at: 1,
        stage: 'Primeiro contato',
        text: 'Roteiro de WhatsApp e telefone para quem atende, com meta individual.',
        icon: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z',
      },
      {
        at: 2,
        stage: 'Orçamento',
        text: 'Cada orçamento parado tem um responsável e uma data para o retorno.',
        icon: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h4',
      },
    ],
  },
  {
    product: 'Cuidaty',
    caption: 'do agendamento em diante',
    stages: [
      {
        at: 3,
        stage: 'Agendamento',
        text: 'Agenda online, com confirmação e lembrete enviados no WhatsApp.',
        icon: 'M4 6h16v15H4zM4 10h16M8 3v4M16 3v4M9 15l2 2 4-4',
      },
      {
        at: 4,
        stage: 'Consulta',
        text: 'Prontuário eletrônico e transcrição da consulta com IA.',
        icon: 'M9 4h6v3H9zM7 5H5v16h14V5h-2M9 12h6M9 16h4',
      },
      {
        at: 5,
        stage: 'Financeiro',
        text: 'Faturas, caixa e guias de convênio conferidas antes do envio.',
        icon: 'M12 3v18M16 7.5c0-1.7-1.8-2.5-4-2.5s-4 1-4 2.8c0 4 8 2 8 6 0 1.8-1.8 2.7-4 2.7s-4-1-4-2.7',
      },
    ],
  },
] as const;

// A linha leva LINE_SECONDS para ir da primeira à última etapa: cada etapa
// aparece quando a linha chega nela.
const LINE_SECONDS = 2.4;
const stageDelay = (at: number) => `${(0.2 + (at / 5) * LINE_SECONDS).toFixed(2)}s`;

// Um caso real de cada produto. O da Cuidaty vem da home (Proof.astro) e o do
// MIDAS do site dele (src/data/proof.ts): só entra aqui o que já está publicado lá.
const proofs = [
  {
    product: 'Cuidaty',
    metric: '+200',
    metricLabel: 'profissionais de saúde usando a Cuidaty',
    quote:
      'A Cuidaty trouxe organização para a gestão da nossa clínica, assertividade e agilidade.',
    photo: '/testimonials/giovana.webp',
    name: 'Giovana Ferreira',
    role: 'Gestora de atividades clínicas, Startuppsi',
  },
  {
    product: 'MIDAS',
    metric: 'R$ 170 mil',
    metricLabel:
      'a mais no faturamento em um mês, na Sal Clinic, com automação no WhatsApp, Instagram e Facebook e estratégia comercial',
    quote:
      'Nós tivemos um valor de 170 mil reais a mais no nosso faturamento, por uma estratégia exclusiva que nós tivemos dentro do sistema.',
    photo: '/testimonials/bruna-sal-clinic.webp',
    name: 'Bruna',
    role: 'Sal Clinic, São Paulo',
  },
] as const;

// O que acontece depois do clique, em cada produto.
const cuidatySteps = [
  {
    title: 'Crie a conta',
    text: 'O plano gratuito atende até 10 pacientes e não tem prazo para acabar.',
  },
  {
    title: 'Monte a agenda',
    text: 'Cadastre os pacientes e os horários de atendimento.',
  },
  {
    title: 'Atenda',
    text: 'Registre a consulta no prontuário. No plano Plus, a gravação vira o prontuário.',
  },
];
const midasSteps = [
  {
    title: 'Diagnóstico',
    text: 'O time entende a operação, os canais de captação e onde as vendas se perdem.',
  },
  {
    title: 'Planejamento',
    text: 'Prioridades, responsáveis e indicadores. As condições comerciais saem daqui.',
  },
  {
    title: 'Organização e ativação',
    text: 'Equipe treinada, campanhas no ar e o MIDAS Vision com os dados da clínica.',
  },
  {
    title: 'Gestão contínua',
    text: 'O time acompanha a execução e ajusta as ações. Você vê tudo no painel.',
  },
];

const faqs = [
  {
    question: 'Qual é a diferença entre a Cuidaty e o MIDAS?',
    answer:
      'A Cuidaty é um sistema de gestão: agenda, prontuário eletrônico, WhatsApp, transcrição de consultas com IA e financeiro. O MIDAS é um serviço de gestão comercial: um time que trabalha dentro da clínica cuidando do atendimento comercial, dos orçamentos em aberto e dos anúncios. Os dois são do mesmo time.',
  },
  {
    question: 'Preciso contratar os dois?',
    answer:
      'Não. São produtos separados, cada um com seu site e sua contratação. Quem quer organizar o atendimento começa pela Cuidaty. Quem quer aumentar as vendas da clínica fala com o MIDAS.',
  },
  {
    question: 'Quanto custa cada um?',
    answer:
      'A Cuidaty tem plano gratuito para até 10 pacientes e planos pagos a partir de R$ 69,90 por mês. O plano Clínicas e Grupos é sob consulta. O MIDAS não tem tabela pública: cobra uma mensalidade e uma comissão sobre as vendas novas, com valores definidos depois de um diagnóstico da clínica.',
  },
  {
    question: 'Para quem é cada produto?',
    answer:
      'A Cuidaty atende de psicólogos em consultório individual a clínicas multiprofissionais. O MIDAS atende clínicas e consultórios de qualquer área da saúde, como odontologia, estética, fisioterapia, saúde mental e nutrição.',
  },
];

const pageUrl = new URL('/cuidaty-e-midas', Astro.site).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Produtos do time Cuidaty',
    url: pageUrl,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'SoftwareApplication',
          name: 'Cuidaty',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web, iOS, Android',
          url: Astro.site?.toString(),
          description:
            'Sistema de gestão para consultórios e clínicas de saúde: agenda online, prontuário eletrônico, WhatsApp e transcrição de consultas com IA.',
        },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: {
          '@type': 'Service',
          name: 'MIDAS',
          serviceType: 'Gestão comercial para clínicas',
          url: MIDAS_URL,
          areaServed: 'BR',
          description:
            'Gestão comercial para clínicas de saúde: atendimento comercial, acompanhamento de orçamentos, anúncios e CRM.',
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Layout
  title="Cuidaty e MIDAS: sistema de gestão e gestão comercial para clínicas"
  image="/og/cuidaty-e-midas.png"
  description="A Cuidaty organiza agenda, prontuário e financeiro da clínica. O MIDAS cuida das vendas, do primeiro contato ao orçamento fechado. Veja o que cada um faz e quanto custa."
  keywords="Cuidaty e MIDAS, MIDAS Cuidaty, gestão comercial para clínicas, sistema de gestão para clínicas, como vender mais na clínica, CRM para clínicas, software para clínicas"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  {
    /* Liga o motion antes da primeira pintura (sem piscar) e revela cada bloco
       quando ele entra na tela. Sem JS ou com movimento reduzido, nada fica oculto. */
  }
  <script is:inline slot="head">
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('cm-js');
      document.addEventListener('DOMContentLoaded', function () {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -6% 0px' }
        );
        document.querySelectorAll('[data-cm]').forEach(function (el) {
          io.observe(el);
        });
      });
    })();
  </script>

  <Header />
  <main class="bg-white">
    <!-- 1. Abertura: as duas marcas e uma única pergunta para o visitante se localizar -->
    <header>
      <div class="container mx-auto px-5 md:px-8">
        <div
          class="mx-auto grid max-w-7xl gap-12 pb-16 pt-32 md:pt-40 lg:grid-cols-[1.5fr_1fr] lg:items-end lg:gap-16 lg:pb-24"
        >
          <div>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
              <img
                src={logoWritten.src}
                alt="Cuidaty"
                width="314"
                height="82"
                class="cm-load cm-load-left h-10 w-auto md:h-12"
                loading="eager"
              />
              <span
                class="cm-load cm-load-grow h-8 w-px bg-cuidaty-dark/20"
                style="--d:0.25s"
                aria-hidden="true"></span>
              <MidasLogo size={44} id="midas-top" class="cm-load cm-load-right" />
            </div>
            <h1
              class="mt-10 text-4xl leading-[1.05] text-cuidaty-dark md:text-5xl lg:text-[2.4rem] xl:text-5xl"
            >
              <span class="cm-load block" style="--d:0.15s">Cuidaty organiza a clínica.</span>
              <span class="cm-load block" style="--d:0.3s">MIDAS cuida das vendas.</span>
            </h1>
            <p
              class="cm-load mt-6 max-w-xl text-lg leading-relaxed text-cuidaty-dark/70"
              style="--d:0.45s"
            >
              São dois produtos do mesmo time: um sistema de gestão para a clínica e um serviço de
              gestão comercial. Dá para contratar um, o outro ou os dois.
            </p>
          </div>

          <nav class="cm-load" style="--d:0.6s" aria-labelledby="escolha-title">
            <p id="escolha-title" class="text-[0.95rem] font-semibold text-cuidaty-dark">
              O que a clínica precisa agora?
            </p>
            <a
              href="#cuidaty"
              class="cm-choice mt-4 flex items-center justify-between gap-4 rounded-2xl bg-[#e3edf4] p-5 sm:p-6"
            >
              <span>
                <span class="block font-serif text-xl font-extrabold text-cuidaty-dark">
                  Organizar o atendimento
                </span>
                <span class="mt-1 block text-sm text-cuidaty-dark/70">
                  Cuidaty: agenda, prontuário e financeiro
                </span>
              </span>
              <span class="cm-choice-arrow text-2xl text-primary-ink" aria-hidden="true">↓</span>
            </a>
            <a
              href="#midas"
              class="cm-choice mt-3 flex items-center justify-between gap-4 rounded-2xl bg-[#fbf0d2] p-5 sm:p-6"
            >
              <span>
                <span class="block font-serif text-xl font-extrabold text-cuidaty-dark">
                  Vender mais
                </span>
                <span class="mt-1 block text-sm text-cuidaty-dark/70">
                  MIDAS: atendimento comercial, orçamentos e anúncios
                </span>
              </span>
              <span class="cm-choice-arrow text-2xl text-[#8f5d0d]" aria-hidden="true">↓</span>
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- 2. O caminho do paciente: uma linha só, metade de cada produto -->
    <section aria-labelledby="etapas-title">
      <div class="container mx-auto px-5 pb-16 md:px-8 md:pb-24">
        <div class="mx-auto max-w-7xl">
          <div class="max-w-2xl" data-cm>
            <h2
              id="etapas-title"
              class="cm-a text-balance text-3xl leading-[1.1] text-cuidaty-dark md:text-4xl"
            >
              Do anúncio ao financeiro, quem cuida de quê
            </h2>
            <p class="cm-a mt-5 text-lg leading-relaxed text-cuidaty-dark/70" style="--d:0.1s">
              Acompanhe um paciente pela clínica. O MIDAS fica com o caminho até ele fechar. A
              Cuidaty assume do agendamento em diante.
            </p>
          </div>

          <div class="mt-12 grid lg:grid-cols-2">
            {
              journey.map((group, g) => (
                <>
                  {g === 1 && (
                    <p class="cm-handoff-row hidden" data-cm>
                      <span class="cm-a cm-a-pop cm-handoff">
                        <svg class="size-3.5" viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="m5 12 5 5 9-10"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        Paciente fechou
                      </span>
                    </p>
                  )}
                  <div
                    class:list={[
                      'cm-group rounded-2xl px-6 py-8 lg:px-0 lg:py-10',
                      g === 0
                        ? 'cm-group--midas bg-[#fdf8ec] lg:rounded-r-none'
                        : 'cm-group--cuidaty bg-[#e3edf4] lg:rounded-l-none',
                    ]}
                  >
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 lg:px-8">
                      {g === 0 ? (
                        <MidasLogo size={28} id="midas-journey" />
                      ) : (
                        <img
                          src={logoWritten.src}
                          alt="Cuidaty"
                          width="314"
                          height="82"
                          class="h-7 w-auto"
                          loading="lazy"
                        />
                      )}
                      <span class="text-sm text-cuidaty-dark/70">{group.caption}</span>
                    </div>

                    <div class="cm-rail relative mt-8" data-cm>
                      <span
                        class="cm-seg hidden lg:block"
                        style={`--d:${stageDelay(group.stages[0].at - (g === 1 ? 0.5 : 0))}`}
                        aria-hidden="true"
                      >
                        <span class="cm-seg-fill" />
                        <i class="cm-dot" />
                      </span>
                      {g === 1 && (
                        <span
                          class="cm-handoff cm-handoff--line cm-a cm-a-pop"
                          style={`--d:${stageDelay(2.5)}`}
                          aria-hidden="true"
                        >
                          <svg class="size-3.5" viewBox="0 0 24 24">
                            <path
                              d="m5 12 5 5 9-10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                          Fechou
                        </span>
                      )}
                      <ol class="relative grid lg:grid-cols-3" start={group.stages[0].at + 1}>
                        {group.stages.map((s) => (
                          <li class="cm-stage" style={`--d:${stageDelay(s.at)}`} data-cm>
                            <span class="cm-node cm-a cm-a-pop">
                              <svg class="size-6" viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                  d={s.icon}
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </span>
                            <div class="cm-a cm-stage-text">
                              <p class="text-xs font-semibold text-cuidaty-dark/50">
                                Etapa {s.at + 1}
                              </p>
                              <h3 class="mt-1 font-sans text-lg font-semibold text-cuidaty-dark">
                                {s.stage}
                              </h3>
                              <p class="mt-1.5 text-sm leading-relaxed text-cuidaty-dark/70">
                                {s.text}
                              </p>
                            </div>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </div>
                </>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Os dois produtos lado a lado -->
    <section class="border-t border-border" aria-labelledby="produtos-title">
      <div class="container mx-auto px-5 py-16 md:px-8 md:py-24">
        <div class="mx-auto max-w-7xl">
          <h2
            id="produtos-title"
            class="max-w-2xl text-balance text-3xl leading-[1.1] text-cuidaty-dark md:text-4xl"
          >
            O que cada um entrega
          </h2>
          <div class="mt-12 grid gap-6 lg:grid-cols-2">
            <article
              id="cuidaty"
              class="flex scroll-mt-28 flex-col rounded-2xl bg-[#e3edf4] p-7 sm:p-10"
              data-cm
            >
              <img
                src={logoWritten.src}
                alt=""
                width="314"
                height="82"
                class="cm-a h-10 w-auto self-start"
                loading="lazy"
              />
              <p class="cm-a mt-8 text-[0.95rem] font-semibold text-primary-ink" style="--d:0.05s">
                Sistema de gestão
              </p>
              <h3
                class="cm-a mt-2 text-3xl leading-[1.1] text-cuidaty-dark md:text-4xl"
                style="--d:0.1s"
              >
                Cuidaty: a rotina da clínica em um lugar só
              </h3>
              <p class="cm-a mt-4 leading-relaxed text-cuidaty-dark/70" style="--d:0.15s">
                É um software, usado pela própria equipe da clínica. A consulta gravada vira
                prontuário e a agenda confirma o paciente pelo WhatsApp.
              </p>
              <ul class="mt-6 border-b border-cuidaty-dark/15">
                {
                  cuidaty.does.map((item, i) => (
                    <li
                      class="cm-a border-t border-cuidaty-dark/15 py-3.5 font-medium text-cuidaty-dark"
                      style={`--d:${0.25 + i * 0.08}s`}
                    >
                      {item}
                    </li>
                  ))
                }
              </ul>
              <dl class="cm-a mt-6 space-y-4 text-sm" style="--d:0.6s">
                <div>
                  <dt class="font-semibold text-cuidaty-dark">Para quem</dt>
                  <dd class="mt-1 leading-relaxed text-cuidaty-dark/70">{cuidaty.audience}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-cuidaty-dark">Quanto custa</dt>
                  <dd class="mt-1 leading-relaxed text-cuidaty-dark/70">{cuidaty.pricing}</dd>
                </div>
              </dl>
              <div
                class="cm-a mt-auto flex flex-wrap items-center gap-x-6 gap-y-4 pt-8"
                style="--d:0.7s"
              >
                <a
                  href={REGISTER_URL}
                  class="btn-solid"
                  data-ga-event="generate_lead"
                  data-ga-location="cuidaty_e_midas">Começar grátis</a
                >
                <a href="/" class="font-semibold text-primary-ink underline underline-offset-4"
                  >Ver a Cuidaty</a
                >
              </div>
            </article>

            <article
              id="midas"
              class="flex scroll-mt-28 flex-col rounded-2xl bg-[#fdf8ec] p-7 sm:p-10"
              data-cm
            >
              <MidasLogo size={40} id="midas-card" class="cm-a self-start" />
              <p class="cm-a mt-8 text-[0.95rem] font-semibold text-[#8f5d0d]" style="--d:0.05s">
                Gestão comercial
              </p>
              <h3
                class="cm-a mt-2 text-3xl leading-[1.1] text-cuidaty-dark md:text-4xl"
                style="--d:0.1s"
              >
                MIDAS: um time cuidando das vendas da clínica
              </h3>
              <p class="cm-a mt-4 leading-relaxed text-cuidaty-dark/70" style="--d:0.15s">
                É um serviço. Um time nosso trabalha dentro da clínica no dia a dia e define quem
                responde o WhatsApp, quando ligar para o orçamento parado e onde investir em
                anúncio.
              </p>
              <ul class="mt-6 border-b border-cuidaty-dark/15">
                {
                  midas.does.map((item, i) => (
                    <li
                      class="cm-a border-t border-cuidaty-dark/15 py-3.5 font-medium text-cuidaty-dark"
                      style={`--d:${0.25 + i * 0.08}s`}
                    >
                      {item}
                    </li>
                  ))
                }
              </ul>
              <dl class="cm-a mt-6 space-y-4 text-sm" style="--d:0.6s">
                <div>
                  <dt class="font-semibold text-cuidaty-dark">Para quem</dt>
                  <dd class="mt-1 leading-relaxed text-cuidaty-dark/70">{midas.audience}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-cuidaty-dark">Quanto custa</dt>
                  <dd class="mt-1 leading-relaxed text-cuidaty-dark/70">{midas.pricing}</dd>
                </div>
              </dl>
              <div
                class="cm-a mt-auto flex flex-wrap items-center gap-x-6 gap-y-4 pt-8"
                style="--d:0.7s"
              >
                <a
                  href={MIDAS_URL}
                  target="_blank"
                  rel="noopener"
                  class="btn-solid cm-go"
                  data-ga-event="midas_click"
                  data-ga-location="cuidaty_e_midas"
                  >Conhecer o MIDAS <span class="cm-go-arrow ml-2" aria-hidden="true">→</span></a
                >
                <a
                  href={MIDAS_WA_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-primary-ink underline underline-offset-4"
                  data-ga-event="contact_click"
                  data-ga-location="cuidaty_e_midas_whatsapp">Pedir diagnóstico</a
                >
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Prova: um caso de cada produto -->
    <section class="border-t border-border" aria-labelledby="prova-title">
      <div class="container mx-auto px-5 py-16 md:px-8 md:py-24">
        <div class="mx-auto max-w-7xl">
          <h2
            id="prova-title"
            class="max-w-2xl text-balance text-3xl leading-[1.1] text-cuidaty-dark md:text-4xl"
          >
            Quem já usa
          </h2>
          <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
            {
              proofs.map((p) => (
                <figure
                  class:list={[
                    'border-t-2 pt-6',
                    p.product === 'MIDAS' ? 'border-[#e9a93a]' : 'border-primary',
                  ]}
                  data-cm
                >
                  <p
                    class:list={[
                      'cm-a text-[0.95rem] font-semibold',
                      p.product === 'MIDAS' ? 'text-[#8f5d0d]' : 'text-primary-ink',
                    ]}
                  >
                    {p.product}
                  </p>
                  <p
                    class="cm-a mt-3 font-serif text-5xl font-extrabold leading-none text-cuidaty-dark md:text-6xl"
                    style="--d:0.08s"
                  >
                    {p.metric}
                  </p>
                  <p class="cm-a mt-3 text-cuidaty-dark/70" style="--d:0.14s">
                    {p.metricLabel}
                  </p>
                  <blockquote
                    class="cm-a mt-8 text-lg leading-relaxed text-cuidaty-dark"
                    style="--d:0.22s"
                  >
                    “{p.quote}”
                  </blockquote>
                  <figcaption class="cm-a mt-6 flex items-center gap-3" style="--d:0.3s">
                    <img
                      src={p.photo}
                      alt=""
                      width="48"
                      height="48"
                      class="size-12 rounded-full object-cover"
                      loading="lazy"
                    />
                    <span class="text-sm">
                      <span class="block font-semibold text-cuidaty-dark">{p.name}</span>
                      <span class="block text-cuidaty-dark/70">{p.role}</span>
                    </span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Perguntas: uma aberta por vez, todas no HTML para o buscador -->
    <section class="border-t border-border" aria-labelledby="duvidas-title">
      <div class="container mx-auto px-5 py-16 md:px-8 md:py-24">
        <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
          <h2
            id="duvidas-title"
            class="text-balance text-3xl leading-[1.1] text-cuidaty-dark md:text-4xl"
          >
            Dúvidas sobre os dois
          </h2>
          <div class="border-b border-border">
            {
              faqs.map((faq, i) => (
                <details class="cm-faq group border-t border-border" name="cm-faq" open={i === 0}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden">
                    <h3 class="font-sans text-lg font-semibold text-cuidaty-dark">
                      {faq.question}
                    </h3>
                    <span
                      class="relative size-5 shrink-0 text-primary-ink transition-transform duration-300 group-open:rotate-45"
                      aria-hidden="true"
                    >
                      <span class="absolute left-0 top-1/2 h-0.5 w-full -translate-y-1/2 bg-current" />
                      <span class="absolute left-1/2 top-0 h-full w-0.5 -translate-x-1/2 bg-current" />
                    </span>
                  </summary>
                  <p class="max-w-3xl pb-6 leading-relaxed text-cuidaty-dark/70">{faq.answer}</p>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Fechamento: o que acontece depois do clique, em cada produto -->
    <section class="border-t border-border" aria-labelledby="comecar-title">
      <div class="container mx-auto px-5 py-16 md:px-8 md:py-24">
        <div class="mx-auto max-w-7xl">
          <div class="max-w-2xl">
            <h2
              id="comecar-title"
              class="text-balance text-3xl leading-[1.1] text-cuidaty-dark md:text-4xl"
            >
              Como começar com cada um
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-cuidaty-dark/70">
              Na Cuidaty você entra sozinho e usa hoje. No MIDAS a primeira conversa é um
              diagnóstico da clínica.
            </p>
          </div>

          <div class="mt-12 grid gap-6 lg:grid-cols-2">
            <div
              class="cm-group--cuidaty flex flex-col rounded-2xl bg-[#e3edf4] p-7 sm:p-10"
              data-cm
            >
              <img
                src={logoWritten.src}
                alt="Cuidaty"
                width="314"
                height="82"
                class="cm-a h-9 w-auto self-start"
                loading="lazy"
              />
              <ol class="cm-steps mt-8">
                {
                  cuidatySteps.map((step, i) => (
                    <li class="cm-a" style={`--d:${0.1 + i * 0.12}s`}>
                      <span class="cm-step-n" aria-hidden="true">
                        {i + 1}
                      </span>
                      <div>
                        <h3 class="font-sans text-lg font-semibold text-cuidaty-dark">
                          {step.title}
                        </h3>
                        <p class="mt-1 text-sm leading-relaxed text-cuidaty-dark/70">{step.text}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
              <div class="cm-a mt-auto pt-8" style="--d:0.5s">
                <a
                  href={REGISTER_URL}
                  class="btn-solid"
                  data-ga-event="generate_lead"
                  data-ga-location="cuidaty_e_midas_fechamento">Começar grátis</a
                >
                <p class="mt-4 text-sm text-cuidaty-dark/70">
                  Clínica com equipe? A implantação é acompanhada e os dados vêm do sistema
                  anterior.
                  <a
                    href={PROPOSAL_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-primary-ink underline underline-offset-4"
                    data-ga-event="contact_click"
                    data-ga-location="cuidaty_e_midas_fechamento">Falar com a gente</a
                  >.
                </p>
              </div>
            </div>

            <div class="cm-group--midas flex flex-col rounded-2xl bg-[#fdf8ec] p-7 sm:p-10" data-cm>
              <MidasLogo size={36} id="midas-start" class="cm-a self-start" />
              <ol class="cm-steps mt-8">
                {
                  midasSteps.map((step, i) => (
                    <li class="cm-a" style={`--d:${0.1 + i * 0.12}s`}>
                      <span class="cm-step-n" aria-hidden="true">
                        {i + 1}
                      </span>
                      <div>
                        <h3 class="font-sans text-lg font-semibold text-cuidaty-dark">
                          {step.title}
                        </h3>
                        <p class="mt-1 text-sm leading-relaxed text-cuidaty-dark/70">{step.text}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
              <div class="cm-a mt-auto pt-8" style="--d:0.6s">
                <a
                  href={MIDAS_WA_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-solid"
                  data-ga-event="contact_click"
                  data-ga-location="cuidaty_e_midas_fechamento_midas">Pedir diagnóstico</a
                >
                <p class="mt-4 text-sm text-cuidaty-dark/70">
                  O diagnóstico não obriga a contratar.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* ── Caminho do paciente ──────────────────────────────────────── */
  .cm-group--midas {
    --cm-ink: #8f5d0d;
    --cm-line: #e9a93a;
    --cm-node: #fbf0d2;
  }
  .cm-group--cuidaty {
    --cm-ink: #2d6389;
    --cm-line: #356588;
    --cm-node: #cfe0ec;
  }
  .cm-node {
    position: relative;
    z-index: 1;
    display: flex;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--cm-line);
    border-radius: 9999px;
    background: var(--cm-node);
    color: var(--cm-ink);
  }
  .cm-handoff {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border: 1.5px solid #0c202f;
    border-radius: 9999px;
    background: #fff;
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    color: #0c202f;
    white-space: nowrap;
  }

  /* Celular: etapas empilhadas, com um fio ligando um nó ao seguinte. */
  @media (max-width: 1023px) {
    .cm-handoff--line {
      display: none;
    }
    .cm-handoff-row {
      display: flex;
      justify-content: center;
      padding-block: 0.75rem;
    }
    .cm-stage {
      --d: 0s !important;
      position: relative;
      display: grid;
      grid-template-columns: 3.5rem 1fr;
      gap: 1rem;
      padding-bottom: 1.75rem;
    }
    .cm-stage:last-child {
      padding-bottom: 0;
    }
    .cm-stage:not(:last-child)::before {
      content: '';
      position: absolute;
      left: calc(1.75rem - 1px);
      top: 3.5rem;
      bottom: 0;
      width: 2px;
      background: var(--cm-line);
      opacity: 0.45;
    }
    .cm-stage-text {
      --d: 0.12s !important;
      padding-top: 0.15rem;
    }
  }

  /* Desktop: seis colunas numa linha só. O segmento de cada produto vai do
     centro da coluna da ponta até a emenda entre os dois painéis. */
  @media (min-width: 1024px) {
    .cm-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-inline: 1rem;
      text-align: center;
    }
    .cm-stage-text {
      margin-top: 1.25rem;
    }
    .cm-seg {
      position: absolute;
      top: calc(1.75rem - 1.5px);
      height: 3px;
      background: color-mix(in srgb, var(--cm-line) 25%, transparent);
    }
    .cm-group--midas .cm-seg {
      left: calc(100% / 6);
      right: 0;
    }
    .cm-group--cuidaty .cm-seg {
      left: 0;
      right: calc(100% / 6);
    }
    .cm-seg-fill {
      position: absolute;
      inset: 0;
      background: var(--cm-line);
      transform-origin: left;
    }
    .cm-dot {
      position: absolute;
      top: 50%;
      left: 0;
      width: 0.75rem;
      height: 0.75rem;
      margin: -0.375rem 0 0 -0.375rem;
      border-radius: 9999px;
      background: var(--cm-ink);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--cm-line) 35%, transparent);
      opacity: 0;
    }
    .cm-handoff--line {
      position: absolute;
      left: 0;
      top: 1.75rem;
      z-index: 2;
      translate: -50% -50%;
    }
  }

  /* ── Passos para começar ──────────────────────────────────────── */
  .cm-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 1rem;
    padding-bottom: 1.5rem;
  }
  .cm-steps li:last-child {
    padding-bottom: 0;
  }
  .cm-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.125rem - 1px);
    top: 2.25rem;
    bottom: 0;
    width: 2px;
    background: var(--cm-line);
    opacity: 0.45;
  }
  .cm-step-n {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--cm-line);
    border-radius: 9999px;
    background: var(--cm-node);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--cm-ink);
  }

  /* ── Detalhes de interação ────────────────────────────────────── */
  .cm-choice {
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }
  .cm-choice:hover,
  .cm-choice:focus-visible {
    transform: translateY(-2px);
    box-shadow:
      0 2px 4px rgba(12, 32, 47, 0.05),
      0 12px 32px rgba(12, 32, 47, 0.08);
  }
  .cm-choice-arrow,
  .cm-go-arrow {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cm-choice:hover .cm-choice-arrow,
  .cm-choice:focus-visible .cm-choice-arrow {
    transform: translateY(4px);
  }
  .cm-go:hover .cm-go-arrow {
    transform: translateX(4px);
  }

  /* ── Motion (só com movimento permitido) ──────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    /* Abertura: roda no carregamento, sem depender de JS. */
    .cm-load {
      animation: cm-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--d, 0s);
    }
    .cm-load-left {
      animation-name: cm-from-left;
    }
    .cm-load-right {
      animation-name: cm-from-right;
      animation-delay: 0.1s;
    }
    .cm-load-grow {
      animation-name: cm-grow;
    }

    /* Blocos [data-cm]: os filhos .cm-a aparecem quando o bloco entra na tela. */
    .cm-js [data-cm]:not(.is-in) .cm-a {
      opacity: 0;
    }
    .cm-js [data-cm].is-in .cm-a {
      animation: cm-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--d, 0s);
    }
    .cm-js [data-cm].is-in .cm-a-pop {
      animation-name: cm-pop;
    }
    .cm-js [data-cm].is-in .cm-handoff--line {
      animation-name: cm-pop-centered;
    }

    /* A linha é desenhada e, depois, um ponto (o paciente) percorre os dois
       segmentos em sequência: metade do ciclo em cada produto. */
    .cm-js .cm-rail:not(.is-in) .cm-seg-fill {
      transform: scaleX(0);
    }
    .cm-js .cm-rail.is-in .cm-seg-fill {
      animation: cm-draw 1.2s linear both;
      animation-delay: var(--d, 0s);
    }
    .cm-js .cm-rail.is-in .cm-dot {
      animation: cm-travel-first 6s linear 3.2s infinite;
    }
    .cm-js .cm-group--cuidaty .cm-rail.is-in .cm-dot {
      animation-name: cm-travel-second;
    }

    .cm-faq {
      interpolate-size: allow-keywords;
    }
    .cm-faq::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.3s ease,
        content-visibility 0.3s allow-discrete;
    }
    .cm-faq[open]::details-content {
      block-size: auto;
    }
  }

  @keyframes cm-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes cm-from-left {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
  }
  @keyframes cm-from-right {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
  }
  @keyframes cm-grow {
    from {
      opacity: 0;
      transform: scaleY(0);
    }
  }
  @keyframes cm-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    60% {
      transform: scale(1.08);
    }
  }
  @keyframes cm-pop-centered {
    from {
      opacity: 0;
      scale: 0.6;
    }
    60% {
      scale: 1.08;
    }
  }
  @keyframes cm-draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes cm-travel-first {
    0% {
      left: 0;
      opacity: 0;
    }
    3%,
    47% {
      opacity: 1;
    }
    50%,
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  @keyframes cm-travel-second {
    0%,
    50% {
      left: 0;
      opacity: 0;
    }
    53%,
    97% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }
</style>
