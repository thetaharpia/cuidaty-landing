---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import StatsHero from '../components/sections/StatsHero.astro';
import Pain from '../components/sections/Pain.astro';
import Features from '../components/sections/Features.astro';
import Mission from '../components/sections/Mission.astro';
import NacaoCuidaty from '../components/sections/NacaoCuidaty.astro';
import Personas from '../components/sections/Personas.astro';
import TrustBadges from '../components/sections/TrustBadges.astro';
import CTA from '../components/sections/CTA.astro';
---

<Layout
  title="Cuidaty - Software para Psicólogos e Clínicas | Agenda Online, Prontuário Eletrônico e WhatsApp Automático"
  description="Sistema completo de gestão para consultórios, clínicas de saúde mental, hospitais e centros multidisciplinares. Prontuário eletrônico, agenda online com confirmação via WhatsApp, gestão financeira, controle de equipes e conformidade com LGPD, CFM, CFP e padrão TISS. Mais de 500 profissionais economizam 8h por semana e reduziram 73% das faltas."
  keywords="cuidaty, software para psicólogos, sistema para consultório de psicologia, agenda online para psicólogos, prontuário eletrônico psicologia, prontuário SOAP, automação whatsapp consultório, confirmação de consulta automática, lembrete de consulta whatsapp, gestão de consultório, sistema para clínicas de saúde, agendamento online pacientes, controle financeiro consultório, software para terapeutas, sistema para nutricionistas, sistema para fisioterapeutas, plataforma para profissionais de saúde, redução de faltas consultório, no-show consultório, portal de agendamento online, gestão de pacientes, software LGPD saúde, teleconsulta, gestão clínica integrada, repasse financeiro clínica, software médico, sistema de gestão clínica, agenda médica online, consultório online, secretária virtual consultório, conformidade CFM, conformidade CFP, padrão TISS, anamnese digital, prescrição eletrônica, sistema multi-unidade saúde"
>
  <Header />
  <main>
    <Hero />
    <StatsHero />
    <Pain />
    <Features />
    <Mission />
    <NacaoCuidaty />
    <Personas />
    <TrustBadges />
    <CTA />
  </main>
  <Footer />
</Layout>
