---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/home/Motion.astro';
import Hero from '../components/home/Hero.astro';
import Pain from '../components/home/Pain.astro';
import Journey from '../components/home/Journey.astro';
import Hub from '../components/home/Hub.astro';
import Trust from '../components/home/Trust.astro';
import Proof from '../components/home/Proof.astro';
import Steps from '../components/home/Steps.astro';
import Plans from '../components/home/Plans.astro';
import Faq from '../components/home/Faq.astro';
import BlogSection from '../components/sections/BlogSection.astro';
import Closing from '../components/home/Closing.astro';
import { homeDescription, homeKeywords, homeTitle } from '../lib/seo';
---

<Layout title={homeTitle} description={homeDescription} keywords={homeKeywords}>
  <Header />
  <main>
    <!-- 1. Oferta: o que é, para quem, um CTA, e a sessão virando prontuário -->
    <Hero />
    <!-- 2. A dor, curta -->
    <Pain />
    <!-- 3. O dia do profissional: antes, durante e depois da sessão -->
    <Journey />
    <!-- 4. Integrações, com a logo no centro -->
    <Hub />
    <!-- 5. Promessas de confiança -->
    <Trust />
    <!-- 6. Prova social: números e depoimentos -->
    <Proof />
    <!-- 7. Como começamos (implantação acompanhada) -->
    <Steps />
    <!-- 8. Planos: comece grátis -->
    <Plans />
    <!-- 9. FAQ indexável e visível -->
    <Faq />
    <!-- 10. Conteúdo: últimos artigos do blog -->
    <BlogSection />
    <!-- 11. Fechamento: um único CTA -->
    <Closing />
  </main>
  <Footer />
  <Motion />
</Layout>
