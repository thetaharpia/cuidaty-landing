---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import StatsHero from '../components/sections/StatsHero.astro';
import Pain from '../components/sections/Pain.astro';
import Features from '../components/sections/Features.astro';
import Mission from '../components/sections/Mission.astro';
import NacaoCuidaty from '../components/sections/NacaoCuidaty.astro';
import Rebranding from '../components/sections/Rebranding.astro';
import Personas from '../components/sections/Personas.astro';
import TrustBadges from '../components/sections/TrustBadges.astro';
import BlogSection from '../components/sections/BlogSection.astro';
import CTA from '../components/sections/CTA.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import { homeDescription, homeKeywords, homeTitle } from '../lib/seo';
---

<Layout title={homeTitle} description={homeDescription} keywords={homeKeywords}>
  <Header />
  <main>
    <!-- 1. Hook: captura + CTA primário -->
    <Hero />
    <!-- 2. Credibilidade rápida (500+, 8h, 73%) -->
    <StatsHero />
    <!-- 3. Conecta com a dor -->
    <Pain />
    <!-- 4. Entrega de valor (o que você ganha) -->
    <Features />
    <!-- 5. Para quem é? Cliente se reconhece -->
    <Personas />
    <!-- 6. Prova social de pico: depoimentos + clínicas -->
    <NacaoCuidaty />
    <!-- 7. Narrativa da marca: de ThetaHarpia para Cuidaty -->
    <Rebranding />
    <!-- 8. Propósito emocional -->
    <Mission />
    <!-- 9. Reasseguramento técnico antes da conversão -->
    <TrustBadges />
    <!-- 10. FAQ indexável e visível -->
    <FAQSection />
    <!-- 11. Momento de contato — Calendly / WhatsApp / e-mail -->
    <CTA />
    <!-- 12. Retenção: conteúdo para quem não converteu ainda -->
    <BlogSection />
  </main>
  <Footer />
</Layout>
