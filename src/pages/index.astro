---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/home/Motion.astro';
import Hero from '../components/home/Hero.astro';
import FeatureStack from '../components/home/FeatureStack.astro';
import Convenios from '../components/home/Convenios.astro';
import Trust from '../components/home/Trust.astro';
import Proof from '../components/home/Proof.astro';
import Clinics from '../components/home/Clinics.astro';
import Midas from '../components/home/Midas.astro';
import Plans from '../components/home/Plans.astro';
import Faq from '../components/home/Faq.astro';
import Closing from '../components/home/Closing.astro';
import { homeDescription, homeKeywords, homeTitle } from '../lib/seo';
---

<Layout
  title={homeTitle}
  description={homeDescription}
  keywords={homeKeywords}
  image="/og/cuidaty-e-midas.png"
>
  <Header />
  <main>
    <!-- 1. Pitch dos dois produtos e uma pergunta: falta tempo (Cuidaty) ou vender mais (MIDAS) -->
    <Hero />
    <!-- 2. Funcionalidades da Cuidaty em pilha: uma abre por vez -->
    <FeatureStack />
    <!-- 3. Convênios: Geap e SulAmérica, do plano Clínicas -->
    <Convenios />
    <!-- 4. Promessas de segurança -->
    <Trust />
    <!-- 5. Prova social: números e depoimentos -->
    <Proof />
    <!-- 6. Planos: comece grátis -->
    <Plans />
    <!-- 7. Para clínicas: recursos e implantação acompanhada -->
    <Clinics />
    <!-- 8. MIDAS + Cuidaty: o caminho da paciente. Sobe para depois do hero quando a pessoa
         escolhe "a clínica precisa vender mais" (script em Hero.astro). -->
    <Midas />
    <!-- 9. FAQ indexável e visível -->
    <Faq />
    <!-- 10. Fechamento: um único CTA -->
    <Closing />
  </main>
  <Footer />
  <Motion />
</Layout>
