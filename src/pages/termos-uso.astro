---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = '20 de junho de 2026';

/**
 * Termos de Uso como documento legal editorial: cláusulas numeradas,
 * índice fixo (TOC) no desktop e tipografia serifada. Cada seção é uma
 * cláusula real do contrato — a numeração carrega informação.
 */
type Clause = {
  id: string;
  title: string;
  lead?: string;
  items?: string[];
};

const clauses: Clause[] = [
  {
    id: 'servicos',
    title: 'Nossos serviços',
    lead: 'A Cuidaty é uma plataforma de gestão para profissionais e clínicas de saúde. A assinatura ativa dá acesso a:',
    items: [
      'Sistema de gestão completo do consultório',
      'Prontuário eletrônico',
      'Agenda e automação de mensagens via WhatsApp',
      'Cuty AI e transcrição de consultas com IA, conforme o plano contratado',
      'Controle financeiro, relatórios e análises',
    ],
  },
  {
    id: 'responsabilidades',
    title: 'Suas responsabilidades',
    lead: 'Ao usar a plataforma, você concorda em:',
    items: [
      'Ser um profissional de saúde devidamente registrado',
      'Manter seus dados e os dos pacientes precisos e atualizados',
      'Proteger suas credenciais de acesso',
      'Cumprir as regulamentações do seu conselho e da sua área',
      'Usar a plataforma apenas para fins profissionais',
    ],
  },
  {
    id: 'pagamento',
    title: 'Planos e pagamento',
    lead: 'Você começa com 14 dias de teste grátis. A cobrança só acontece depois desse período.',
    items: [
      'Teste grátis de 14 dias, sem cobrança',
      'A primeira cobrança ocorre apenas ao fim do período de teste',
      'Planos Básico, Premium e Plus, com assinatura mensal',
      'Renovação automática a cada mês',
      'Cancelamento a qualquer momento, sem multa',
    ],
  },
  {
    id: 'ia',
    title: 'Inteligência artificial',
    lead: 'Os recursos de IA são opcionais e operam em conformidade com a LGPD.',
    items: [
      'O Cuty AI (planos Premium e Plus) gera respostas e resumos a partir do prontuário, sempre citando a fonte',
      'A transcrição (plano Plus) usa o áudio apenas para gerar o resumo clínico (em SOAP ou outro formato); o áudio é descartado após o processamento',
      'Os dados de pacientes não são usados para treinar modelos de IA de terceiros',
      'A IA é auxiliar e não substitui o julgamento clínico do profissional, que permanece responsável pelas decisões',
    ],
  },
  {
    id: 'limitacoes',
    title: 'Limitações de responsabilidade',
    items: [
      'Disponibilidade prevista de 99,5% (SLA)',
      'A responsabilidade da Cuidaty é limitada ao valor pago pela assinatura',
      'A plataforma apoia, mas não substitui, decisões clínicas',
      'Recomendamos manter um backup adicional dos seus dados',
      'Suporte humano em horário comercial',
    ],
  },
  {
    id: 'propriedade',
    title: 'Propriedade intelectual',
    lead: 'O software, a marca, o design e os conteúdos da Cuidaty são de nossa propriedade e protegidos por lei. A assinatura concede o direito de uso da plataforma, não a sua propriedade.',
  },
  {
    id: 'cancelamento',
    title: 'Cancelamento e dados',
    lead: 'Você pode cancelar a assinatura quando quiser. Após o cancelamento, mantemos seus dados por até 90 dias antes da eliminação definitiva, salvo quando a lei exigir prazo diferente. Nesse período, você pode solicitar a exportação dos seus registros.',
  },
  {
    id: 'legislacao',
    title: 'Legislação aplicável',
    lead: 'Estes Termos são regidos pela legislação brasileira, incluindo a LGPD (Lei nº 13.709/2018). Eventuais conflitos serão resolvidos no foro da comarca de Macapá/AP.',
  },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout
  title="Termos de Uso | Cuidaty"
  description="Termos de uso da plataforma Cuidaty. Condições para utilização do sistema de gestão para consultórios, clínicas e profissionais da saúde."
  keywords="termos de uso Cuidaty, condições de uso, contrato plataforma saúde, termos software consultório"
>
  <Header />
  <main class="bg-white">
    <!-- Cabeçalho editorial -->
    <header class="border-b border-border">
      <div class="container mx-auto px-5 md:px-8">
        <div class="mx-auto max-w-3xl pb-12 pt-32 md:pb-16 md:pt-40">
          <p class="mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-cuidaty-primary">
            Documento legal
          </p>
          <h1
            class="font-serif text-5xl font-semibold leading-[1.02] tracking-tight text-cuidaty-dark md:text-7xl"
          >
            Termos de Uso
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-foreground/70">
            As condições para usar a plataforma Cuidaty, em linguagem direta, sem letras miúdas.
          </p>
          <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-4 border-t border-border pt-6 text-sm">
            <div>
              <dt class="text-foreground/50">Última atualização</dt>
              <dd class="mt-0.5 font-medium text-cuidaty-dark">{lastUpdated}</dd>
            </div>
            <div>
              <dt class="text-foreground/50">Legislação</dt>
              <dd class="mt-0.5 font-medium text-cuidaty-dark">Brasil · LGPD</dd>
            </div>
            <div>
              <dt class="text-foreground/50">Cláusulas</dt>
              <dd class="mt-0.5 font-medium text-cuidaty-dark">{clauses.length}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <!-- Corpo: índice fixo + cláusulas -->
    <div class="container mx-auto px-5 md:px-8">
      <div
        class="mx-auto grid max-w-6xl gap-y-12 py-16 md:py-20 lg:grid-cols-[200px_1fr] lg:gap-x-20"
        data-terms
      >
        <!-- Índice (sticky no desktop) -->
        <aside class="hidden lg:block">
          <nav aria-label="Índice dos Termos" class="sticky top-28">
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-foreground/40">
              Índice
            </p>
            <ol class="space-y-2.5">
              {
                clauses.map((clause, i) => (
                  <li>
                    <a
                      href={`#${clause.id}`}
                      data-toc={clause.id}
                      class="toc-link group flex gap-2.5 text-sm leading-snug text-foreground/55 transition-colors hover:text-cuidaty-dark"
                    >
                      <span class="font-serif text-cuidaty-primary/60 tabular-nums">{num(i)}</span>
                      <span>{clause.title}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </aside>

        <!-- Cláusulas -->
        <div class="max-w-2xl">
          {
            clauses.map((clause, i) => (
              <section id={clause.id} class="scroll-mt-28 border-t border-border py-10 first:border-t-0 first:pt-0">
                <p class="mb-3 font-serif text-base font-semibold tabular-nums text-cuidaty-primary">
                  {num(i)}
                </p>
                <h2 class="font-serif text-2xl font-semibold leading-tight text-cuidaty-dark md:text-3xl">
                  {clause.title}
                </h2>
                {clause.lead && (
                  <p class="mt-4 text-[1.05rem] leading-relaxed text-foreground/75">{clause.lead}</p>
                )}
                {clause.items && (
                  <ul class="mt-5 space-y-3">
                    {clause.items.map((item) => (
                      <li class="flex gap-3 text-foreground/75">
                        <span
                          class="mt-[0.7rem] h-px w-4 flex-shrink-0 bg-cuidaty-secondary"
                          aria-hidden="true"
                        />
                        <span class="leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }

          <!-- Contato -->
          <section class="mt-12 rounded-2xl bg-beige px-6 py-8 md:px-9 md:py-10">
            <h2 class="font-serif text-2xl font-semibold text-cuidaty-dark">Dúvidas sobre os Termos?</h2>
            <p class="mt-2 text-foreground/70">
              Fale com a gente. Respondemos em até 48 horas.
            </p>
            <dl class="mt-6 grid gap-5 sm:grid-cols-2">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-foreground/45">
                  Jurídico e suporte
                </dt>
                <dd class="mt-1.5">
                  <a
                    href="mailto:contato@thetaharpia.com"
                    class="font-medium text-cuidaty-primary underline-offset-4 hover:underline"
                  >
                    contato@thetaharpia.com
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-foreground/45">
                  WhatsApp
                </dt>
                <dd class="mt-1.5">
                  <a
                    href="https://wa.me/559691003520"
                    target="_blank"
                    rel="noopener"
                    class="font-medium text-cuidaty-primary underline-offset-4 hover:underline"
                  >
                    (96) 9100-3520
                  </a>
                </dd>
              </div>
            </dl>
          </section>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .toc-link.toc-active {
    color: #0c202f;
    font-weight: 500;
  }
  .toc-link.toc-active span:first-child {
    color: #356588;
  }
</style>

<script>
  // Scroll-spy: destaca a cláusula visível no índice
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
  const byId = new Map(links.map((l) => [l.dataset.toc ?? '', l]));
  const sections = links
    .map((l) => document.getElementById(l.dataset.toc ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((l) => l.classList.remove('toc-active'));
          byId.get(entry.target.id)?.classList.add('toc-active');
        });
      },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
    );
    sections.forEach((s) => spy.observe(s));
  }
</script>
