---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/**
 * Página do time da Cuidaty. Apresentação editorial de quem constrói a
 * plataforma: foto, nome, área de atuação e uma linha de contexto. Segue
 * o mesmo vocabulário visual das demais páginas (serifada, cuidaty-dark,
 * cards com sombra soft).
 */
type Member = {
  name: string;
  role: string;
  area: string;
  photo: string;
  blurb: string;
  focus?: string; // object-position para enquadrar o rosto
};

const members: Member[] = [
  {
    name: 'Pedro Viana',
    role: 'Direção Geral',
    area: 'Estratégia e produto',
    photo: '/team/pedro.jpeg',
    blurb:
      'Guia cada decisão da plataforma por uma pergunta só: isso devolve tempo e tranquilidade pra quem cuida de pacientes todos os dias?',
    focus: 'center 30%',
  },
  {
    name: 'Breno Prestes',
    role: 'Direção Técnica e Dados',
    area: 'Engenharia e IA',
    photo: '/team/breno.png',
    blurb:
      'Cuida da segurança e da tecnologia pra que o prontuário de cada profissional esteja sempre no ar, protegido e pronto na hora da consulta.',
    focus: 'center top',
  },
  {
    name: 'Ianca Negreiros',
    role: 'Especialista em Eficiência Clínica',
    area: 'Operação e sucesso',
    photo: '/team/ianca.png',
    blurb:
      'Acompanha de perto o dia a dia dos profissionais pra tirar peso da agenda e devolver o foco ao que importa: o cuidado com o paciente.',
    focus: 'center 25%',
  },
];
---

<Layout
  title="Nosso time | Cuidaty"
  description="Conheça as pessoas por trás da Cuidaty: a equipe que constrói a plataforma de gestão para profissionais e clínicas de saúde."
  keywords="time Cuidaty, equipe Cuidaty, quem somos, sobre a Cuidaty, fundadores Cuidaty"
>
  <Header />
  <main class="bg-white">
    <!-- Cabeçalho editorial -->
    <header class="border-b border-border">
      <div class="container mx-auto px-5 md:px-8">
        <div class="mx-auto max-w-3xl pb-12 pt-32 md:pb-16 md:pt-40">
          <p class="mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-cuidaty-primary">
            Quem faz a Cuidaty
          </p>
          <h1
            class="font-serif text-5xl font-semibold leading-[1.02] tracking-tight text-cuidaty-dark md:text-7xl"
          >
            Nosso time
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-foreground/70">
            Um grupo pequeno e obcecado pela rotina de quem cuida. Cada pessoa aqui carrega uma
            parte da plataforma no colo.
          </p>
          <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-4 border-t border-border pt-6 text-sm">
            <div>
              <dt class="text-foreground/50">Pessoas</dt>
              <dd class="mt-0.5 font-medium text-cuidaty-dark">{members.length}</dd>
            </div>
            <div>
              <dt class="text-foreground/50">Sede</dt>
              <dd class="mt-0.5 font-medium text-cuidaty-dark">Macapá · Brasil</dd>
            </div>
            <div>
              <dt class="text-foreground/50">Missão</dt>
              <dd class="mt-0.5 font-medium text-cuidaty-dark">Menos burocracia, mais escuta</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <!-- Grade do time -->
    <section class="bg-white">
      <div class="container mx-auto px-5 py-16 md:px-8 md:py-24">
        <div class="mx-auto grid max-w-6xl gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {
            members.map((m) => (
              <article class="group flex flex-col">
                <div class="relative overflow-hidden rounded-2xl bg-beige shadow-soft">
                  <img
                    src={m.photo}
                    alt={`Foto de ${m.name}`}
                    width="480"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    style={`object-position: ${m.focus ?? 'center'}`}
                    class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  />
                  <div
                    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-cuidaty-dark/30 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                    aria-hidden="true"
                  />
                </div>
                <div class="mt-5">
                  <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-cuidaty-secondary">
                    {m.area}
                  </p>
                  <h2 class="mt-2 font-serif text-2xl font-semibold leading-tight text-cuidaty-dark">
                    {m.name}
                  </h2>
                  <p class="mt-1 text-sm font-medium text-cuidaty-primary">{m.role}</p>
                  <p class="mt-3 text-sm leading-relaxed text-foreground/65">{m.blurb}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Faixa de valores -->
    <section class="bg-cuidaty-dark py-20 md:py-28">
      <div class="container mx-auto px-5 md:px-8">
        <div class="mx-auto max-w-4xl">
          <p
            class="mb-8 text-xs font-semibold uppercase tracking-[0.2em] text-cuidaty-accent-light"
          >
            O que nos move
          </p>
          <p
            class="font-serif text-3xl font-semibold leading-[1.15] tracking-tight text-white md:text-4xl lg:text-[2.75rem]"
          >
            Somos poucos de propósito. Cada decisão passa por quem vai usar a plataforma no dia
            seguinte,
            <span class="italic text-white/65">e isso muda tudo.</span>
          </p>
          <div class="mt-14 grid gap-x-12 gap-y-8 md:grid-cols-3">
            <div>
              <p class="mb-3 font-serif text-xl font-semibold text-white">Perto de quem cuida</p>
              <p class="text-sm leading-relaxed text-white/60">
                Conversamos com profissionais de saúde toda semana. O produto nasce dessa escuta.
              </p>
            </div>
            <div>
              <p class="mb-3 font-serif text-xl font-semibold text-white">Feito no Brasil</p>
              <p class="text-sm leading-relaxed text-white/60">
                Dados hospedados aqui, em conformidade com a LGPD, pensados para a realidade daqui.
              </p>
            </div>
            <div>
              <p class="mb-3 font-serif text-xl font-semibold text-white">Sem burocracia à toa</p>
              <p class="text-sm leading-relaxed text-white/60">
                Se uma tela atrapalha em vez de ajudar, ela sai. Simplicidade é decisão diária.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-white">
      <div class="container mx-auto px-5 py-20 md:px-8 md:py-24">
        <div
          class="mx-auto flex max-w-4xl flex-col items-start gap-6 rounded-3xl bg-beige px-7 py-10 md:flex-row md:items-center md:justify-between md:px-12 md:py-12"
        >
          <div>
            <h2 class="font-serif text-2xl font-semibold text-cuidaty-dark md:text-3xl">
              Quer construir a Cuidaty com a gente?
            </h2>
            <p class="mt-2 max-w-md text-foreground/70">
              Estamos sempre de olho em gente boa. Mande seu currículo para
              <a
                href="mailto:contato@thetaharpia.com"
                class="font-medium text-cuidaty-primary underline-offset-4 hover:underline"
              >
                contato@thetaharpia.com
              </a>.
            </p>
          </div>
          <a
            href="mailto:contato@thetaharpia.com?subject=Quero%20fazer%20parte%20do%20time%20Cuidaty"
            class="inline-flex shrink-0 items-center gap-2 rounded-md bg-cuidaty-primary px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-cuidaty-primary-hover"
          >
            Enviar currículo
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
